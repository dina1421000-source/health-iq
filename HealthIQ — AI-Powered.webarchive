/* ---------- بنية الترجمة الكاملة ---------- */
const L = (ar,en) => LANG==="en" ? en : ar;
const TERM = {"حرج":"Critical","تنبيه":"Warning","منهجي":"Methodological","معلومة":"Info",
  "متوفر":"Available","غير متوفر":"Not available","غير متاح حاليًا":"Not available",
  "محدود":"Limited","متاح":"Available","جزئي":"Partial"};
function TW(x){ return LANG==="en" ? (TERM[String(x).trim()] || x) : x; }

const WD_EN = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
const TYPE_EN = {"زائر":"Visiting","مقيم":"Resident"};
const ALL_DEPT = "__ALL_DEPT__", ALL_TYPE = "__ALL_TYPE__";
function dLabel(d){ return LANG==="en" ? (d || "Unspecified") : (DEPT_AR[d] || d || "غير محدد"); }
function wLabel(dateStr){
  const i = new Date(dateStr+"T00:00:00").getDay();
  return LANG==="en" ? WD_EN[i] : WD[i];
}
function tLabel(visiting){ return LANG==="en" ? (visiting?"Visiting":"Resident") : (visiting?"زائر":"مقيم"); }
/* إعادة وسم البيانات عند تبديل اللغة — الأرقام والبنية لا تتغيّر */
function relabelData(){
  ALL.forEach(r=>{ r.deptAr = dLabel(r.department); r.weekday = wLabel(r.date);
                   r.typeAr = tLabel(r.visiting); r.label = label(r.name); });
  ROSTER.forEach(d=>{ d.deptAr = dLabel(d.department); d.typeAr = tLabel(d.visiting);
                      d.label = label(d.name); });
}

/* ---------- الصلاحيات ---------- */
let ROLE  = sessionStorage.getItem("healthiq.role") || null;
let WHOAMI = sessionStorage.getItem("healthiq.who") || "";
const isSuper = () => ROLE === "super";
const isAdmin = () => isSuper();   /* صفحات الإدارة مقصورة على المسؤول الأعلى */

async function sha256(txt){
  if(window.crypto && crypto.subtle){
    const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(txt));
    return [...new Uint8Array(buf)].map(b=>b.toString(16).padStart(2,"0")).join("");
  }
  return "nohash:"+txt;
}
function setRole(r, who){
  ROLE = r; WHOAMI = who || "";
  sessionStorage.setItem("healthiq.role", r);
  sessionStorage.setItem("healthiq.who", WHOAMI);
}
function signOut(){ sessionStorage.removeItem("healthiq.role"); location.reload(); }

/* ---------- محرّك التحليل (قواعد حتمية) ---------- */
function periods(recs){
  const months = uniq(recs.map(r=>r.month)).sort();
  if(months.length>=2){
    const cur=months[months.length-1], prev=months[months.length-2];
    return {mode:"month", curLabel:cur, prevLabel:prev,
      cur:recs.filter(r=>r.month===cur), prev:recs.filter(r=>r.month===prev)};
  }
  const dates = uniq(recs.map(r=>r.date)).sort();
  if(dates.length<4) return null;
  const cut = dates[Math.floor(dates.length/2)];
  return {mode:"half", curLabel:L("النصف الأخير","Latter half"), prevLabel:L("النصف الأول","First half"),
    cur:recs.filter(r=>r.date>=cut), prev:recs.filter(r=>r.date<cut)};
}

function periodStats(recs, docs){
  const sm = summarize(recs, docs.filter(d=>recs.some(r=>r.name===d.name)));
  return totals(sm);
}

function whatChanged(recs, docs){
  const p = periods(recs);
  if(!p) return null;
  const a = periodStats(p.prev, docs), b = periodStats(p.cur, docs);
  const M = [
    {k:"utilization", l:L("استغلال الوقت العيادي","Clinic time utilization"), f:pc, good:"up"},
    {k:"fillRate",    l:L("نسبة ملء المواعيد","Appointment fill rate"), f:pc, good:"up"},
    {k:"attendanceRate", l:L("نسبة الحضور","Attendance rate"), f:pc, good:"up"},
    {k:"seenPerHour", l:L("مرضى في الساعة","Patients per hour"), f:n2, good:"up"},
    {k:"seen",        l:L("إجمالي المخدومين","Total patients seen"), f:n0, good:"up"},
    {k:"noShows",     l:L("عدد عدم الحضور","No-shows"), f:n0, good:"down"},
    {k:"wasted",      l:L("ساعات مهدرة","Wasted hours"), f:n1, good:"down"},
    {k:"walkIns",     l:L("الدخول بلا موعد","Walk-ins"), f:n0, good:"none"},
    {k:"days",        l:L("أيام العيادة","Clinic days"), f:n0, good:"none"}
  ];
  const rows = M.map(m=>{
    const prev=a[m.k], cur=b[m.k];
    if(prev==null||cur==null) return null;
    const delta = cur-prev;
    const relRaw = prev ? delta/prev*100 : null;
    const dir = Math.abs(relRaw==null?delta:relRaw) < 3 ? "flat" : (delta>0?"up":"down");
    let verdict="flat";
    if(m.good!=="none" && dir!=="flat")
      verdict = (dir==="up") === (m.good==="up") ? "up" : "down";
    return {...m, prev, cur, delta, rel:relRaw, dir, verdict,
      big: relRaw!=null && Math.abs(relRaw)>=20};
  }).filter(Boolean);
  const VT = {up:L("تحسّن","Improved"), down:L("تراجع","Declined"), flat:L("محايد","Neutral")};
  return {p, a, b, rows, VT};
}

function forecast(recs){
  if(!CFG.ai.forecast) return null;
  const weeks = {};
  recs.forEach(r=>{
    const d=new Date(r.date+"T00:00:00");
    const k=new Date(d); k.setDate(d.getDate()-d.getDay());
    const key=k.toISOString().slice(0,10);
    weeks[key] = weeks[key] || {booked:0,seen:0,noShows:0,hours:0,days:new Set()};
    weeks[key].booked+=r.booked; weeks[key].seen+=r.seen; weeks[key].noShows+=r.noShows;
    weeks[key].days.add(r.date+r.name); weeks[key].hours += (r.hoursPerDay||0);
  });
  const keys = Object.keys(weeks).sort();
  if(keys.length<4) return {enough:false, points:keys.length};
  const series = keys.map(k=>weeks[k].hours? weeks[k].seen/weeks[k].hours : null);
  const idx = series.map((v,i)=>v==null?null:i).filter(v=>v!==null);
  const xs = idx, ys = idx.map(i=>series[i]);
  const n=xs.length, mx=xs.reduce((a,b)=>a+b,0)/n, my=ys.reduce((a,b)=>a+b,0)/n;
  const den = xs.reduce((s,x)=>s+(x-mx)**2,0);
  const slope = den? xs.reduce((s,x,i)=>s+(x-mx)*(ys[i]-my),0)/den : 0;
  const inter = my - slope*mx;
  const fit = xs.map(x=>inter+slope*x);
  const ssRes = ys.reduce((s,y,i)=>s+(y-fit[i])**2,0);
  const ssTot = ys.reduce((s,y)=>s+(y-my)**2,0);
  const r2 = ssTot? 1-ssRes/ssTot : 0;
  const rmse = Math.sqrt(ssRes/Math.max(1,n-2));
  const h = Math.max(1, Math.min(4, CFG.ai.horizon||2));
  const fut = [];
  for(let i=1;i<=h;i++){
    const x = keys.length-1+i;
    fut.push({week:i, value:Math.max(0, inter+slope*x), lo:Math.max(0,inter+slope*x-1.96*rmse),
              hi:inter+slope*x+1.96*rmse});
  }
  return {enough:true, keys, series, slope, r2, rmse, fut,
    trend: Math.abs(slope)<0.02 ? L("مستقر","flat") : (slope>0?L("صاعد","rising"):L("هابط","falling"))};
}

function clinics(recs, sm){
  const g = {};
  sm.filter(d=>d.hasData).forEach(d=>{
    const k=d.deptAr;
    g[k] = g[k] || {name:k, doctors:[], booked:0, attended:0, walkIns:0, noShows:0, seen:0,
                    hours:0, capacity:0, days:new Set()};
    const x=g[k];
    x.doctors.push(d); x.booked+=d.booked; x.attended+=d.attended; x.walkIns+=d.walkIns;
    x.noShows+=d.noShows; x.seen+=d.seen; x.hours+=d.hours||0; x.capacity+=d.capacity||0;
  });
  recs.forEach(r=> g[r.deptAr] && g[r.deptAr].days.add(r.date));
  return Object.values(g).map(x=>{
    const wd = {};
    recs.filter(r=>r.deptAr===x.name).forEach(r=>{
      wd[r.weekday] = wd[r.weekday] || {seen:0, booked:0, hours:0, n:0};
      wd[r.weekday].seen+=r.seen; wd[r.weekday].booked+=r.booked; wd[r.weekday].n++;
      wd[r.weekday].hours += r.hoursPerDay||0;
    });
    const wdRows = Object.entries(wd).map(([d,v])=>({day:d, seen:v.seen, booked:v.booked,
      perHour: v.hours? v.seen/v.hours : null})).sort((a,b)=>(b.perHour||-1)-(a.perHour||-1));
    return {...x, days:x.days.size,
      utilization: x.capacity? x.seen/x.capacity*100 : null,
      fillRate: x.capacity? x.booked/x.capacity*100 : null,
      freeSlots: x.capacity? Math.max(0,x.capacity-x.booked) : null,
      noShowRate: x.booked? x.noShows/x.booked*100 : null,
      attendanceRate: x.booked? x.attended/x.booked*100 : null,
      seenPerHour: x.hours? x.seen/x.hours : null,
      peak: wdRows[0]||null, low: wdRows[wdRows.length-1]||null, wdRows};
  }).sort((a,b)=>(b.utilization||-1)-(a.utilization||-1));
}

/* التنبيهات الذكية */
function smartAlerts(recs, sm, t){
  const A = [], cl = clinics(recs, sm), th = CFG.ai;
  const push = (lv,title,body,evi,rec)=>A.push({lv,title,body,evi,rec});

  if(t.utilization!=null && t.utilization < th.utilLow)
    push("crit", L("استغلال الوقت العيادي أقل من الحد المرجعي","Clinic time utilization below benchmark"),
      L(`${L("الاستغلال الكلي","Overall utilization")} ${pc(t.utilization)} ${L("مقابل حدّ مرجعي","against a benchmark of")} ${th.utilLow}%.`,
        `Overall utilization is ${pc(t.utilization)} against a ${th.utilLow}% benchmark.`),
      L(`${n1(t.delivered)} ${L("ساعة مخدومة من أصل","hours delivered out of")} ${n1(t.hours)} ${L("ساعة متاحة.","available hours.")}`,
        `${n1(t.delivered)} hours delivered out of ${n1(t.hours)} available.`),
      L(L("راجعي توزيع المواعيد وساعات العمل الفعلية للعيادات الأقل استغلالًا قبل إضافة أي ساعات جديدة.","Review appointment distribution and actual operating hours for the least utilized clinics before adding any new hours."),
        "Review appointment distribution and actual operating hours for the least-used clinics before adding new hours."));

  if(t.attendanceRate!=null && (100-t.attendanceRate) > th.noShowHigh)
    push("crit", L("نسبة عدم الحضور مرتفعة","High no-show rate"),
      L(`${L("عدم الحضور","No-shows")} ${pc(100-t.attendanceRate)} ${L("مقابل حدّ","against a threshold of")} ${th.noShowHigh}%.`,
        `No-shows at ${pc(100-t.attendanceRate)} against a ${th.noShowHigh}% threshold.`),
      L(`${n0(t.noShows)} ${L("موعد لم يُحضر من","missed appointments out of")} ${n0(t.booked)} ${L("حجز، ما يعادل","bookings, equal to")} ${n1(t.wasted)} ${L("ساعة.","hours.")}`,
        `${n0(t.noShows)} missed appointments out of ${n0(t.booked)} booked, equal to ${n1(t.wasted)} hours.`),
      L(L("فعّلي التأكيد المسبق للمواعيد وإعادة تعبئة المواعيد الملغاة من قائمة الانتظار.","Turn on advance appointment confirmation and refill cancelled slots from the waiting list."),
        "Enable advance confirmation and refill cancelled appointments from the waiting list."));

  if(t.fillRate!=null && t.fillRate < th.fillLow)
    push("warn", L("مواعيد شاغرة متكررة","Repeated empty appointment slots"),
      L(`${L("نسبة ملء المواعيد","Appointment fill rate")} ${pc(t.fillRate)} ${L("فقط.","only.")}`, `Fill rate is only ${pc(t.fillRate)}.`),
      L(`${n0(Math.max(0,t.capacity-t.booked))} ${L("موعد شاغر من طاقة","open appointments out of a capacity of")} ${n0(t.capacity)} ${L("موعد.","appointments.")}`,
        `${n0(Math.max(0,t.capacity-t.booked))} unbooked slots out of ${n0(t.capacity)} capacity.`),
      L(L("افتحي الفجوات الشاغرة للحجز المباشر أو أعيدي توزيعها على العيادات ذات الطلب الأعلى.","Open the empty gaps for direct booking, or redistribute them to clinics with higher demand."),
        "Open unbooked gaps to direct booking or redistribute them to higher-demand clinics."));

  cl.forEach(c=>{
    if(c.utilization!=null && c.utilization < th.utilLow*0.6 && c.days>=th.minDays)
      push("warn", L(`${L("استغلال منخفض في","Low utilization in")} ${c.name}`, `Low utilization in ${c.name}`),
        L(`${L("الاستغلال","Utilization is")} ${pc(c.utilization)} ${L("على مدى","over")} ${n0(c.days)} ${L("يوم عيادة.","clinic days.")}`,
          `Utilization is ${pc(c.utilization)} across ${n0(c.days)} clinic days.`),
        L(`${n0(c.seen)} ${L("مخدوم مقابل طاقة","patients seen against a capacity of")} ${n0(c.capacity)} ${L("موعد.","appointments.")}`,
          `${n0(c.seen)} patients seen against ${n0(c.capacity)} slot capacity.`),
        L(`${L("راجعي عدد ساعات","Review the hours of")} ${c.name} ${L("أو ادمجيها في أيام أقل بكثافة أعلى.","or consolidate them into fewer, denser days.")}`,
          `Review the hours allocated to ${c.name} or consolidate them into fewer, denser days.`));
    if(c.noShowRate!=null && c.noShowRate > th.noShowHigh + 15 && c.booked>=10)
      push("warn", L(`${L("عدم حضور مرتفع في","High no-show rate in")} ${c.name}`, `High no-shows in ${c.name}`),
        L(`${L("نسبة عدم الحضور","No-show rate is")} ${pc(c.noShowRate)}.`, `No-show rate is ${pc(c.noShowRate)}.`),
        L(`${n0(c.noShows)} ${L("من","of")} ${n0(c.booked)} ${L("حجز.","bookings.")}`, `${n0(c.noShows)} of ${n0(c.booked)} bookings.`),
        L(`${L("ابدئي بالتذكير الهاتفي قبل ٢٤ ساعة لمواعيد","Start with a phone reminder 24 hours ahead for")} ${c.name} ${L("تحديدًا.","specifically.")}`,
          `Start with 24-hour phone reminders for ${c.name} appointments specifically.`));
  });

  const wc = whatChanged(recs, ROSTER);
  if(wc) wc.rows.filter(r=>r.big && r.verdict==="down").forEach(r=>
    push("warn", L(`${L("تغيّر ملحوظ:","Notable change:")} ${r.l}`, `Significant change: ${r.l}`),
      L(`${r.l} ${L("تغيّر بنسبة","changed by")} ${pc(Math.abs(r.rel))} ${r.dir==="up"?L("بالزيادة","upward"):L("بالنقص","downward")} ${L("مقارنة بـ","compared with")}${wc.p.prevLabel}.`,
        `${r.l} moved ${pc(Math.abs(r.rel))} ${r.dir==="up"?"up":"down"} versus ${wc.p.prevLabel}.`),
      `${r.f(r.prev)} → ${r.f(r.cur)}`,
      L(L("افحصي الفترة نفسها على مستوى العيادة قبل اعتبار التغيّر اتجاهًا ثابتًا.","Examine the same period at clinic level before treating the change as a settled trend."),
        "Inspect the same period at clinic level before treating the change as a stable trend.")));

  const noHours = ROSTER.filter(d=>!HOURS[d.name]).length;
  if(noHours) push("info", L("نقص في بيانات ساعات العيادة","Missing clinic-hours data"),
    L(`${n0(noHours)} ${L("طبيب بلا ساعات مسجّلة، فلا يمكن حساب الاستغلال لهم.","doctors have no recorded hours, so utilization cannot be computed for them.")}`,
      `${n0(noHours)} doctors have no recorded hours, so utilization cannot be computed for them.`),
    L(L("الحقول الناقصة تُستثنى من كل المؤشرات النسبية.","Missing fields are excluded from every relative metric."),
      "Missing fields are excluded from all ratio-based indicators."),
    L(L("أضيفي ساعات العيادة ومدة الموعد لهؤلاء الأطباء لرفع تغطية التحليل.","Add clinic hours and appointment length for these doctors to widen analysis coverage."),
      "Add clinic hours and slot duration for these doctors to widen analytical coverage."));

  const odd = recs.filter(r=>r.attended>r.booked);
  if(odd.length) push("crit", L("تعارض في البيانات","Data inconsistency"),
    L(`${n0(odd.length)} ${L("سجل فيه عدد الحضور أكبر من عدد الحجوزات.","records where attendance exceeds bookings.")}`,
      `${n0(odd.length)} records show attendance greater than bookings.`),
    odd.slice(0,3).map(r=>`${label(r.name)} — ${r.date}`).join("، "),
    L(L("صحّحي هذه السجلات، لأنها ترفع نسب الحضور بشكل غير حقيقي.","Correct these records, because they inflate attendance rates artificially."),
      "Correct these records — they inflate attendance rates artificially."));

  const order = {crit:0, warn:1, info:2};
  return A.sort((x,y)=>order[x.lv]-order[y.lv]);
}

/* الملخّص التنفيذي */
function execSummary(recs, sm, t){
  const cl = clinics(recs, sm), wc = whatChanged(recs, ROSTER), fc = forecast(recs);
  const pos = [], neg = [], notes = [];
  const best = cl[0], worst = cl[cl.length-1];

  const head = L(
    `${L("خلال الفترة المعروضة سُجّل","Over the period shown,")} ${n0(t.seen)} ${L("مخدوم عبر","patients were seen across")} ${n0(t.days)} ${L("يوم عيادة و","clinic days and")}${n1(t.hours)} ${L("ساعة،","hours,")} `
      + `${L("باستغلال","at a utilization of")} ${pc(t.utilization)} ${L("ونسبة حضور","and an attendance rate of")} ${pc(t.attendanceRate)}.`,
    `Across the selected period, ${n0(t.seen)} patients were seen over ${n0(t.days)} clinic days and `
      + `${n1(t.hours)} hours, at ${pc(t.utilization)} utilization and ${pc(t.attendanceRate)} attendance.`);

  if(best && best.utilization!=null) pos.push(L(
    `${L("أعلى استغلال في","Highest utilization in")} ${best.name} ${L("بنسبة","at")} ${pc(best.utilization)}.`,
    `Highest utilization is ${best.name} at ${pc(best.utilization)}.`));
  if(t.attendanceRate!=null && t.attendanceRate>=70) pos.push(L(
    `${L("نسبة الحضور","Attendance rate")} ${pc(t.attendanceRate)} ${L("ضمن نطاق مقبول.","is within an acceptable range.")}`,
    `Attendance of ${pc(t.attendanceRate)} sits within an acceptable range.`));
  if(t.walkShare!=null && t.walkShare>15) pos.push(L(
    `${L("الدخول بلا موعد يغطي","Walk-ins account for")} ${pc(t.walkShare)} ${L("من المخدومين ويعوّض جزءًا من الفاقد.","of patients seen and offset part of the waste.")}`,
    `Walk-ins account for ${pc(t.walkShare)} of patients seen, offsetting part of the loss.`));

  if(worst && worst.utilization!=null && worst!==best) neg.push(L(
    `${L("أدنى استغلال في","Lowest utilization in")} ${worst.name} ${L("بنسبة","at")} ${pc(worst.utilization)}.`,
    `Lowest utilization is ${worst.name} at ${pc(worst.utilization)}.`));
  if(t.wasted) neg.push(L(
    `${n1(t.wasted)} ${L("ساعة ضاعت بسبب عدم الحضور.","hours were lost to no-shows.")}`,
    `${n1(t.wasted)} hours were lost to no-shows.`));
  if(t.fillRate!=null && t.fillRate<CFG.ai.fillLow) neg.push(L(
    `${n0(Math.max(0,t.capacity-t.booked))} ${L("موعد بقي شاغرًا دون حجز.","appointments remained open with no booking.")}`,
    `${n0(Math.max(0,t.capacity-t.booked))} slots remained unbooked.`));

  if(wc){
    const up = wc.rows.filter(r=>r.verdict==="up" && r.big).slice(0,2);
    const dn = wc.rows.filter(r=>r.verdict==="down" && r.big).slice(0,2);
    up.forEach(r=>pos.push(L(
      `${r.l} ${L("تحسّن من","improved from")} ${r.f(r.prev)} ${L("إلى","to")} ${r.f(r.cur)} ${L("مقارنة بـ","compared with")}${wc.p.prevLabel}.`,
      `${r.l} improved from ${r.f(r.prev)} to ${r.f(r.cur)} versus ${wc.p.prevLabel}.`)));
    dn.forEach(r=>neg.push(L(
      `${r.l} ${L("تراجع من","declined from")} ${r.f(r.prev)} ${L("إلى","to")} ${r.f(r.cur)} ${L("مقارنة بـ","compared with")}${wc.p.prevLabel}.`,
      `${r.l} declined from ${r.f(r.prev)} to ${r.f(r.cur)} versus ${wc.p.prevLabel}.`)));
    if(!up.length && !dn.length) notes.push(L(
      `${L("لا يوجد تغيّر جوهري مقارنة بـ","No substantive change compared with")}${wc.p.prevLabel}.`,
      `No material change versus ${wc.p.prevLabel}.`));
  }
  if(fc && fc.enough) notes.push(L(
    `${L("الاتجاه العام","The overall trend is")} ${fc.trend} ${L("على مستوى الأسابيع (جودة الملاءمة R²=","at week level (goodness of fit R²=")}${n2(fc.r2)}).`,
    `The weekly trend is ${fc.trend} (fit quality R²=${n2(fc.r2)}).`));
  else notes.push(L(L("عدد الأسابيع غير كافٍ لبناء توقّع موثوق.","There are not enough weeks to build a reliable forecast."),
    "There are not enough weeks to build a reliable forecast."));

  return {head, pos, neg, notes};
}

/* ---------- اسأل HealthIQ ---------- */
function askHealthIQ(qRaw, recs, sm, t){
  const q = (qRaw||"").trim();
  if(!q) return null;
  const s = q.toLowerCase();
  const cl = clinics(recs, sm);
  const has = (...ks)=>ks.some(k=>s.includes(k));
  const tbl = (head, rows)=>`<table><thead><tr>${head.map(h=>`<th>${esc(h)}</th>`).join("")}</tr></thead>
    <tbody>${rows.map(r=>`<tr>${r.map(c=>`<td>${c}</td>`).join("")}</tr>`).join("")}</tbody></table>`;
  const R = o => ({a:o.a, e:o.d||"", ev:o.ev||"", ip:o.ip||"", rc:o.rc||""});
  const NODATA = m => R({a:m, ip:L("لا توجد بيانات كافية للإجابة على هذا السؤال ضمن التصفية الحالية.","There is not enough data to answer this question under the current filters.")});

  /* هوية المطوّرة — دينا */
  const DEV_Q = ["من طوّر","من طور","من صمم","من صمّم","من برمج","من بنى","من بناه","من أنشأ",
    "من انشأ","من سوى","من سوا","مين سوى","مين سوا","مين طور","مين طوّر","مين صمم","مين برمج",
    "من صاحب","صاحب النظام","صاحبة النظام","مالك النظام","مالكة النظام","من وراء","من ورا",
    "منشئ","منشئة","المطور","المطوّر","المطورة","المطوّرة","المبرمج","المبرمجة","مبرمج",
    "من الفريق","من عمل","مين عمل","مين بنى","من كتب الكود","من يملك",
    "who developed","who built","who created","who made","who programmed","who designed",
    "who is behind","who owns","developer","programmer","the author","built by","made by",
    "created by","designed by","owner of healthiq","behind healthiq"];
  /* ---------- أسئلة تعريفية ---------- */
  const FAQ = [
    { k:["ما هو healthiq","ماهو healthiq","وش هو healthiq","ايش هو healthiq","إيش هو healthiq","عرّف","تعريف المنصة","what is healthiq","define healthiq"],
      a:L("HealthIQ هي منصة رقمية تحوّل البيانات التشغيلية للعيادات إلى مؤشرات وتحليلات تساعد على فهم أداء العيادات، اكتشاف فرص التحسين، ودعم اتخاذ القرار المبني على البيانات.",
          "HealthIQ is a digital platform that transforms clinic operational data into indicators and analytics that help understand clinic performance, uncover improvement opportunities, and support data-driven decision-making.") },

    { k:["لماذا نحتاج","ليش نحتاج","البيانات موجودة أصلًا","البيانات موجودة اصلا","why do we need"],
      a:L("وجود البيانات وحده لا يكفي. القيمة تظهر عند تنظيمها وتحليلها وتحويلها إلى مؤشرات تساعد على فهم ما يحدث في العيادات واتخاذ قرارات مبنية على البيانات.",
          "Having the data is not enough. The value appears when it is organised, analysed and turned into indicators that show what is happening in the clinics and support data-driven decisions.") },

    { k:["الهدف من healthiq","ما الهدف","هدف المنصة","وش هدف","ايش الهدف","إيش الهدف","purpose of healthiq","goal of healthiq","objective of healthiq"],
      a:L("تحويل البيانات اليومية للعيادات إلى معلومات ومؤشرات واضحة تساعد على متابعة الأداء، المقارنة، اكتشاف مواطن التحسين، واتخاذ قرارات مبنية على البيانات.",
          "To turn the clinics' daily data into clear information and indicators that support performance monitoring, comparison, spotting areas for improvement, and making data-driven decisions.") },

    { k:["ماذا يحلل","ماذا يحلّل","وش يحلل","ايش يحلل","إيش يحلل","what does healthiq analyse","what does healthiq analyze","what healthiq analyzes"],
      a:L("يحلل مؤشرات تشغيلية مثل الزيارات، الحجوزات، الحضور، عدم الحضور، نسبة ملء المواعيد، استغلال الطاقة، ساعات العيادات، والزيارات دون موعد.",
          "It analyses operational indicators such as visits, bookings, attendance, no-shows, appointment fill rate, capacity utilisation, clinic operating hours, and walk-in visits.") },

    { k:["يقيم أداء الأطباء","يقيّم أداء الأطباء","يقيم الأطباء","يقيّم الأطباء","تقييم سريري","تقييم الأطباء","clinical performance","evaluate doctors","assess doctors","clinically"],
      a:L("لا. المؤشرات في HealthIQ تشغيلية وتهدف إلى فهم نشاط العيادات واستخدام الموارد، وليست تقييمًا للأداء السريري أو حكمًا على الطبيب.",
          "No. HealthIQ indicators are operational and aim to understand clinic activity and resource usage; they are not an assessment of clinical performance or a judgement on the physician.") },

    { k:["دور دينا","ماذا فعلت دينا","role of dina"],
      a:L("قامت دينا بتصميم المنصة وتطويرها، وبناء المؤشرات والتحليلات وقواعد التنبيهات فيها.",
          "Dina designed and developed the platform and built its indicators, analytics and alert rules.") },

    { k:["يستخدم الذكاء الاصطناعي","الذكاء الاصطناعي","ذكاء اصطناعي","هل يستخدم ai","uses ai","artificial intelligence","use ai"],
      a:L("نعم، يتضمن HealthIQ أدوات تحليل ذكية تساعد على استخراج الاستنتاجات والتنبيهات والسيناريوهات من البيانات المتاحة.",
          "Yes, HealthIQ includes intelligent analysis tools that help extract insights, alerts, and scenarios from the available data.") },

    { k:["بيانات المرضى","بيانات شخصية","أسماء المرضى","اسماء المرضى","بيانات صحية شخصية","patient data","personal data","patient names","phi"],
      a:L("لا يحتاج إلى أسماء المرضى أو أرقام الملفات أو التشخيصات أو البيانات الصحية الشخصية، بل يعتمد على البيانات التشغيلية للعيادات.",
          "It does not require patient names, file numbers, diagnoses, or personal health data; it relies solely on the clinics' operational data.") },

    { k:["بيانات غير مكتملة","البيانات ناقصة","incomplete data","missing data"],
      a:L("بعض التحليلات والمقارنات تكون محدودة. وكلما أصبحت البيانات أكثر اكتمالًا وتنوعًا، أصبحت قراءة المؤشرات أكثر فائدة.",
          "Some analyses and comparisons become limited. The more complete and varied the data, the more useful the indicators become.") },

    { k:["مقارنة العيادات","مقارنة الفترات","قارن العيادات","قارن الفترات","هل يمكن مقارنة","نقارن بين","compare clinics","compare periods","clinic comparison","period comparison","benchmark clinics"],
      a:L("نعم، يمكن مقارنة مؤشرات العيادات والفترات المتاحة للمساعدة في فهم الاختلافات والتغيرات في الأداء التشغيلي.",
          "Yes, indicators for the available clinics and periods can be compared to help understand differences and changes in operational performance.") },

    { k:["كيف تعمل التنبيهات","كيف تشتغل التنبيهات","التنبيهات الذكية","آلية التنبيهات","اليه التنبيهات","how do alerts work","how alerts work","smart alerts","alert logic","alerting mechanism"],
      a:L("تعتمد التنبيهات على المؤشرات والبيانات الموجودة في المنصة، وتظهر عند وجود حالة أو تغيّر يستحق الانتباه مع توضيح المؤشر المرتبط بها.",
          "Alerts rely on the indicators and data available in the platform, and appear when a condition or change is worth noticing, with the related indicator clearly shown.") },

    { k:["التنبيهات تخمن","تخمّن","هل التنبيهات دقيقة","does it guess","guessing"],
      a:L("لا. التنبيهات مبنية على قواعد محددة وبيانات موجودة في المنصة، ولكل تنبيه أساس من البيانات التي استند إليها.",
          "No. Alerts are built on defined rules and data present in the platform, and each alert carries the data it was based on.") },

    { k:["تستفيد الإدارة","فائدة للإدارة","كيف تستفيد","ماذا يقدم للإدارة","ماذا يقدم للاداره","وش يقدم للإدارة","للإدارة","للاداره","how can management benefit","what does healthiq offer","for management","management dashboard"],
      a:L("يوفر لوحة موحدة للمؤشرات والتحليلات والتنبيهات والاستنتاجات، تساعد على فهم وضع العيادات ومتابعة التغيرات وتحديد المجالات التي تحتاج إلى تحسين.",
          "It provides a unified dashboard of indicators, analytics, alerts, and insights that helps management understand the clinics' situation, track changes, and identify areas that need improvement.") },

    { k:["من هي دينا","من دينا","who is dina"],
      a:L("دينا أخصائية معلوماتية صحية، لديها مهارات عملية في البرمجة وتحليل البيانات وتطوير الحلول الرقمية.",
          "Dina is a Health Informatics Specialist with practical skills in programming, data analysis and digital solution development.") },

    { k:["مشاريع دينا","أبرز مشاريع","اعمال دينا","أعمال دينا","dina projects","dina's projects"],
      a:L("طوّرت دينا ثلاثة مشاريع رقمية: MyCare لخدمات وحلول الصحة الرقمية، Ehtiwaa للدعم النفسي والتدخل المبكر، وHealthIQ لتحليل البيانات الصحية والتشغيلية ودعم اتخاذ القرار.",
          "Dina has developed three digital projects: MyCare for digital health services and solutions, Ehtiwaa for psychological support and early intervention, and HealthIQ for health and operational data analysis and decision support.") },

    { k:["مجالات دينا","تهتم دينا","اهتمامات دينا","اهتمام دينا","dina interests","dina focus","dina fields","dina areas"],
      a:L("تهتم دينا بتطوير الحلول الرقمية، البرمجة، الأمن السيبراني، تحليل البيانات، الذكاء الاصطناعي، هندسة البرمجيات، والمعلوماتية الصحية.",
          "Dina is interested in digital solution development, programming, cybersecurity, data analysis, artificial intelligence, software engineering, and health informatics.") },

    { k:["لماذا تم إنشاء","ليش انشئ","سبب إنشاء","why was healthiq created"],
      a:L("لأن البيانات التشغيلية موجودة في العمل اليومي، والهدف تحويلها من أرقام متفرقة إلى معلومات منظمة تُظهر الصورة التشغيلية بوضوح.",
          "Because operational data already exists in daily work; the aim is to turn it from scattered numbers into organised information that shows the operational picture clearly.") }
  ];
  for(const f of FAQ){ if(f.k.some(k=>s.includes(k))) return R({a:f.a}); }

  if(DEV_Q.some(k=>s.includes(k)))
    return R({a:L("دينا، أخصائية معلوماتية صحية، وهي صاحبة فكرة HealthIQ ومطوّرته، وقامت بتصميم المنصة وتطوير وظائفها ومؤشراتها وتحليلاتها.",
                  "Dina, a Health Informatics Specialist, is the originator and developer of HealthIQ. She designed the platform and developed its features, indicators, and analytics."),
      ev:L("دينا — أخصائية المعلوماتية الصحية — هي مطوّرة HealthIQ ومالكته.","Dina, Health Informatics Specialist, is the developer and owner of HealthIQ."),
      ip:L("فكرة HealthIQ وتصميمه ومنطقه التحليلي وقواعد التنبيه والتوصية كلها من عمل دينا شخصيًا.","The HealthIQ concept, design, analytical logic and its alert and recommendation rules are all Dina's own work.")});

  const named = cl.find(c=>s.includes(c.name.toLowerCase()));
  const namedDoc = sm.find(d=>d.hasData && (s.includes(d.label.toLowerCase()) ||
    s.includes(String(d.name).toLowerCase())));

  if(has("أقل استغلال","اقل استغلال","lowest utilization","أضعف عيادة")){
    const rows = cl.filter(x=>x.utilization!=null);
    if(!rows.length) return NODATA(L("لا توجد عيادة بساعات وطاقة مسجّلة لحساب الاستغلال.","No clinic has recorded hours and capacity to compute utilization."));
    const c = rows[rows.length-1];
    return R({a:`${L("أقل عيادة استغلالًا هي","The least utilized clinic is")} ${c.name} ${L("بنسبة","at ")} ${pc(c.utilization)}.`,
      ev:`${n0(c.seen)} ${L("مخدوم مقابل طاقة","patients seen against a capacity of")} ${n0(c.capacity)} ${L("موعد على مدى","appointments over")} ${n0(c.days)} ${L("يوم عيادة.","clinic days.")}`,
      d: tbl([L("العيادة","Clinic"),L("الاستغلال","Utilization"),L("المخدومون","Patients seen"),L("الطاقة","Capacity"),L("أيام","Days")],
        rows.slice(-3).map(x=>[x.name,pc(x.utilization),n0(x.seen),n0(x.capacity),n0(x.days)])),
      ip:`${L("الفجوة عن المتوسط العام","The gap from the overall average of")} ${pc(t.utilization)} ${L("تعني طاقة قائمة أصلًا ولم تُستثمر، لا نقص موارد.","means existing capacity went unused — not a shortage of resources.")}`,
      rc:`${L("راجعي توزيع مواعيد","Review the appointment distribution for")} ${c.name} ${L("وساعات عملها الفعلية قبل إضافة أي ساعات جديدة.","and its actual operating hours before adding any new hours.")}`});
  }
  if(has("أعلى استغلال","اعلى استغلال","highest utilization","أفضل عيادة")){
    const rows = cl.filter(x=>x.utilization!=null);
    if(!rows.length) return NODATA(L("لا توجد عيادة بمعطيات كافية.","No clinic has enough data."));
    const c = rows[0];
    return R({a:`${L("أعلى عيادة استغلالًا هي","The most utilized clinic is")} ${c.name} ${L("بنسبة","at ")} ${pc(c.utilization)}.`,
      ev:`${n0(c.seen)} ${L("مخدوم من طاقة","patients seen out of a capacity of")} ${n0(c.capacity)} ${L("موعد.","appointments.")}`,
      d: tbl([L("العيادة","Clinic"),L("الاستغلال","Utilization"),L("المخدومون","Patients seen"),L("الطاقة","Capacity")],
        rows.slice(0,3).map(x=>[x.name,pc(x.utilization),n0(x.seen),n0(x.capacity)])),
      ip:L("هذه العيادة تمثّل المرجع التشغيلي الداخلي للمقارنة بدل المعايير الخارجية.","This clinic is the internal operational benchmark for comparison, instead of external standards."),
      rc:L("افحصي نمط الجدولة فيها ثم جرّبيه على العيادة الأقل استغلالًا.","Examine its scheduling pattern, then try it on the least utilized clinic.")});
  }
  if(!has("أقل ازدحام","اقل ازدحام","أهدأ","اهدأ","quietest","least busy","أخف يوم")
     && has("أكثر ازدحام","ازدحام","busiest","أفضل يوم","peak","ذروة")){
    const wd = {};
    recs.forEach(r=>{ wd[r.weekday]=wd[r.weekday]||{seen:0,hours:0};
      wd[r.weekday].seen+=r.seen; wd[r.weekday].hours+=r.hoursPerDay||0; });
    const rows = Object.entries(wd).map(([d,v])=>({d, ph:v.hours? v.seen/v.hours:null, seen:v.seen}))
      .filter(x=>x.ph!=null).sort((a,b)=>b.ph-a.ph);
    if(!rows.length) return NODATA(L("لا توجد ساعات مسجّلة لحساب الكثافة اليومية.","No hours are recorded to compute daily density."));
    return R({a:`${L("أعلى كثافة يوم","Highest density on")} ${rows[0].d} ${L("بمعدل","at ")} ${n2(rows[0].ph)} ${L("مريض في الساعة.","patients per hour.")}`,
      ev:`${n0(rows[0].seen)} ${L("مخدوم في هذا اليوم مقابل","patients seen that day, against")} ${n2(rows[rows.length-1].ph)} ${L("في أدنى الأيام (","on the lowest day (")}${rows[rows.length-1].d}).`,
      d: tbl([L("اليوم","Day"),L("مرضى/ساعة","Patients/hour"),L("المخدومون","Patients seen")], rows.map(r=>[r.d,n2(r.ph),n0(r.seen)])),
      ip:L("تفاوت الكثافة بين الأيام يعني أن الطاقة موزّعة بشكل غير متوازن على الأسبوع.","Density varying across days means capacity is unevenly spread over the week."),
      rc:L("انقلي جزءًا من ساعات الأيام المنخفضة إلى أيام الذروة بدل زيادة الموارد.","Move some hours from low days to peak days instead of adding resources.")});
  }
  if(has("مواعيد شاغرة","شاغر","available slots","فراغ","فجوات")){
    const rows = cl.filter(x=>x.freeSlots!=null).sort((a,b)=>b.freeSlots-a.freeSlots);
    if(!rows.length) return NODATA(L("حساب المواعيد الشاغرة يحتاج ساعات العيادة ومدة الموعد، وهي غير مسجّلة.","Computing open slots needs clinic hours and appointment duration, which are not recorded."));
    const tot = rows.reduce((a,b)=>a+b.freeSlots,0);
    return R({a:`${L("أكثر العيادات مواعيد شاغرة هي","The clinic with the most open slots is")} ${rows[0].name} ${L("بـ","with ")}${n0(rows[0].freeSlots)} ${L("موعد غير محجوز.","unbooked appointments.")}`,
      ev:`${L("إجمالي الشاغر","Total open slots:")} ${n0(tot)} ${L("موعد على مستوى العيادات المحسوبة.","appointments across the computed clinics.")}`,
      d: tbl([L("العيادة","Clinic"),L("مواعيد شاغرة","Open slots"),L("الطاقة","Capacity"),L("المحجوز","Booked")],
        rows.slice(0,5).map(x=>[x.name,n0(x.freeSlots),n0(x.capacity),n0(x.booked)])),
      ip:L("الشاغر هنا طاقة متاحة لم يصلها طلب، ويختلف عن الفاقد الناتج عن عدم الحضور.","Open slots here are available capacity that demand never reached — different from waste caused by no-shows."),
      rc:L("افتحي الفجوات للحجز المباشر أو أعيدي توزيعها على العيادات ذات قوائم الانتظار.","Open the gaps for direct booking, or redistribute them to clinics with waiting lists.")});
  }
  if(has("عدم الحضور","no-show","noshow","تخلف","غياب")){
    const rows = cl.filter(x=>x.noShowRate!=null).sort((a,b)=>b.noShowRate-a.noShowRate);
    if(!rows.length) return NODATA(L("لا توجد حجوزات كافية لحساب نسبة عدم الحضور.","There are not enough bookings to compute a no-show rate."));
    return R({a:`${L("أعلى نسبة عدم حضور في","The highest no-show rate is in")} ${rows[0].name} ${L("بنسبة","at ")} ${pc(rows[0].noShowRate)}${L("، والمتوسط العام",", and the overall average is")} ${pc(100-t.attendanceRate)}.`,
      ev:`${n0(t.noShows)} ${L("موعد لم يُحضر من","missed appointments out of")} ${n0(t.booked)} ${L("حجز، ما يعادل","bookings, equal to")} ${n1(t.wasted)} ${L("ساعة.","hours.")}`,
      d: tbl([L("العيادة","Clinic"),L("عدم الحضور","No-show rate"),L("الحجوزات","Bookings"),L("لم يحضروا","No-shows")],
        rows.slice(0,5).map(x=>[x.name,pc(x.noShowRate),n0(x.booked),n0(x.noShows)])),
      ip:L("عدم الحضور فاقد مباشر في وقت محجوز مسبقًا، وأثره أعلى من الموعد الشاغر أصلًا.","A no-show is direct waste in time already reserved, and costs more than a slot that was never booked."),
      rc:L("ابدئي بالتأكيد المسبق وإعادة تعبئة الملغى من قائمة الانتظار في العيادات الثلاث الأعلى.","Start with advance confirmation and refilling cancellations from the waiting list in the top three clinics.")});
  }
  if(has("تغيّر","تغير","changed","مقارنة بالشهر","الشهر الماضي","last month")){
    const wc = whatChanged(recs, ROSTER);
    if(!wc) return NODATA(L("البيانات الحالية لا تغطي فترتين قابلتين للمقارنة.","The current data does not cover two comparable periods."));
    const up = wc.rows.filter(r=>r.verdict==="up").length;
    const dn = wc.rows.filter(r=>r.verdict==="down").length;
    const big = wc.rows.filter(r=>r.big).sort((a,b)=>Math.abs(b.rel)-Math.abs(a.rel))[0];
    return R({a:`${L("مقارنة","Comparing")} ${wc.p.curLabel} ${L("بـ","with ")}${wc.p.prevLabel}: ${n0(up)} ${L("مؤشر تحسّن و","indicators improved and ")}${n0(dn)} ${L("مؤشر تراجع.","declined.")}`,
      ev: big? `${L("أكبر تغيّر في","Largest change in")} ${big.l}: ${big.f(big.prev)} ← ${big.f(big.cur)}.` : L("لا يوجد تغيّر يتجاوز ٢٠٪.","No change exceeds 20%."),
      d: tbl([L("المؤشر","Indicator"),wc.p.prevLabel,wc.p.curLabel,L("التغيّر","Change")],
        wc.rows.map(r=>[r.l, r.f(r.prev), r.f(r.cur),
          (r.rel==null?"—":pc(Math.abs(r.rel))+(r.dir==="up"?" ↑":r.dir==="down"?" ↓":" ="))])),
      ip: wc.p.mode==="half" ? L("المقارنة بين نصفي المدة لعدم توفر شهرين كاملين، فهي مؤشر اتجاه لا حكم شهري.","The comparison splits the period in half because two full months are unavailable, so it indicates direction rather than a monthly verdict.")
        : L("المقارنة شهرية كاملة وقابلة للاعتماد كاتجاه.","The comparison covers full months and is reliable as a trend."),
      rc:L("ابدئي بالمؤشر الأكبر تراجعًا وافحصيه على مستوى العيادة قبل أي قرار عام.","Start with the most declined indicator and examine it at clinic level before any general decision.")});
  }
  if(has("نحسّن","نحسن","improve","نركز","focus","توصية","recommend")){
    const al = smartAlerts(recs, sm, t).slice(0,3);
    if(!al.length) return R({a:"لا توجد مؤشرات تستدعي تدخّلًا عاجلًا ضمن الحدود الحالية.",
      ev:`ال${L("استغلال","utilization")} ${pc(t.utilization)} ${L("والحضور","and attendance")} ${pc(t.attendanceRate)} ${L("ضمن العتبات المعرّفة.","are within the defined thresholds.")}`,
      ip:L("غياب التنبيه لا يعني الكفاءة القصوى، بل عدم تجاوز الحدود المضبوطة في الإعدادات.","No alert does not mean peak efficiency — only that the thresholds set in settings were not crossed.")});
    return R({a:`${L("أولويات التحسين:","Improvement priorities:")} ${al.map(a=>a.title).join(" · ")}.`,
      ev: al.map(a=>a.evi).join(" | "),
      d: tbl([L("الأولوية","Priority"),L("المؤشر","Finding")], al.map(a=>[esc(a.title), esc(a.evi)])),
      ip:L("الترتيب حسب الأثر التشغيلي: الفاقد في وقت محجوز أولًا، ثم الطاقة غير المطلوبة.","Ordered by operational impact: waste in reserved time first, then capacity with no demand."),
      rc:L("عالجي البند الأول فقط لدورة واحدة، ثم أعيدي القياس قبل الانتقال للتالي.","Address only the first item for one cycle, then measure again before moving on.")});
  }
  if(named){
    const c = named;
    return R({a:`${c.name}: ${L("استغلال","utilization")} ${pc(c.utilization)}${L("، حضور",", attendance")} ${pc(c.attendanceRate)}، ${n0(c.freeSlots||0)} ${L("موعد شاغر.","open appointments.")}`,
      ev:`${n0(c.days)} ${L("يوم عيادة ·","clinic days ·")} ${n0(c.booked)} ${L("حجز ·","bookings ·")} ${n0(c.seen)} ${L("مخدوم.","patients seen.")}`,
      d: tbl([L("المؤشر","Indicator"),L("القيمة","Value")], [[L("أيام العيادة","Clinic days"),n0(c.days)],[L("الحجوزات","Bookings"),n0(c.booked)],
        [L("المخدومون","Patients seen"),n0(c.seen)],[L("عدم الحضور","No-show rate"),pc(c.noShowRate)],[L("مرضى/ساعة","Patients/hour"),n2(c.seenPerHour)]]),
      ip: c.peak? `${L("الطلب يتركّز يوم","Demand concentrates on")} ${c.peak.day} ${L("وينخفض يوم","and drops on")} ${c.low?c.low.day:"—"}.` : "",
      rc:L("افتحي صفحة أداء العيادات لقراءة التوزيع اليومي والتوصيات الخاصة بها.","Open the Clinic Performance page for the daily distribution and its specific recommendations.")});
  }
  if(namedDoc){
    const d = namedDoc;
    return R({a:`${d.label}: ${n0(d.days)} ${L("يوم عيادة، استغلال","clinic days, utilization")} ${pc(d.utilization)}، ${n2(d.seenPerHour)} ${L("مريض في الساعة.","patients per hour.")}`,
      ev:`${n0(d.booked)} ${L("حجز ·","bookings ·")} ${n0(d.attended)} ${L("حاضر ·","attended ·")} ${n0(d.noShows)} ${L("لم يحضر.","no-shows.")}`,
      d: tbl([L("المؤشر","Indicator"),L("القيمة","Value")], [[L("الحجوزات","Bookings"),n0(d.booked)],[L("الحاضرون","Attended"),n0(d.attended)],
        [L("بلا موعد","Walk-ins"),n0(d.walkIns)],[L("لم يحضروا","No-shows"),n0(d.noShows)],[L("ساعات","Hours"),n1(d.hours)]]),
      ip:L("الأرقام الفردية تتأثر بعدد الأيام، فالمقارنة تصحّ بين أطباء بعدد أيام متقارب.","Individual figures depend on the number of days, so comparisons hold only between doctors with similar day counts.")});
  }
  /* الأقل ازدحامًا */
  if(has("أقل ازدحام","اقل ازدحام","أهدأ","اهدأ","quietest","least busy","أخف يوم")){
    const days = WD.filter(d=>recs.some(r=>r.weekday===d));
    if(!days.length) return NODATA(L("لا توجد بيانات أيام كافية.","Not enough weekday data."));
    const tot = days.map(d=>({d, v:sum(recs.filter(r=>r.weekday===d), r=>r.seen)}));
    const lo = tot.filter(x=>x.v>0).sort((a,b)=>a.v-b.v)[0];
    if(!lo) return NODATA(L("لا توجد بيانات أيام كافية.","Not enough weekday data."));
    return R({a:`${L("أقل الأيام ازدحامًا هو","The quietest day is")} ${lo.d}.`,
      ev:`${n0(lo.v)} ${L("مخدوم في هذا اليوم عبر كل العيادات.","patients seen on that day across all clinics.")}`,
      d: tbl([L("اليوم","Day"),L("المخدومون","Patients seen")], tot.sort((a,b)=>a.v-b.v).map(x=>[x.d,n0(x.v)])),
      ip:L("اليوم الأخف مرشّح لاستقبال جزء من ضغط أيام الذروة.","The lightest day is a candidate to absorb part of the peak-day load.")});
  }

  /* الساعات المهدرة */
  if(has("مهدر","هدر","ضائع","wasted","waste","ساعات ضائعة")){
    if(t.wasted==null) return NODATA(L("لا توجد ساعات مسجّلة.","No recorded hours."));
    return R({a:`${L("الساعات المهدرة","Wasted hours")} ${n1(t.wasted)} ${L("ساعة.","hours.")}`,
      ev:`${n0(t.noShows)} ${L("موعد لم يُحضر من","missed appointments out of")} ${n0(t.booked)} ${L("حجز، من أصل","bookings, out of")} ${n1(t.hours)} ${L("ساعة متاحة.","available hours.")}`,
      ip:`${L("ما يعادل","Equivalent to")} ${pc(t.wastedShare)} ${L("من الوقت العيادي المتاح.","of available clinic time.")}`});
  }

  /* الدخول بلا موعد */
  if(has("بلا موعد","بدون موعد","walk-in","walkin","walk in","مراجع بلا")){
    const rows = cl.filter(x=>x.walkIns!=null && x.walkIns>0).sort((a,b)=>b.walkIns-a.walkIns);
    if(!rows.length) return NODATA(L("لا توجد حالات دخول بلا موعد مسجّلة.","No walk-ins recorded."));
    const c = rows[0];
    return R({a:`${L("أكثر عيادة دخولًا بلا موعد هي","The clinic with the most walk-ins is")} ${c.name} ${L("بعدد","with")} ${n0(c.walkIns)}.`,
      ev:`${L("إجمالي الدخول بلا موعد","Total walk-ins")} ${n0(t.walkIns)} ${L("ويمثل","representing")} ${pc(t.walkShare)} ${L("من المخدومين.","of patients seen.")}`,
      d: tbl([L("العيادة","Clinic"),L("بلا موعد","Walk-ins"),L("المخدومون","Patients seen")],
        rows.slice(0,5).map(x=>[x.name,n0(x.walkIns),n0(x.seen)])),
      ip:L("ارتفاع الدخول بلا موعد يزاحم المواعيد المحجوزة على نفس الوقت.","A high walk-in share competes with booked appointments for the same time.")});
  }

  /* إنتاجية الأطباء */
  if(has("إنتاجية","انتاجية","productive","مرضى في الساعة","أعلى طبيب","اعلى طبيب","أفضل طبيب")){
    const rows = sm.filter(d=>d.hasData && d.seenPerHour!=null).sort((a,b)=>b.seenPerHour-a.seenPerHour);
    if(!rows.length) return NODATA(L("لا توجد ساعات مسجّلة للأطباء.","No recorded doctor hours."));
    const d0 = rows[0];
    return R({a:`${L("أعلى الأطباء إنتاجية","The most productive doctor is")} ${d0.label||d0.name} ${L("بمعدل","at")} ${n2(d0.seenPerHour)} ${L("مراجع/ساعة.","patients per hour.")}`,
      ev:`${n0(d0.seen)} ${L("مخدوم خلال","patients seen over")} ${n1(d0.hours)} ${L("ساعة.","hours.")}`,
      d: tbl([L("الطبيب","Doctor"),L("مراجع/ساعة","Patients/hour"),L("المخدومون","Seen"),L("الساعات","Hours")],
        rows.slice(0,5).map(x=>[x.label||x.name,n2(x.seenPerHour),n0(x.seen),n1(x.hours)])),
      ip:`${L("المتوسط العام","The overall average is")} ${n2(t.seenPerHour)} ${L("مراجع/ساعة.","patients per hour.")}`});
  }

  /* نسبة الحضور */
  if(has("نسبة الحضور","attendance rate","معدل الحضور")){
    if(t.attendanceRate==null) return NODATA(L("لا توجد حجوزات مسجّلة.","No bookings recorded."));
    return R({a:`${L("نسبة الحضور","Attendance rate")} ${pc(t.attendanceRate)}.`,
      ev:`${n0(t.attended)} ${L("حضروا من","attended out of")} ${n0(t.booked)} ${L("حجز.","bookings.")}`,
      ip:`${L("عدم الحضور","No-shows")} ${pc(100-t.attendanceRate)} ${L("أي","that is")} ${n0(t.noShows)} ${L("موعد.","appointments.")}`});
  }

  /* نسبة الملء */
  if(has("نسبة الملء","نسبة ملء","fill rate","ملء المواعيد")){
    if(t.fillRate==null) return NODATA(L("لا توجد طاقة محسوبة.","No computed capacity."));
    return R({a:`${L("نسبة ملء المواعيد","Appointment fill rate")} ${pc(t.fillRate)}.`,
      ev:`${n0(t.booked)} ${L("حجز من طاقة","bookings out of a capacity of")} ${n0(t.capacity)} ${L("موعد.","appointments.")}`,
      ip:`${n0(Math.max(0,t.capacity-t.booked))} ${L("موعد بقي شاغرًا.","appointments remained open.")}`});
  }

  /* التوقّع */
  if(has("متوقع","التوقع","توقّع","forecast","الأسبوع القادم","next week","المستقبل")){
    const f = forecast(recs);
    if(!f || !f.enough || !f.fut || !f.fut.length)
      return NODATA(L("لا توجد أسابيع كافية لبناء توقّع.","Not enough weeks to build a forecast."));
    const nx = f.fut[0];
    return R({a:`${L("المتوقع للأسبوع القادم","Expected next week")} ${n0(nx.value)} ${L("مخدوم.","patients seen.")}`,
      ev:`${L("نطاق ثقة ٩٥٪ بين","95% confidence range between")} ${n0(nx.lo)} ${L("و","and")} ${n0(nx.hi)}، ${L("مبني على","based on")} ${n0(f.keys.length)} ${L("أسبوعًا.","weeks.")}`,
      ip:`${L("الاتجاه العام","The overall trend is")} ${f.trend}.`});
  }

  /* عدّاد عام */
  if(has("عدد الأطباء","كم طبيب","how many doctors","عدد العيادات","كم عيادة","عدد الأيام")){
    return R({a:`${n0(t.doctorsActive)} ${L("طبيبًا لديهم نشاط، و","doctors with activity, and")} ${n0(cl.length)} ${L("عيادة، خلال","clinics, over")} ${n0(t.days)} ${L("يوم عيادة.","clinic days.")}`,
      ev:`${n1(t.hours)} ${L("ساعة عيادية و","clinic hours and")} ${n0(t.seen)} ${L("مخدوم.","patients seen.")}`,
      ip:`${n0(t.doctorsIdle)} ${L("طبيبًا بلا نشاط ضمن التصفية الحالية.","doctors have no activity under the current filters.")}`});
  }

  if(has("كم","إجمالي","اجمالي","total","ملخص","summary")){
    return R({a:`${L("الإجمالي:","Total:")} ${n0(t.seen)} ${L("مخدوم،","patients seen,")} ${n0(t.booked)} ${L("حجز،","bookings,")} ${n0(t.days)} ${L("يوم عيادة، استغلال","clinic days, utilization")} ${pc(t.utilization)}.`,
      ev:`${n1(t.hours)} ${L("ساعة متاحة و","available hours and")}${n1(t.delivered)} ${L("ساعة مخدومة.","hours delivered.")}`,
      d: tbl([L("المؤشر","Indicator"),L("القيمة","Value")], [[L("الحجوزات","Bookings"),n0(t.booked)],[L("الحاضرون","Attended"),n0(t.attended)],
        [L("بلا موعد","Walk-ins"),n0(t.walkIns)],[L("لم يحضروا","No-shows"),n0(t.noShows)],[L("الساعات","Hours"),n1(t.hours)],
        [L("الاستغلال","Utilization"),pc(t.utilization)]]),
      ip:L("هذه الأرقام بعد استبعاد الفئات غير التخصصية من طبقة التحليل.","These figures exclude the non-specialty categories from the intelligence layer.")});
  }
  return R({a:L("لم أتعرّف على السؤال ضمن الحقول المتاحة.","I could not match this question to the available fields."),
    ip:L("المحرّك يجيب من بيانات اللوحة فقط: الاستغلال، الحضور، عدم الحضور، المواعيد الشاغرة، الكثافة اليومية، والمقارنة بين الفترات. لا يستنتج أي رقم أو اسم خارجها.","The engine answers from dashboard data only: utilization, attendance, no-shows, open slots, daily density and period comparison. It infers no number or name beyond that.")});
}

/* ============================================================
   HealthIQ — طبقة العيادات والاستثناءات والواجهة الرئيسية
   ============================================================ */

/* ---------- استثناءات التحليل الذكي ---------- */
const EX_EXACT = ["gp","lab","g.p"];
const EX_PART  = ["general medicine","general practice","dentistry","dental","radiology",
                  "laboratory","imaging","x-ray","الطب العام","طب الأسنان","الأسنان","الاسنان",
                  "الأشعة","الاشعة","المختبر","مختبر","التصوير"];
function isExcluded(v){
  const s = String(v||"").trim().toLowerCase();
  if(!s) return false;
  if(EX_EXACT.includes(s)) return true;
  return EX_PART.some(k=>s.includes(k.toLowerCase()));
}
/* البيانات تبقى كاملة — هذه الدالة تُستخدم في طبقة الذكاء فقط */
function intel(recs){ return recs.filter(r=>!isExcluded(r.department) && !isExcluded(r.deptAr)); }
function excludedRecs(recs){ return recs.filter(r=>isExcluded(r.department) || isExcluded(r.deptAr)); }
function excludedNote(recs){
  const ex = excludedRecs(recs);
  if(!ex.length) return "";
  const names = uniq(ex.map(r=>r.deptAr));
  return `<div class="exnote"><span class="k">مستثنى من التحليل الذكي</span>
    ${esc(names.join("، "))} — ${n0(ex.length)} سجل. البيانات محفوظة كاملة في السجل والجداول،
    ومستبعدة من الترتيب والتنبيهات والتوقّع فقط.</div>`;
}

/* ---------- جدول العيادات الأصلي (من ملف الجدول الأسبوعي) ----------
   المصدر: Latest Update - Weekly 13-17 Sep. الأرقام كما هي في الملف ولم تُعدّل.
   الغرفة ثابتة بالرقم؛ الطبيب والتخصص واليوم والوقت متغيّرات مرتبطة به. */
const SCHED_WEEK = "13–17 Sep";
const CLINIC_ROOMS = /*__ROOMS__*/[{"no": "1", "label": "GP"}, {"no": "2", "label": "FM"}, {"no": "3", "label": "IM"}, {"no": "4", "label": "Lap"}, {"no": "5", "label": "Dent"}, {"no": "6", "label": "Dent"}, {"no": "7", "label": "GP"}, {"no": "8", "label": "X-ray"}, {"no": "9", "label": "Ophth"}, {"no": "10", "label": "Ent"}]/*__END__*/;
const SCHEDULE = /*__SCHEDULE__*/[{"no": "1", "day": "الأحد", "from": "8:00", "to": "16:00", "doctor": "Dr.Shahazad", "specialty": "GP"}, {"no": "1", "day": "الإثنين", "from": "8:00", "to": "16:00", "doctor": "Dr.Shahazad", "specialty": "GP"}, {"no": "1", "day": "الثلاثاء", "from": "8:00", "to": "16:00", "doctor": "Dr.Shahazad", "specialty": "GP"}, {"no": "1", "day": "الأربعاء", "from": "8:00", "to": "16:00", "doctor": "Dr.Shahazad", "specialty": "GP"}, {"no": "1", "day": "الخميس", "from": "8:00", "to": "16:00", "doctor": "Dr.Shahazad", "specialty": "GP"}, {"no": "2", "day": "الأحد", "from": "9:00", "to": "13:00", "doctor": "Dr.Mosleh", "specialty": "IM"}, {"no": "2", "day": "الإثنين", "from": "9:00", "to": "14:00", "doctor": "Dr. Ziyad", "specialty": "FM"}, {"no": "2", "day": "الثلاثاء", "from": "9:00", "to": "13:00", "doctor": "Dr.Alsaker", "specialty": "IM"}, {"no": "3", "day": "الأحد", "from": "9:00", "to": "13:00", "doctor": "Dr.Mansour", "specialty": "Ortho"}, {"no": "3", "day": "الإثنين", "from": "8:00", "to": "15:00", "doctor": "Dr. Soha", "specialty": "Derma"}, {"no": "3", "day": "الثلاثاء", "from": "9:00", "to": "12:00", "doctor": "Dr.Alswaieh", "specialty": "GS"}, {"no": "3", "day": "الأربعاء", "from": "9:00", "to": "14:00", "doctor": "Dr.Rayed", "specialty": "IM"}, {"no": "3", "day": "الخميس", "from": "9:00", "to": "12:00", "doctor": "Dr.Alghaanme", "specialty": "Psych"}, {"no": "5", "day": "الأحد", "from": "9:00", "to": "14:00", "doctor": "", "specialty": "DENT"}, {"no": "5", "day": "الإثنين", "from": "9:00", "to": "14:00", "doctor": "", "specialty": "DENT"}, {"no": "5", "day": "الثلاثاء", "from": "9:00", "to": "14:00", "doctor": "", "specialty": "DENT"}, {"no": "5", "day": "الأربعاء", "from": "9:00", "to": "14:00", "doctor": "", "specialty": "DENT"}, {"no": "5", "day": "الخميس", "from": "9:00", "to": "14:00", "doctor": "", "specialty": "DENT"}, {"no": "6", "day": "الأحد", "from": "9:00", "to": "14:00", "doctor": "", "specialty": "DENT"}, {"no": "6", "day": "الإثنين", "from": "9:00", "to": "14:00", "doctor": "", "specialty": "DENT"}, {"no": "6", "day": "الثلاثاء", "from": "9:00", "to": "14:00", "doctor": "", "specialty": "DENT"}, {"no": "6", "day": "الأربعاء", "from": "9:00", "to": "14:00", "doctor": "", "specialty": "DENT"}, {"no": "6", "day": "الخميس", "from": "9:00", "to": "14:00", "doctor": "", "specialty": "DENT"}, {"no": "7", "day": "الأحد", "from": "8:00", "to": "16:00", "doctor": "Dr Rana", "specialty": "GP"}, {"no": "7", "day": "الإثنين", "from": "8:00", "to": "16:00", "doctor": "Dr Rana", "specialty": "GP"}, {"no": "7", "day": "الثلاثاء", "from": "8:00", "to": "16:00", "doctor": "Dr Rana", "specialty": "GP"}, {"no": "7", "day": "الأربعاء", "from": "8:00", "to": "16:00", "doctor": "Dr Rana", "specialty": "GP"}, {"no": "7", "day": "الخميس", "from": "8:00", "to": "16:00", "doctor": "Dr Rana", "specialty": "GP"}, {"no": "9", "day": "الأحد", "from": "8:00", "to": "14:00", "doctor": "Dr.Waleed", "specialty": "Ophth"}, {"no": "9", "day": "الإثنين", "from": "8:00", "to": "9:00", "doctor": "Dr.Waleed", "specialty": "Ophth"}, {"no": "9", "day": "الإثنين", "from": "9:00", "to": "12:00", "doctor": "Dr.Mazen", "specialty": "Ophth"}, {"no": "9", "day": "الإثنين", "from": "12:00", "to": "14:00", "doctor": "Dr.Waleed", "specialty": "Ophth"}, {"no": "9", "day": "الثلاثاء", "from": "8:00", "to": "9:00", "doctor": "Dr.Waleed", "specialty": "Ophth"}, {"no": "9", "day": "الثلاثاء", "from": "9:00", "to": "12:00", "doctor": "Dr.Mazen", "specialty": "Ophth"}, {"no": "9", "day": "الثلاثاء", "from": "12:00", "to": "14:00", "doctor": "Dr.Waleed", "specialty": "Ophth"}, {"no": "9", "day": "الأربعاء", "from": "8:00", "to": "9:00", "doctor": "Dr.Waleed", "specialty": "Ophth"}, {"no": "9", "day": "الأربعاء", "from": "9:00", "to": "12:00", "doctor": "Dr. Aldawod", "specialty": "Ophth"}, {"no": "9", "day": "الأربعاء", "from": "12:00", "to": "14:00", "doctor": "Dr.Waleed", "specialty": "Ophth"}, {"no": "9", "day": "الخميس", "from": "8:00", "to": "14:00", "doctor": "Dr.Waleed", "specialty": "Ophth"}, {"no": "10", "day": "الأحد", "from": "9:00", "to": "12:00", "doctor": "Dr.Samer", "specialty": "URO"}, {"no": "10", "day": "الثلاثاء", "from": "9:00", "to": "12:00", "doctor": "Dr.Alghammdi", "specialty": "Psych"}, {"no": "10", "day": "الثلاثاء", "from": "13:00", "to": "16:00", "doctor": "Dr. Ibrahim", "specialty": "ENT"}, {"no": "10", "day": "الخميس", "from": "9:00", "to": "13:00", "doctor": "Dr.Fawaz", "specialty": "Cardio"}]/*__END__*/;
const SCHED_HOURS = 208;
/* ساعات الشبكة المتاحة لكل غرفة: ٨ ساعات × ٥ أيام */
const ROOM_GRID_HOURS = 40;

/* ---------- سجل العيادات (الأرقام ثابتة) ---------- */
/* بنية الصف: {no, day, from, to, doctor, specialty}
   رقم العيادة معرّف دائم للحيّز الفيزيائي ولا يُولَّد ولا يُعاد ترقيمه إطلاقًا. */
function clinicRows(){
  const c = Array.isArray(CFG.clinics) ? CFG.clinics : [];
  return c.length ? c : SCHEDULE;      /* الجدول الأصلي هو المصدر عند عدم وجود استيراد */
}
const DAY_MAP = {"الأحد":"Sunday","الإثنين":"Monday","الاثنين":"Monday","الثلاثاء":"Tuesday",
  "الأربعاء":"Wednesday","الخميس":"Thursday","الجمعة":"Friday","السبت":"Saturday"};
function dayLabel(d){ return LANG==="en" ? (DAY_MAP[d] || d) : d; }
function hoursOf(s){
  const h = x => parseInt(String(x||"0").split(":")[0],10) || 0;
  return Math.max(0, h(s.to) - h(s.from));
}

function clinicRegistry(){
  const g = new Map();
  /* كل غرفة في الجدول الأصلي تظهر دائمًا، حتى بلا فترات مسندة */
  CLINIC_ROOMS.forEach(rm=> g.set(String(rm.no), {no:String(rm.no), label:rm.label, slots:[]}));
  clinicRows().forEach(r=>{
    const no = String(r.no==null?"":r.no).trim();
    if(!no) return;
    if(!g.has(no)) g.set(no, {no, label:"", slots:[]});
    g.get(no).slots.push(r);
  });
  return [...g.values()].map(c=>({
    ...c,
    assigned: c.slots.reduce((a,s)=>a+hoursOf(s),0),
    free: Math.max(0, ROOM_GRID_HOURS - c.slots.reduce((a,s)=>a+hoursOf(s),0)),
    doctors: uniq(c.slots.map(s=>s.doctor).filter(Boolean)),
    specialties: uniq(c.slots.map(s=>s.specialty).filter(Boolean)),
    days: uniq(c.slots.map(s=>s.day).filter(Boolean)),
    excluded: c.slots.every(s=>isExcluded(s.specialty)),
    mixed: c.slots.some(s=>isExcluded(s.specialty)) && c.slots.some(s=>!isExcluded(s.specialty))
  }));
}

function parseClinicCsv(text){
  const out = [], errs = [];
  String(text||"").split(/\r?\n/).forEach((line,i)=>{
    const t = line.trim();
    if(!t) return;
    const p = t.split(/[,،\t;]/).map(x=>x.trim());
    if(/^(no|clinic|رقم)/i.test(p[0]) && i===0) return;
    if(p.length < 5){ errs.push(i+1); return; }
    out.push({no:p[0], day:p[1], from:p[2], to:p[3], doctor:p[4], specialty:p[5]||""});
  });
  return {rows:out, errs};
}

function pageRegistry(recs){
  const reg = clinicRegistry();
  const canEdit = isAdmin();
  const importBox = canEdit ? `
    <h2 class="sec">${L("استيراد الجدول","Import schedule")}</h2>
    <div class="card">
      <div class="cs">${L("صف لكل فترة، بالترتيب:","One row per period, in this order:")}
        <code>${L("رقم العيادة، اليوم، من، إلى، الطبيب، التخصص","Clinic number, Day, From, To, Doctor, Specialty")}</code></div>
      <textarea id="clinCsv" class="csvbox" rows="6"
        placeholder="10, الأحد, 10:00, 12:00, د. إبراهيم العريفي, ENT&#10;10, الإثنين, 12:00, 14:00, د. سامر, Urology"></textarea>
      <div class="adminbar">
        <button class="ghost primary" id="clinAdd">${L("إضافة للسجل","Add to registry")}</button>
        <button class="ghost" id="clinReplace">${L("استبدال السجل بالكامل","Replace entire registry")}</button>
        <button class="ghost danger" id="clinClear">${L("تفريغ السجل","Clear registry")}</button>
        <span id="clinMsg" class="cfmsg"></span>
      </div>
      <div class="cap">${L("الأرقام تُحفظ كما تُدخل حرفيًا. النظام لا يولّد رقمًا ولا يعيد ترقيم أي عيادة.","Numbers are stored exactly as entered. The system never generates or renumbers a clinic.")}</div>
    </div>` : "";

  if(!reg.length) return `
    <div class="banner"><div class="q">${L("سجل العيادات","Clinic Registry")}</div>
      </div>
    <div class="card empty">
      <div class="ct">${L("لا يوجد جدول عيادات محمّل","No clinic schedule loaded")}</div>
      
      
    </div>
    ${importBox}`;

  const exCount = reg.filter(c=>c.excluded).length;
  const assigned = reg.reduce((a,c)=>a+c.assigned,0);
  const grid = reg.length * ROOM_GRID_HOURS;
  const idle = reg.filter(c=>!c.slots.length);
  const src = clinicRows()===SCHEDULE;

  return `
  <div class="banner"><div class="q">${L("سجل العيادات ·","Clinic Registry ·")} ${esc(SCHED_WEEK)}</div>
    <div class="a">${n0(reg.length)} ${L("غرفة ·","rooms ·")} ${n0(clinicRows().length)} ${L("فترة مسندة","assigned periods")}
    ${exCount? `· ${n0(exCount)} ${L("غرفة خارج التحليل الذكي","rooms outside the intelligence layer")}` : ""}
    ${src? L("· المصدر: الجدول الأسبوعي الأصلي","· Source: original weekly schedule") : L("· المصدر: استيراد المسؤول","· Source: admin import")}</div></div>

  <div class="grid g4">
    ${kpiCard(L("غرف العيادات","Clinic rooms"), n0(reg.length), L("الرقم معرّف ثابت","Number is a fixed identifier"))}
    ${kpiCard(L("ساعات مسندة","Assigned hours"), n1(assigned), `${L("من","From")} ${n1(grid)} ${L("ساعة في الشبكة","hours in the grid")}`)}
    ${kpiCard(L("ساعات غير مسندة","Unassigned hours"), n1(grid-assigned), `${pc(grid?(grid-assigned)/grid*100:null)} ${L("من الشبكة","of the grid")}`, (grid-assigned)/grid>0.4)}
    ${kpiCard(L("غرف بلا جدول","Rooms with no schedule"), n0(idle.length), idle.length? idle.map(c=>c.no).join("، ") : L("لا يوجد","None"))}
  </div>

  <h2 class="sec">${L("الغرف","Rooms")}</h2>
  ${reg.map(c=>`
    <div class="clinic-row ${c.excluded?"ex":""}">
      <div class="cn">${esc(c.no)}</div>
      <div class="cbody">
        <div class="ctop">
          <span class="ctitle">${L("عيادة","Clinic")} ${esc(c.no)}${c.label?` · ${esc(c.label)}`:""}</span>
          ${c.excluded? `<span class="pill mid">${L("خارج التحليل","Outside analysis")}</span>`:""}
          ${c.mixed? `<span class="pill mid">${L("فترات مختلطة","Mixed periods")}</span>`:""}
          ${!c.slots.length? `<span class="pill mid">${L("بلا جدول هذا الأسبوع","No schedule this week")}</span>`:""}
          <span class="tag">${n0(c.slots.length)} ${L("فترة","periods")}</span>
        </div>
        <div class="cmeta">${esc(c.specialties.join(" · ") || L("بلا تخصص مسند هذا الأسبوع","No specialty assigned this week"))}
          ${c.slots.length? ` — ${n1(c.assigned)} ${L("ساعة مسندة ·","assigned hours ·")} ${n1(c.free)} ${L("ساعة شاغرة","free hours")}` : ""}</div>
        ${c.slots.length? `<details class="qa-e"><summary>${L("الفترات والأطباء","Periods and doctors")}</summary>
          <table><thead><tr><th>${L("اليوم","Day")}</th><th>${L("من","From")}</th><th>${L("إلى","To")}</th><th>${L("الطبيب","Doctor")}</th><th>${L("التخصص","Specialty")}</th></tr></thead>
          <tbody>${c.slots.map(s=>`<tr${isExcluded(s.specialty)?' class="dim"':''}>
            <td>${esc(dayLabel(s.day)||"—")}</td><td class="mono">${esc(s.from||"—")}</td>
            <td class="mono">${esc(s.to||"—")}</td><td>${esc(s.doctor||"—")}</td>
            <td>${esc(s.specialty||"—")}</td></tr>`).join("")}</tbody></table>
        </details>`:""}
      </div>
    </div>`).join("")}

  

  <div class="exnote"><span class="k">${L("ما ينقص للربط الكامل","What is missing for a full link")}</span>
  ${L("هذا الملف يحتوي الجدول فقط: الغرفة واليوم والوقت والطبيب والتخصص. لا يحتوي أعداد الحجوزات ولا الحضور ولا عدم الحضور، فلا يمكن حساب الاستغلال الفعلي لكل غرفة منه وحده.","This file contains the schedule only: room, day, time, doctor and specialty. It has no booking, attendance or no-show counts, so real per-room utilization cannot be computed from it alone.")}</div>
  ${importBox}`;
}

function bindRegistry(){
  if(!isAdmin() || !$("clinAdd")) return;
  const msg = (t,ok)=>{ const m=$("clinMsg"); if(!m) return;
    m.textContent=t; m.className="cfmsg "+(ok?"ok":"err"); };
  const read = ()=> parseClinicCsv($("clinCsv").value);
  $("clinAdd").onclick = ()=>{
    const {rows,errs} = read();
    if(!rows.length) return msg("لا توجد صفوف صالحة", false);
    CFG.clinics = clinicRows().concat(rows);
    saveCfg(); render();
    msg(`أُضيفت ${rows.length} فترة${errs.length?` · تجاهلت ${errs.length} سطرًا ناقصًا`:""}`, true);
  };
  $("clinReplace").onclick = ()=>{
    const {rows,errs} = read();
    if(!rows.length) return msg("لا توجد صفوف صالحة", false);
    CFG.clinics = rows; saveCfg(); render();
    msg(`استُبدل السجل بـ${rows.length} فترة${errs.length?` · تجاهلت ${errs.length} سطرًا`:""}`, true);
  };
  $("clinClear").onclick = ()=>{ CFG.clinics = []; saveCfg(); render(); };
}

/* ---------- AI Spotlight ---------- */
function spotlight(recs, sm, t){
  const al = smartAlerts(recs, sm, t);
  const wc = whatChanged(recs, ROSTER);
  const big = wc ? wc.rows.filter(r=>r.big).sort((a,b)=>Math.abs(b.rel)-Math.abs(a.rel))[0] : null;
  const crit = al.find(a=>a.lv==="crit") || al[0];

  if(big && big.verdict==="down"){
    return {head:`${big.l} ${L("تراجع بنسبة","declined by")} ${pc(Math.abs(big.rel))} ${L("مقارنة بـ","compared with")}${wc.p.prevLabel}.`,
      nums:`${big.f(big.prev)} ← ${big.f(big.cur)}`,
      why:L("هذا المؤشر يقيس كفاءة استخدام الوقت العيادي المتاح. تراجعه يعني أن جزءًا من الطاقة الموجودة أصلًا لم يُستثمر، وهو فاقد لا يظهر في أعداد المرضى المطلقة.","This metric measures how efficiently available clinical time is used. A decline means part of the existing capacity went unused — waste that absolute patient counts never show."),
      lv:"crit", go:"changed"};
  }
  if(crit){
    return {head:crit.title, nums:crit.evi, why:crit.rec, lv:crit.lv, go:"ai"};
  }
  if(big){
    return {head:`${big.l} ${L("تحسّن بنسبة","improved by")} ${pc(Math.abs(big.rel))} ${L("مقارنة بـ","compared with")}${wc.p.prevLabel}.`,
      nums:`${big.f(big.prev)} ← ${big.f(big.cur)}`,
      why:L("الحفاظ على هذا التحسّن يتطلب معرفة سببه التشغيلي قبل تعميمه على بقية العيادات.","Sustaining this improvement requires knowing its operational cause before applying it to other clinics."),
      lv:"info", go:"changed"};
  }
  return {head:L("لا يوجد مؤشر يستدعي انتباهًا عاجلًا في هذه الفترة.","No metric requires urgent attention in this period."),
    nums:`${L("الاستغلال","Utilization")} ${pc(t.utilization)} · ${L("الحضور","attendance")} ${pc(t.attendanceRate)}`,
    why:L("جميع المؤشرات ضمن الحدود المعرّفة في إعدادات التحليل.","All metrics are within the thresholds defined in analysis settings."), lv:"info", go:"ai"};
}

/* ---------- الصفحة الرئيسية ---------- */
const KPI_DEFS_BASE = [
  {k:"appts", t:"kAppts", ico:"appts"}, {k:"util", t:"kUtil", ico:"util"},
  {k:"ns", t:"kNs", ico:"ns"}, {k:"slots", t:"kSlots", ico:"slots"}
];
Object.defineProperty(globalThis, "KPI_DEFS", {get:()=>KPI_DEFS_BASE.map(d=>({...d, l:tr(d.t)}))});
const KPI_ICON = {
  appts:'<path d="M7 3v3M17 3v3"/><rect x="3.5" y="5.5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17"/>',
  util:'<path d="M4 20h16"/><path d="M8 20v-6"/><path d="M13 20V8"/><path d="M18 20v-9"/>',
  ns:'<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/><path d="M18.5 5.5l-13 13"/>',
  slots:'<rect x="3.5" y="4.5" width="17" height="16" rx="2.5"/><path d="M3.5 9.5h17"/><path d="M9 14h6"/>'
};

function homeKpis(recs, sm, t){
  const cl = clinics(recs, sm);
  const freeSlots = Math.max(0, (t.capacity||0) - (t.booked||0));
  const nsr = t.attendanceRate==null? null : 100-t.attendanceRate;
  return {
    appts:{v:n0(t.booked), raw:t.booked, fmt:"n0", note:`${n0(t.attended)} حاضر · ${n0(t.walkIns)} بلا موعد`, cl},
    util:{v:pc(t.utilization), raw:t.utilization, fmt:"pc", note:`${n1(t.delivered)} من ${n1(t.hours)} ساعة`, cl,
          alert:t.utilization!=null && t.utilization<CFG.ai.utilLow},
    ns:{v:pc(nsr), raw:nsr, fmt:"pc", note:`${n0(t.noShows)} موعد · ${n1(t.wasted)} ساعة`,
        cl, alert:nsr!=null && nsr>CFG.ai.noShowHigh},
    slots:{v:n0(freeSlots), raw:freeSlots, fmt:"n0", note:`من طاقة ${n0(t.capacity)} موعد`, cl}
  };
}

function kpiDetail(key, recs, sm, t){
  const cl = clinics(recs, sm).filter(c=>c.capacity);
  if(key==="appts"){
    const byDate = {};
    recs.forEach(r=>{ byDate[r.date]=byDate[r.date]||{b:0,s:0}; byDate[r.date].b+=r.booked; byDate[r.date].s+=r.seen; });
    const ks = Object.keys(byDate).sort();
    return `${vBars(ks.map(k=>k.slice(5)), [
      {name:L("حجوزات","Bookings"), values:ks.map(k=>byDate[k].b), color:C.teal},
      {name:L("مخدومون","Patients seen"), values:ks.map(k=>byDate[k].s), color:C.ochre}], {height:250})}
      <div class="cap">${L("أزرق: الحجوزات · سماوي داكن: المخدومون فعليًا · المحور: تواريخ العيادة","Blue: bookings · Dark azure: patients actually seen · Axis: clinic dates")}</div>`;
  }
  if(key==="util") return `${vBars(cl.map(c=>c.name),
      [{name:L("الاستغلال","Utilization"), values:cl.map(c=>c.utilization), color:C.teal}], {height:250})}
      <div class="cap">${L("الاستغلال = المخدومون ÷ الطاقة الاستيعابية. الحد المرجعي","Utilization = patients seen ÷ capacity. Benchmark:")} ${CFG.ai.utilLow}%.</div>`;
  if(key==="ns"){
    const rows = cl.filter(c=>c.noShowRate!=null).sort((a,b)=>b.noShowRate-a.noShowRate);
    return `${vBars(rows.map(c=>c.name),
      [{name:L("عدم الحضور","No-shows"), values:rows.map(c=>c.noShowRate), color:C.terra}], {height:250})}
      <div class="cap">${L("النسبة من الحجوزات المؤكدة لكل عيادة.","Share of confirmed bookings per clinic.")}</div>`;
  }
  const rows = cl.filter(c=>c.freeSlots!=null).sort((a,b)=>b.freeSlots-a.freeSlots);
  return `${vBars(rows.map(c=>c.name),
    [{name:L("مواعيد شاغرة","Open slots"), values:rows.map(c=>c.freeSlots), color:C.ochre}], {height:250})}
    <div class="cap">${L("الطاقة ناقص المحجوز. لا تشمل الدخول بلا موعد.","Capacity minus booked. Excludes walk-ins.")}</div>`;
}

function progressBadge(recs){
  const wc = whatChanged(recs, ROSTER);
  if(!wc) return "";
  const up = wc.rows.filter(r=>r.verdict==="up" && r.big);
  const dn = wc.rows.filter(r=>r.verdict==="down" && r.big);
  if(!up.length || dn.length > up.length) return "";
  const top = up.sort((a,b)=>Math.abs(b.rel)-Math.abs(a.rel))[0];
  return `<div class="progress">
    <span class="pi">↗</span>
    <span class="pt"><b>تقدّم ملموس</b>
    ${esc(top.l)} تحسّن من ${top.f(top.prev)} إلى ${top.f(top.cur)} مقارنة بـ${esc(wc.p.prevLabel)}.</span>
  </div>`;
}

function homeDelta(recs){
  const wc = whatChanged(recs, DOCTORS);
  if(!wc) return null;
  const r = wc.rows.filter(x=>x.rel!=null && x.verdict!=="flat")
                   .sort((x,y)=>Math.abs(y.rel)-Math.abs(x.rel))[0];
  if(!r) return null;
  return {label:r.l, rel:r.rel, good:r.verdict==="up"};
}

function pageHome(recs, sm, bm, t){
  const sp = spotlight(recs, sm, t);
  const k  = homeKpis(recs, sm, t);
  const dl = homeDelta(recs);

  const tiles = [
    ["ai",      L("التحليل","Analysis"),   L("مؤشرات الأداء والتنبيهات","Performance metrics and alerts"), "t1"],
    ["clinic",  L("العيادات","Clinics"),   L("الطاقة والمواعيد","Capacity and appointments"),              "t2"],
    ["bench",   L("الأطباء","Doctors"),    L("مقارنة الأداء","Performance comparison"),                    "t3"],
    ["ask",     L("المساعد الذكي","Assistant"), L("أسئلة على بياناتك","Questions on your data"),           "t4"]
  ].filter(x=>pageAllowed(x[0]));

  return `
  <section class="whero">
    <div class="wtxt">
      <h2>${L("مرحبًا بك في","Welcome to")} <b>${esc(CFG.brand)}</b></h2>
      <p>${L("من البيانات إلى قرارات أفضل","From data to better decisions")}</p>
    </div>
    <div class="wviz">
      ${dl ? `<span class="wbadge ${dl.good?"up":"down"}">${dl.rel>0?"+":"−"}${pc(Math.abs(dl.rel)).replace("%","")}%
        <i>${esc(dl.label)}</i></span>` : ""}
      <svg viewBox="0 0 120 70" aria-hidden="true"><g fill="#BBD9F1">
        <rect x="4"  y="38" width="13" height="28" rx="3"/>
        <rect x="23" y="26" width="13" height="40" rx="3" fill="#7FB6E3"/>
        <rect x="42" y="14" width="13" height="52" rx="3" fill="#4C96D3"/>
        <rect x="61" y="32" width="13" height="34" rx="3"/>
        <rect x="80" y="44" width="13" height="22" rx="3"/>
        <rect x="99" y="22" width="13" height="44" rx="3" fill="#7FB6E3"/>
      </g></svg>
    </div>
  </section>

  ${ pendingCount() ? `<button class="pendstrip" data-go="access">
      <span class="pdot2">${pendingCount()}</span>
      ${L("طلب وصول بانتظار قرارك","access requests awaiting your decision")}
     </button>` : "" }

  <div class="tiles">
    ${tiles.map(([g,ttl,sub,c])=>`<button class="tile ${c}" data-go="${g}">
      <span class="tico">${svgIcon(g)}</span>
      <span class="ttl">${ttl}</span>
      <span class="tsb">${sub}</span>
      <span class="tgo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
        stroke-linecap="round" stroke-linejoin="round"><path d="M14 6l6 6-6 6"/></svg></span>
    </button>`).join("")}
  </div>

  <div class="todaycard" data-go="ai">
    <div class="tdh"><span class="tdi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
      stroke-width="1.7"><path d="M12 3.5a5.4 5.4 0 0 0-3.2 9.7c.4.3.6.8.6 1.3v.7h5.2v-.7c0-.5.2-1 .6-1.3A5.4 5.4 0 0 0 12 3.5z"/>
      <path d="M10 18.4h4"/><path d="M10.7 20.5h2.6"/></svg></span>
      <span>${L("أهم ما رصده التحليل","Top finding")}</span></div>
    <div class="tdt">${esc(sp.head)}</div>
    <div class="tdn mono">${esc(sp.nums)}</div>
  </div>

  ${(()=>{ const a = smartAlerts(recs, sm, t).slice(0,3); if(!a.length) return "";
      const S = SEV();
      return `<h2 class="sec">${L("يحتاج انتباهك","Needs your attention")}</h2>
      <div class="card">${a.map(x=>`
        <div class="alertrow">
          <div class="alerthd"><span class="prio ${ (S[x.lv]||{}).c || "md" }">${ (S[x.lv]||{}).t || "" }</span>
            <b>${esc(x.title)}</b></div>
          <div class="alertev mono">${esc(x.evi)}</div>
        </div>`).join("")}
        <button class="ghost" data-go="ai">${L("بقية التنبيهات","All alerts")}</button>
      </div>`; })()}

  ${progressBadge(recs)}

  <h2 class="sec">${tr("kpis")}</h2>
  <div class="grid g4">
    ${KPI_DEFS.map(d=>{
      const v = k[d.k], on = state.kpi===d.k;
      return `<button class="kpibtn ${on?"on":""} ${v.alert?"alert":""}" data-kpi="${d.k}">
        <span class="ki"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
          stroke-linecap="round" stroke-linejoin="round">${KPI_ICON[d.ico]}</svg></span>
        <span class="kl">${d.l}</span>
        <span class="kv mono" data-count="${v.raw==null?"":v.raw}" data-fmt="${v.fmt||"n0"}">${v.v}</span>
        <span class="kn">${v.note}</span>
        <span class="kmore">${on?tr("hideMore"):tr("showMore")}</span>
      </button>`;
    }).join("")}
  </div>

  ${state.kpi ? `<div class="card kpanel">
    <div class="ct">${esc((KPI_DEFS.find(d=>d.k===state.kpi)||{}).l||"")}</div>
    ${kpiDetail(state.kpi, recs, sm, t)}
  </div>` : ""}

  ${excludedNote(filtered())}`;
}

/* ---------- صفحات جديدة ---------- */
const SEV = () => ({crit:{t:L("أولوية عالية","High priority"), c:"hi"},
  warn:{t:L("أولوية متوسطة","Medium priority"), c:"md"},
  info:{t:L("أولوية منخفضة","Low priority"), c:"lo"}});
function sevPill(lv){ const v=SEV()[lv]; return `<span class="prio ${v.c}">${v.t}</span>`; }

function alertCard(a){
  return `<div class="alert-card ${a.lv}">
    <div class="ah">${sevPill(a.lv)}<span class="at">${esc(a.title)}</span></div>
    <div class="pev"><span class="k">${L("الدليل","Evidence")}</span><span class="v">${esc(a.evi)}</span></div>
  </div>`;
}

function pageAI(recs, sm, bm, t){
  const s = execSummary(recs, sm, t);
  const alerts = smartAlerts(recs, sm, t);
  const byLv = lv => alerts.filter(a=>a.lv===lv);
  return `
  <div class="banner"><div class="q">AI EXECUTIVE INSIGHT · ${L("الملخّص التنفيذي","Executive Summary")}</div>
    <div class="a">${esc(s.head)}</div></div>

  <div class="grid g2">
    <div class="card"><div class="ct">${L("تغيّرات إيجابية","Positive changes")}</div>
      ${s.pos.length? `<ul class="ailist good">${s.pos.map(x=>`<li>${esc(x)}</li>`).join("")}</ul>`
        : `<div class="cs">${L("لا توجد مؤشرات إيجابية بارزة في هذه الفترة.","No notable positive indicators in this period.")}</div>`}</div>
    <div class="card"><div class="ct">${L("تغيّرات سلبية ونقاط تحتاج انتباهًا","Negative changes and areas needing attention")}</div>
      ${s.neg.length? `<ul class="ailist bad">${s.neg.map(x=>`<li>${esc(x)}</li>`).join("")}</ul>`
        : `<div class="cs">${L("لا توجد مؤشرات سلبية بارزة في هذه الفترة.","No notable negative indicators in this period.")}</div>`}</div>
  </div>

  ${s.notes.length? `<div class="assume" style="margin-top:14px">${s.notes.map(esc).join(" ")}</div>`:""}

  <h2 class="sec">SMART ALERTS · ${L("التنبيهات الذكية","Smart Alerts")}</h2>
  <div class="prioline">
    <span class="prio hi">${L("عالية","High")} ${n0(byLv("crit").length)}</span>
    <span class="prio md">${L("متوسطة","Medium")} ${n0(byLv("warn").length)}</span>
    <span class="prio lo">${L("منخفضة","Low")} ${n0(byLv("info").length)}</span>
  </div>
  ${alerts.length? alerts.map(alertCard).join("")
    : `<div class="card">${L("لا توجد تنبيهات ضمن الحدود المعرّفة حاليًا.","No alerts within the thresholds currently set.")}</div>`}

  ${excludedNote(filtered())}

  `;
}

function pageChanged(recs, sm, t){
  const wc = whatChanged(recs, ROSTER);
  if(!wc) return `<div class="card">${L("تحتاج المقارنة إلى فترتين على الأقل. البيانات الحالية تغطي فترة واحدة قصيرة.","Comparison needs at least two periods. The current data covers one short period.")}</div>`;
  const arrow = r => r.dir==="flat" ? "=" : (r.dir==="up" ? "↑" : "↓");
  const cls = r => r.verdict==="up" ? "up" : (r.verdict==="down" ? "dn" : "mid");
  const bars = wc.rows.filter(r=>r.rel!=null).slice(0,7);
  const maxAbs = Math.max(...bars.map(b=>Math.abs(b.rel)),1);

  return `
  <div class="banner"><div class="q">${L("المقارنة","Comparison")}</div>
    <div class="a">${esc(wc.p.curLabel)} ${L("مقابل","vs")} ${esc(wc.p.prevLabel)}${wc.p.mode==="half"?L("(تقسيم المدة إلى نصفين لعدم توفر شهرين كاملين)","(period split in half; two full months are not available)"):""}</div></div>

  <div class="grid g3">
    ${["up","down","flat"].map(v=>{
      const n = wc.rows.filter(r=>r.verdict===v).length;
      return `<div class="card kpi"><div class="l">${wc.VT[v]}</div><div class="v">${n0(n)}</div>
        <div class="n">${L("مؤشر من","of")} ${n0(wc.rows.length)}</div></div>`;
    }).join("")}
  </div>

  <h2 class="sec">${L("حجم التغيّر","Size of change")}</h2>
  <div class="card">
    ${bars.map(b=>`
      <div class="chg">
        <div class="cl">${esc(b.l)}</div>
        <div class="cbar"><span class="${cls(b)}" style="width:${Math.min(100,Math.abs(b.rel)/maxAbs*100)}%"></span></div>
        <div class="cv ${cls(b)}">${arrow(b)} ${pc(Math.abs(b.rel))}</div>
      </div>`).join("")}
    <div class="cap">${L("النسبة تمثّل التغيّر النسبي بين الفترتين. التغيّر تحت ٣٪ يُعامل كثبات.","Percentages show relative change between the two periods. Changes under 3% count as flat.")}</div>
  </div>

  <h2 class="sec">${L("التفصيل الرقمي","Numeric detail")}</h2>
  <div class="card"><table>
    <thead><tr><th>${L("المؤشر","Indicator")}</th><th>${esc(wc.p.prevLabel)}</th><th>${esc(wc.p.curLabel)}</th><th>${L("الفرق","Change")}</th><th>${L("الحكم","Verdict")}</th></tr></thead>
    <tbody>${wc.rows.map(r=>`<tr>
      <td>${esc(r.l)}</td><td class="mono">${r.f(r.prev)}</td><td class="mono">${r.f(r.cur)}</td>
      <td class="mono">${r.rel==null?"—":arrow(r)+" "+pc(Math.abs(r.rel))}</td>
      <td><span class="pill ${cls(r)}">${wc.VT[r.verdict]}</span></td></tr>`).join("")}</tbody>
  </table></div>`;
}

function pageForecast(recs){
  const fc = forecast(recs);
  if(!fc) return `<div class="card">${L("التوقّع معطّل من إعدادات المسؤول.","Forecasting is disabled in admin settings.")}</div>`;
  if(!fc.enough) return `<div class="card">${L("التوقّع يحتاج ٤ أسابيع على الأقل من البيانات. المتوفّر حاليًا","Forecasting needs at least 4 weeks of data. Currently available:")} ${n0(fc.points)} ${L("أسبوع.","weeks.")}</div>`;

  const cats = fc.keys.map((k,i)=>"أ"+(i+1)).concat(fc.fut.map((f,i)=>"ت"+(i+1)));
  const hist = fc.series.concat(fc.fut.map(()=>null));
  const pred = fc.keys.map(()=>null).concat(fc.fut.map(f=>f.value));

  return `
  <div class="mock">${L("هذه القيم توقّعات إحصائية مبنية على انحدار خطي بسيط، وليست حقائق مؤكدة. دقّتها محدودة بعدد الأسابيع المتاحة وتتغيّر مع كل تحديث للبيانات.","These are statistical predictions from a simple linear regression, not confirmed facts. Accuracy is limited by the weeks available and shifts with every data update.")}</div>

  <h2 class="sec">${L("الاتجاه الأسبوعي (مرضى في الساعة)","Weekly trend (patients per hour)")}</h2>
  <div class="card">
    ${vBars(cats, [{name:L("فعلي","Actual"), values:hist, color:C.teal},
                   {name:L("توقّع","Forecast"), values:pred, color:C.ochre}], {height:280})}
    <div class="cap">${L("أ = أسبوع فعلي · ت = أسبوع متوقّع","A = actual week · F = forecast week")}</div>
  </div>

  <div class="grid g3">
    <div class="card kpi"><div class="l">${L("الاتجاه","Trend")}</div><div class="v">${fc.trend}</div>
      <div class="n">${L("ميل","slope")} ${n2(fc.slope)} ${L("لكل أسبوع","per week")}</div></div>
    <div class="card kpi"><div class="l">${L("جودة الملاءمة R²","Goodness of fit R²")}</div><div class="v mono">${n2(fc.r2)}</div>
      <div class="n">${fc.r2>=0.6?L("ملاءمة معقولة","Reasonable fit"):L("ملاءمة ضعيفة — تعاملي مع التوقّع بحذر","Weak fit — treat the forecast with caution")}</div></div>
    <div class="card kpi"><div class="l">${L("هامش الخطأ","Margin of error")}</div><div class="v mono">±${n2(1.96*fc.rmse)}</div>
      <div class="n">${L("مجال ثقة ٩٥٪","95% confidence interval")}</div></div>
  </div>

  <h2 class="sec">${L("القيم المتوقّعة","Forecast values")}</h2>
  <div class="card"><table>
    <thead><tr><th>${L("الأسبوع","Week")}</th><th>${L("التوقّع","Forecast")}</th><th>${L("الحد الأدنى","Lower bound")}</th><th>${L("الحد الأعلى","Upper bound")}</th></tr></thead>
    <tbody>${fc.fut.map(f=>`<tr><td>${L("بعد","In")} ${n0(f.week)} ${L("أسبوع","week(s)")}</td>
      <td class="mono">${n2(f.value)}</td><td class="mono">${n2(f.lo)}</td>
      <td class="mono">${n2(f.hi)}</td></tr>`).join("")}</tbody>
  </table><div class="cap">${L("الوحدة: مرضى مخدومون لكل ساعة عيادة.","Unit: patients seen per clinic hour.")}</div></div>`;
}

function pageClinic(recs, sm, t){
  const cl = clinics(recs, sm);
  if(!cl.length) return `<div class="card">${L("لا توجد عيادات بمعطيات كافية.","No clinics have enough data.")}</div>`;
  const cur = cl.find(c=>c.name===state.clinic) || cl[0];
  const alerts = smartAlerts(recs, sm, t).filter(a=>a.title.includes(cur.name));

  return `
  <div class="filters" style="margin-bottom:16px">
    <span><label>${L("العيادة","Clinic")}</label>
      <select id="selClinic">${cl.map(c=>`<option ${c.name===cur.name?"selected":""}>${esc(c.name)}</option>`).join("")}</select>
    </span>
    <span style="font-size:11.5px;color:var(--muted)">${n0(cur.doctors.length)} ${L("طبيب ·","doctors ·")} ${n0(cur.days)} ${L("يوم عيادة","clinic days")}</span>
  </div>

  <div class="grid g4">
    ${kpiCard(L("الاستغلال","Utilization"), pc(cur.utilization), L("مخدومون ÷ الطاقة","patients seen ÷ capacity"), cur.utilization!=null && cur.utilization<CFG.ai.utilLow)}
    ${kpiCard(L("نسبة الحضور","Attendance rate"), pc(cur.attendanceRate), `${n0(cur.attended)} ${L("من","of")} ${n0(cur.booked)}`)}
    ${kpiCard(L("عدم الحضور","No-show rate"), pc(cur.noShowRate), `${n0(cur.noShows)} ${L("موعد","appointments")}`, cur.noShowRate>CFG.ai.noShowHigh)}
    ${kpiCard(L("مواعيد شاغرة","Available slots"), n0(cur.freeSlots), `${L("من طاقة","of capacity")} ${n0(cur.capacity)}`)}
  </div>

  <h2 class="sec">${L("الكثافة حسب اليوم","Density by day")}</h2>
  <div class="card">
    ${cur.wdRows.length? vBars(cur.wdRows.map(r=>r.day),
        [{name:L("مرضى/ساعة","patients/hour"), values:cur.wdRows.map(r=>r.perHour), color:C.teal}], {height:250})
      : `<div class="cs">${L("لا توجد ساعات مسجّلة.","No hours recorded.")}</div>`}
    <div class="cap">${cur.peak?`${L("أعلى طلب:","Peak demand:")} ${cur.peak.day} (${n2(cur.peak.perHour)} ${L("مريض/ساعة)","patients/hour)")}`:""}
    ${cur.low && cur.low!==cur.peak?` · ${L("أدنى طلب:","Lowest demand:")} ${cur.low.day} (${n2(cur.low.perHour)})`:""}</div>
  </div>

  <h2 class="sec">${L("أطباء العيادة","Clinic doctors")}</h2>
  <div class="card"><table>
    <thead><tr><th>${L("الطبيب","Doctor")}</th><th>${L("أيام","Days")}</th><th>${L("حجوزات","Booked")}</th><th>${L("حضور","Attended")}</th><th>${L("مرضى/ساعة","patients/hour")}</th><th>${L("الاستغلال","Utilization")}</th></tr></thead>
    <tbody>${cur.doctors.map(d=>`<tr><td>${esc(d.label)}</td><td class="mono">${n0(d.days)}</td>
      <td class="mono">${n0(d.booked)}</td><td class="mono">${pc(d.attendanceRate)}</td>
      <td class="mono">${n2(d.seenPerHour)}</td><td class="mono">${pc(d.utilization)}</td></tr>`).join("")}</tbody>
  </table></div>

  <h2 class="sec">${L("قراءة HealthIQ","HealthIQ reading")}</h2>
  ${clinicInsight(cur, t)}
  ${alerts.map(alertCard).join("")}`;
}

function clinicInsight(c, t){
  const out = [];
  const gap = (c.utilization!=null && t.utilization!=null) ? c.utilization - t.utilization : null;
  if(gap!=null) out.push({h:L("الموقع مقابل المتوسط العام","Position against the overall average"),
    e:`${L("استغلال","utilization")} ${c.name} ${pc(c.utilization)} ${L("مقابل","vs")} ${pc(t.utilization)} ${L("على مستوى المنشأة، بفارق","facility-wide, a gap of")} ${pc(Math.abs(gap))} ${gap>=0?L("لصالح العيادة","in the clinic's favour"):L("دون المتوسط","below average")}.`,
    c:`${L("المخدومون","Patients seen")} ${n0(c.seen)} ${L("من طاقة","of a capacity of")} ${n0(c.capacity)} ${L("موعد.","appointments.")}`, lv: gap<0?"warn":""});
  if(c.freeSlots) out.push({h:L("الفجوة القابلة للاسترداد","Recoverable gap"),
    e:`${n0(c.freeSlots)} ${L("موعد شاغر يعادل","open appointments, equal to")} ${n1(c.freeSlots*(c.hours&&c.capacity? c.hours/c.capacity:0))} ${L("ساعة غير مستثمرة.","unused hours.")}`,
    c:L("الفجوة تُحسب كطاقة ناقص المحجوز، ولا تشمل الدخول بلا موعد.","The gap is capacity minus booked, and excludes walk-ins."), lv:"key"});
  if(c.peak && c.low && c.peak.day!==c.low.day) out.push({h:L("توزيع الطلب","Demand distribution"),
    e:`${L("الطلب يتركّز يوم","Demand concentrates on")} ${c.peak.day} (${n2(c.peak.perHour)} ${L("مريض/ساعة) وينخفض يوم","patients/hour) and drops on")} ${c.low.day} (${n2(c.low.perHour)}).`,
    c:L("إعادة توزيع الساعات نحو أيام الذروة ترفع الاستغلال دون زيادة الموارد.","Shifting hours toward peak days raises utilization without adding resources.")});
  return out.map(insCard).join("");
}

function pageAsk(recs, sm, t){
  const ex = [L("أي عيادة أقل استغلالًا؟","Which clinic has the lowest utilization?"),
              L("ما أكثر الأيام ازدحامًا؟","Which days are busiest?"),
              L("أي يوم الأقل ازدحامًا؟","Which day is quietest?"),
              L("أي عيادة فيها مواعيد شاغرة أكثر؟","Which clinic has the most open slots?"),
              L("كم ساعة مهدرة؟","How many hours were wasted?"),
              L("أي عيادة أكثر دخولًا بلا موعد؟","Which clinic has the most walk-ins?"),
              L("من أعلى الأطباء إنتاجية؟","Which doctor is most productive?"),
              L("ما نسبة الحضور؟","What is the attendance rate?"),
              L("ما نسبة ملء المواعيد؟","What is the appointment fill rate?"),
              L("ما المتوقع الأسبوع القادم؟","What is expected next week?"),
              L("كم عدد الأطباء والأيام؟","How many doctors and days?"),
              L("ما الذي تغيّر مقارنة بالفترة السابقة؟","What changed versus the previous period?"),
              L("على ماذا نركّز للتحسين؟","What should we focus on improving?"),
              L("ما هو HealthIQ؟","What is HealthIQ?"),
              L("ما الهدف من HealthIQ؟","What is the purpose of HealthIQ?"),
              L("ماذا يحلل HealthIQ؟","What does HealthIQ analyse?"),
              L("ماذا يقدم HealthIQ للإدارة؟","What does HealthIQ offer to management?"),
              L("هل يستخدم HealthIQ الذكاء الاصطناعي؟","Does HealthIQ use artificial intelligence?"),
              L("هل يقيم HealthIQ الأطباء؟","Does HealthIQ evaluate physicians?"),
              L("هل يحتاج HealthIQ إلى بيانات المرضى الشخصية؟","Does HealthIQ need personal patient data?"),
              L("هل يمكن مقارنة العيادات والفترات؟","Can clinics and periods be compared?"),
              L("كيف تعمل التنبيهات الذكية؟","How do smart alerts work?"),
              L("من طوّر HealthIQ؟","Who developed HealthIQ?"),
              L("من هي دينا؟","Who is Dina?"),
              L("ما أبرز مشاريع دينا؟","What are Dina's main projects?"),
              L("ما المجالات التي تهتم بها دينا؟","What fields does Dina focus on?")];
  const seg = (k,v)=> v? `<div class="pev"><span class="k">${k}</span><span class="v">${esc(v)}</span></div>`:"";
  const log = state.askLog.map(x=>`
    <div class="qa">
      <div class="qq">${esc(x.q)}</div>
      <div class="qa-a">${esc(x.a)}</div>
      ${seg(L("الدليل","Evidence"), x.ev)}
      ${x.e? `<details class="qa-e"><summary>البيانات</summary>${x.e}</details>`:""}
      ${seg(L("القراءة","Interpretation"), x.ip)}
    </div>`).join("");

  return `
  <div class="banner"><div class="q">${L("اسأل HealthIQ","Ask HealthIQ")}</div>
    </div>

  <div class="card askbox">
    <div class="askrow">
      <input id="askQ" type="text" placeholder="${L('مثال: أي عيادة أقل استغلالًا؟','Example: which clinic has the lowest utilization?')}" value="${esc(state.askDraft||"")}">
      <button class="ghost primary" id="askGo">${L("اسأل","Ask")}</button>
    </div>
    <div class="askchips">${ex.map(e=>`<button class="chipbtn" data-q="${esc(e)}">${esc(e)}</button>`).join("")}</div>
  </div>

  ${log || `<div class="cs" style="margin-top:14px">${L("لا توجد أسئلة بعد.","No questions yet.")}</div>`}`;
}

/* ---------- لوحة المسؤول ---------- */
const SECTION_LIST = () => PAGES_BASE();

function pageAdmin(){
  if(!isAdmin()) return `<div class="card">${L("هذه الصفحة مخصّصة للمسؤول.","This page is restricted to the administrator.")}</div>`;
  const c = CFG;
  return `
  <div class="banner"><div class="q">APPEARANCE STUDIO · ${L("استوديو المظهر","Appearance Studio")}</div>
    </div>

  <div class="grid g2">
    <div class="card">
      <div class="ct">${L("الهوية والنصوص","Identity and text")}</div>
      <div class="cs">${L("الاسم والوصف والعنوان الظاهر في الرأس.","Name, tagline and the heading shown in the header.")}</div>
      <div class="frow"><label>${L("اسم المنصة","Platform name")}</label><input id="cfBrand" value="${esc(c.brand)}"></div>
      <div class="frow"><label>${L("الوصف","Tagline")}</label><input id="cfTag" value="${esc(c.tagline)}"></div>
      <div class="frow"><label>${L("العنوان العربي","Arabic heading")}</label><input id="cfTitle" value="${esc(c.titleAr)}"></div>
    </div>

    <div class="card">
      <div class="ct">${L("الألوان","Colours")}</div>
      <div class="cs">${L("تُطبَّق على الرأس والرسوم والعناصر التفاعلية.","Applied to the header, charts and interactive elements.")}</div>
      <div class="frow"><label>${L("اللون الأساسي","Primary colour")}</label><input type="color" id="cfAccent" value="${c.accent}"></div>
      <div class="frow"><label>${L("الكحلي","Navy")}</label><input type="color" id="cfNavy" value="${c.navy}"></div>
      <div class="frow"><label>${L("السماوي","Azure")}</label><input type="color" id="cfAzure" value="${c.azure}"></div>
    </div>

    <div class="card">
      <div class="ct">${L("الصور","Images")}</div>
      <div class="cs">${L("الشعار وصورة الواجهة وخلفية اللوحة. يُفضّل صور خفيفة الحجم.","Logo, hero image and dashboard background. Light image files are preferred.")}</div>
      <div class="frow"><label>${L("الشعار","Logo")}</label><input type="file" id="cfLogoF" accept="image/*"></div>
      <div class="frow"><label>${L("صورة الواجهة","Hero image")}</label><input type="file" id="cfHeroF" accept="image/*"></div>
      <div class="frow"><label>${L("خلفية الصفحة","Page background")}</label><input type="file" id="cfBgF" accept="image/*"></div>
      <div class="frow"><label>${L("شفافية الخلفية","Background opacity")}</label>
        <input type="range" class="slider" id="cfBgO" min="0" max="40" value="${c.bgOpacity}"></div>
      <div class="frow"><button class="ghost" id="cfClearImg">${L("إزالة","Remove")} ${L("الصور","Images")}</button></div>
    </div>

    <div class="card">
      <div class="ct">${L("إعدادات التحليل","Analysis settings")}</div>
      <div class="cs">${L("الحدود التي تُطلق التنبيهات الذكية.","Thresholds that trigger the smart alerts.")}</div>
      <div class="frow"><label>${L("حد الاستغلال المنخفض ٪","Low utilization threshold %")}</label><input type="number" id="cfUtil" value="${c.ai.utilLow}" min="10" max="95"></div>
      <div class="frow"><label>${L("حد عدم الحضور ٪","No-show threshold %")}</label><input type="number" id="cfNS" value="${c.ai.noShowHigh}" min="5" max="90"></div>
      <div class="frow"><label>${L("حد ملء المواعيد ٪","Fill-rate threshold %")}</label><input type="number" id="cfFill" value="${c.ai.fillLow}" min="10" max="95"></div>
      <div class="frow"><label>${L("تفعيل التوقّع","Enable forecasting")}</label><input type="checkbox" id="cfFc" ${c.ai.forecast?"checked":""}></div>
      <div class="frow"><label>${L("مدى التوقّع (أسابيع)","Forecast horizon (weeks)")}</label><input type="number" id="cfHz" value="${c.ai.horizon}" min="1" max="4"></div>
    </div>
  </div>

  <h2 class="sec">${L("الأقسام الظاهرة للمستخدم","Sections visible to users")}</h2>
  <div class="card"><div class="secgrid">
    ${SECTION_LIST().map(([k,v])=>`<label class="secitem">
      <input type="checkbox" data-sec="${k}" ${CFG.hidden.includes(k)?"":"checked"}> ${esc(v)}</label>`).join("")}
  </div><div class="cap">${L("الأقسام المخفية تختفي من التنقّل ولا يمكن للمستخدم فتحها.","Hidden sections disappear from navigation and users cannot open them.")}</div></div>

  <h2 class="sec">${L("كلمة مرور المسؤول","Administrator password")}</h2>
  <div class="card">
    <div class="frow"><label>${L("كلمة مرور جديدة","New password")}</label><input type="password" id="cfPw" placeholder=L("اتركيها فارغة لعدم التغيير","Leave empty to keep the current one")></div>
    <div class="cap">${L("تُحفظ بصيغة مشفّرة (SHA-256) داخل إعدادات المتصفح، ولا تُكتب في الملف.","Stored hashed (SHA-256) in browser settings, never written into the file.")}</div>
  </div>

  <div class="adminbar">
