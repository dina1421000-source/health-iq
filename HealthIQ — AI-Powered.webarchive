<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%2308152C'/%3E%3Cstop offset='1' stop-color='%2335A3E0'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='32' height='32' rx='8' fill='url(%23g)'/%3E%3Cg stroke='white' stroke-width='2.8' stroke-linecap='round'%3E%3Cpath d='M9 24v-6'/%3E%3Cpath d='M16 24V12'/%3E%3Cpath d='M23 24v-9'/%3E%3C/g%3E%3Ccircle cx='16' cy='7' r='2.2' fill='white'/%3E%3C/svg%3E">
<title>HealthIQ — AI-Powered Healthcare Analytics</title>
<style>
:root{
  --ink:#0D1B2E; --muted:#667A93; --line:#E4E7EC; --bg:#EEF1F5; --card:#FFFFFF;
  --teal:#1668B3; --terra:#D4531D; --ochre:#0E7C91; --sage:#1B8A63; --soft:#EAF1FA;
  --navy:#0B1F3D; --azure:#35A3E0;
  --hero:linear-gradient(115deg,#08152C 0%,#0F3466 42%,#1D6FB8 76%,#35A3E0 100%);
  --shadow:0 1px 2px rgba(13,27,46,.05), 0 8px 22px rgba(13,27,46,.05);
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);
  font-family:"IBM Plex Sans Arabic","Segoe UI",Tahoma,sans-serif;font-size:14px;line-height:1.7}
.mono{font-family:"IBM Plex Mono",ui-monospace,Menlo,monospace;font-variant-numeric:tabular-nums}
header{background:var(--card);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20}
.hwrap{max-width:1240px;margin:0 auto;padding:14px 20px 0}
.brand{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
.brand h1{font-size:19px;margin:0;font-weight:700;letter-spacing:-.01em}
.brand .sub{font-size:12px;color:var(--muted)}
nav{display:flex;gap:2px;overflow-x:auto;margin-top:12px;scrollbar-width:none}
nav::-webkit-scrollbar{display:none}
nav button{background:none;border:0;border-bottom:2px solid transparent;padding:9px 13px;
  font:inherit;font-size:13.5px;color:var(--muted);cursor:pointer;white-space:nowrap}
nav button:hover{color:var(--ink)}
nav button.on{color:var(--ink);font-weight:600;border-bottom-color:var(--teal)}
main{max-width:1240px;margin:0 auto;padding:22px 20px 70px}
.filters{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:22px;
  background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 14px}
.filters label{font-size:12px;color:var(--muted);margin-inline-end:6px}
select,input[type=date]{font:inherit;font-size:13px;padding:6px 9px;border:1px solid var(--line);
  border-radius:8px;background:#fff;color:var(--ink)}
.grid{display:grid;gap:14px}
.g4{grid-template-columns:repeat(4,1fr)} .g3{grid-template-columns:repeat(3,1fr)}
.g2{grid-template-columns:repeat(2,1fr)} .g23{grid-template-columns:1.35fr 1fr}
@media(max-width:900px){.g4,.g3,.g2,.g23{grid-template-columns:1fr 1fr}}
@media(max-width:620px){.g4,.g3,.g2,.g23{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px 18px}
.kpi .l{font-size:12px;color:var(--muted);margin-bottom:8px}
.kpi .v{font-size:27px;font-weight:600;line-height:1.1}
.kpi .n{font-size:11.5px;color:var(--muted);margin-top:7px}
.kpi.alert{border-color:#F3CDBB;background:#FEF5F0}
.kpi.alert .v{color:var(--terra)}
h2.sec{font-size:16px;margin:28px 0 12px;font-weight:600}
.ct{font-size:14px;font-weight:600;margin-bottom:2px}
.cs{font-size:11.5px;color:var(--muted);margin-bottom:10px}
.cap{font-size:11.5px;color:var(--muted);margin-top:8px}
.ins{background:var(--card);border:1px solid var(--line);border-right:3px solid var(--teal);
  border-radius:10px;padding:14px 16px;margin-bottom:11px}
.ins.warn{border-right-color:var(--terra)} .ins.key{border-right-color:var(--ochre)}
.ins .h{font-weight:600;font-size:14.5px;margin-bottom:6px}
.ins .e{font-size:13px;color:#33455C}
.ins .c{font-size:12px;color:var(--muted);margin-top:8px;padding-top:8px;border-top:1px dashed var(--line)}
.rec{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:15px 17px;margin-bottom:11px}
.rec .a{font-weight:600;font-size:14.5px;margin-bottom:9px}
.rec .row{font-size:12.8px}
.rec .k{color:var(--muted);display:inline-block;min-width:74px}
.assume{background:#FFF9EC;border:1px solid #F0DFBB;border-radius:9px;padding:11px 14px;
  font-size:12.4px;color:#7A5D24}
.mock{background:#F1F4F9;border:1px solid #DCE4EF;border-radius:9px;padding:11px 14px;
  font-size:12.4px;color:#46586F}
.pill{display:inline-block;font-size:11px;padding:2px 9px;border-radius:20px;border:1px solid var(--line);color:var(--muted)}
.pill.up{background:#E8F5EF;border-color:#C4E4D5;color:#16714D}
.pill.dn{background:#FDF0E9;border-color:#F3CDBB;color:var(--terra)}
.pill.mid{background:#EFF3F8}
table{width:100%;border-collapse:collapse;font-size:12.8px}
th{text-align:right;font-weight:600;color:var(--muted);font-size:11.5px;padding:8px 9px;
  border-bottom:1px solid var(--line);white-space:nowrap}
td{padding:8px 9px;border-bottom:1px solid #EEF2F8}
tbody tr:hover{background:#F7FAFE}
.slider{width:100%;accent-color:var(--teal)}
.sw{display:inline-block;width:9px;height:9px;border-radius:2px;margin-inline-end:5px}
svg text{font-family:inherit}
.hide{display:none}
button.ghost{font:inherit;font-size:12.5px;padding:6px 12px;border:1px solid var(--line);
  border-radius:8px;background:#fff;cursor:pointer;color:var(--ink)}
button.ghost:hover{background:var(--soft)}
footer{max-width:1240px;margin:0 auto;padding:0 20px 40px;font-size:11.5px;color:var(--muted)}
.sig{direction:ltr;text-align:center;padding:18px 20px 16px;margin-top:24px;
  background:var(--hero);border:0;border-radius:18px;box-shadow:var(--shadow)}
.sig-mark{width:18px;height:1px;background:var(--azure);margin:0 auto 11px;opacity:.9}
.sig-top{font-size:9px;letter-spacing:.11em;text-transform:uppercase;
  color:rgba(255,255,255,.66);font-weight:500}
.sig-by{font-size:9.5px;letter-spacing:.05em;color:rgba(255,255,255,.6);margin-top:11px}
.sig-name{position:relative;display:inline-block;margin-top:3px;padding-bottom:8px;
  font-family:"Segoe UI","IBM Plex Sans Arabic",system-ui,sans-serif;
  font-size:15px;font-weight:500;letter-spacing:.13em;text-indent:.13em;line-height:1.25;color:#fff}
.sig-name::after{content:"";position:absolute;left:50%;bottom:0;transform:translateX(-50%);
  width:18px;height:1px;background:var(--azure)}
.sig-sub{font-size:9.5px;letter-spacing:.09em;color:var(--azure);margin-top:7px}
@media(max-width:520px){
  .sig{padding:16px 14px 14px}
  .sig-top{letter-spacing:.07em;font-size:8.5px}
  .sig-name{font-size:14px;letter-spacing:.12em;text-indent:.12em}
}
.kpi .x{font-size:11px;color:var(--muted);margin-top:6px;padding-top:6px;border-top:1px dashed var(--line);line-height:1.55}
.kpi.big .v{font-size:32px}
.chip{display:inline-block;font-size:10.5px;padding:2px 8px;border-radius:20px;margin-inline-end:5px;
  border:1px solid var(--line);color:var(--muted);white-space:nowrap}
.chip.up{background:#E8F5EF;border-color:#C4E4D5;color:#16714D}
.chip.dn{background:#FDF0E9;border-color:#F3CDBB;color:var(--terra)}
.chip.mid{background:#EFF3F8}
.act{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:0;margin-bottom:12px;overflow:hidden}
.act .top{padding:13px 16px;border-bottom:1px solid var(--line);display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.act .num{width:24px;height:24px;border-radius:50%;background:var(--soft);display:inline-flex;
  align-items:center;justify-content:center;font-size:12px;font-weight:700;flex:none}
.act .ttl{font-weight:600;font-size:14.5px}
.act .body{display:grid;grid-template-columns:repeat(4,1fr)}
@media(max-width:860px){.act .body{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.act .body{grid-template-columns:1fr}}
.act .b{padding:13px 16px;border-inline-start:1px solid var(--line);font-size:12.6px}
.act .b:first-child{border-inline-start:0}
.act .b .lab{font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:5px}
.act.hi{border-color:#F3CDBB}
.act.hi .num{background:#FDF0E9;color:var(--terra)}
.banner{background:linear-gradient(90deg,#EAF2FB,#F2F6FB);border:1px solid var(--line);
  border-radius:12px;padding:14px 17px;margin-bottom:16px}
.banner .q{font-size:12px;color:var(--muted);margin-bottom:4px}
.banner .a{font-size:14.5px;line-height:1.8}
.tag{display:inline-block;font-size:10.5px;padding:3px 9px;border-radius:6px;background:var(--soft);
  color:var(--muted);border:1px solid var(--line)}
tr.click{cursor:pointer}
tr.click.on{background:#EAF2FB}
.split{display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid var(--line);border-radius:10px;overflow:hidden}
@media(max-width:620px){.split{grid-template-columns:1fr}}
.split>div{padding:14px 16px}
.split>div+div{border-inline-start:1px solid var(--line)}
@media(max-width:620px){.split>div+div{border-inline-start:0;border-top:1px solid var(--line)}}
.split .n{font-size:24px;font-weight:600;font-family:"IBM Plex Mono",monospace}
.split .l{font-size:12px;color:var(--muted)}
.split .s{font-size:11.5px;color:var(--muted);margin-top:6px}

/* ================= هيكل التطبيق ================= */
:root{--tabh:62px}
html{-webkit-text-size-adjust:100%}
body{-webkit-tap-highlight-color:transparent}

header{background:var(--hero);border-bottom:0;padding-top:env(safe-area-inset-top);
  box-shadow:0 6px 24px rgba(8,21,44,.22)}
.hwrap{padding:16px 20px 0}
.appbar{display:flex;align-items:center;gap:12px}
.mark{width:38px;height:38px;border-radius:12px;flex:none;display:grid;place-items:center;
  background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.26)}
.mark svg{width:20px;height:20px}
.titles{min-width:0;flex:1}
.titles h1{font-size:16.5px;margin:0;font-weight:700;letter-spacing:-.01em;color:#fff;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.titles .sub{display:block;font-size:10.5px;margin-top:2px;letter-spacing:.05em;
  color:rgba(255,255,255,.72);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.iconbtn{flex:none;width:38px;height:38px;border-radius:12px;padding:0;cursor:pointer;
  border:1px solid rgba(255,255,255,.26);background:rgba(255,255,255,.12);color:#fff;
  display:none;place-items:center}
.iconbtn svg{width:17px;height:17px}
.iconbtn.on{background:#fff;color:var(--teal);border-color:#fff}

header nav{margin-top:14px;padding-bottom:2px}
header nav button{color:rgba(255,255,255,.68);border-bottom-width:2px;font-size:13.5px}
header nav button:hover{color:#fff}
header nav button.on{color:#fff;font-weight:600;border-bottom-color:#fff}

.card{border-radius:14px;box-shadow:var(--shadow)}
.filters{border-radius:14px;box-shadow:var(--shadow)}
.kpi .v{color:var(--navy)}
.ins,.rec,.act,.banner{box-shadow:var(--shadow)}

.tabbar{display:none;position:fixed;inset-inline:0;bottom:0;z-index:30;
  background:rgba(255,255,255,.95);backdrop-filter:saturate(1.6) blur(14px);
  border-top:1px solid var(--line);box-shadow:0 -6px 20px rgba(13,27,46,.06);
  padding-bottom:env(safe-area-inset-bottom)}
.tabbar .row{display:flex;height:var(--tabh)}
.tabbar button{flex:1;background:none;border:0;font:inherit;cursor:pointer;color:var(--muted);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;padding:0;
  position:relative;transition:transform .12s ease,color .12s ease}
.tabbar button svg{width:21px;height:21px}
.tabbar button span{font-size:10.5px;letter-spacing:-.01em}
.tabbar button.on{color:var(--teal)}
.tabbar button.on span{font-weight:600}
.tabbar button.on::before{content:"";position:absolute;top:0;width:26px;height:3px;
  border-radius:0 0 3px 3px;background:var(--teal)}
.tabbar button:active{transform:scale(.93)}

.scrim{position:fixed;inset:0;background:rgba(8,21,44,.42);z-index:40;
  opacity:0;transition:opacity .22s ease}
.scrim.show{opacity:1}
.sheet{position:fixed;inset-inline:0;bottom:0;z-index:50;background:var(--card);
  border-top-left-radius:22px;border-top-right-radius:22px;
  box-shadow:0 -14px 44px rgba(8,21,44,.24);
  max-height:82vh;display:flex;flex-direction:column;
  padding-bottom:env(safe-area-inset-bottom);
  transform:translateY(101%);transition:transform .26s cubic-bezier(.22,.9,.3,1)}
.sheet.show{transform:translateY(0)}
.sheet[hidden],.scrim[hidden]{display:none}
.grab{width:38px;height:4px;border-radius:3px;background:var(--line);margin:9px auto 2px;flex:none}
.sheet-head{display:flex;align-items:center;padding:8px 18px 12px;flex:none}
.sheet-head .t{font-size:14.5px;font-weight:600}
.sheet-head button{margin-inline-start:auto;background:none;border:0;font:inherit;font-size:13px;
  color:var(--teal);cursor:pointer;padding:4px 2px}
.sheet-body{overflow-y:auto;padding:0 14px 18px;-webkit-overflow-scrolling:touch}
.sheet-body .filters{margin-bottom:0;box-shadow:none}
.pagelist{display:flex;flex-direction:column;gap:2px}
.pagelist button{display:flex;align-items:center;gap:10px;width:100%;text-align:start;
  background:none;border:0;font:inherit;font-size:14px;color:var(--ink);cursor:pointer;
  padding:13px 12px;border-radius:11px}
.pagelist button .dot{width:6px;height:6px;border-radius:50%;background:transparent;flex:none}
.pagelist button.on{background:#EAF2FB;color:var(--teal);font-weight:600}
.pagelist button.on .dot{background:var(--teal)}

@media(max-width:820px){
  .hwrap{padding:10px 16px 0}
  header nav{display:none}
  .iconbtn{display:grid}
  .tabbar{display:block}
  main{padding:16px 16px calc(var(--tabh) + 26px)}
  footer{padding:0 16px calc(var(--tabh) + 30px)}
  .card{padding:15px 16px}
}
main > #mainFilters{display:none}
.sheet-body > #mainFilters{display:flex}
.iconbtn{display:grid}
.iconbtn .dot{position:absolute;top:6px;inset-inline-end:6px;width:6px;height:6px;border-radius:50%;
  background:#fff;box-shadow:0 0 0 2px rgba(11,31,61,.35)}
.iconbtn{position:relative}
@media(prefers-reduced-motion:reduce){
  .sheet,.scrim,.tabbar button{transition:none}
}
/* ================= HealthIQ ================= */
#app[hidden]{display:none}
#bgLayer{position:fixed;inset:0;z-index:-1;background-size:cover;background-position:center;
  opacity:0;pointer-events:none;transition:opacity .3s ease}

/* شاشة الدخول */
#gate{position:fixed;inset:0;z-index:60;display:grid;place-items:center;padding:24px;
  background:var(--hero)}
#gate[hidden]{display:none}
.gatecard{width:100%;max-width:340px;text-align:center;color:#fff}
.gatemark{width:56px;height:56px;border-radius:16px;margin:0 auto 18px;display:grid;place-items:center;
  background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.28)}
.gatemark svg{width:28px;height:28px}
.gatecard h1{font-size:30px;margin:0;font-weight:700;letter-spacing:-.02em}
.gatecard p{margin:6px 0 26px;font-size:12px;letter-spacing:.06em;color:rgba(255,255,255,.72)}
.gbtn{display:block;width:100%;margin-bottom:9px;padding:13px;border-radius:12px;font:inherit;
  font-size:14px;cursor:pointer;border:1px solid rgba(255,255,255,.3);
  background:rgba(255,255,255,.1);color:#fff}
.gbtn.primary{background:#fff;color:var(--navy);border-color:#fff;font-weight:600}
#gateAdmin{margin-top:14px}
#gateAdmin[hidden]{display:none}
#gatePw{width:100%;padding:12px;border-radius:12px;border:1px solid rgba(255,255,255,.3);
  background:rgba(255,255,255,.1);color:#fff;font:inherit;font-size:14px;margin-bottom:9px;
  text-align:center}
#gatePw::placeholder{color:rgba(255,255,255,.55)}
#gateErr{font-size:12px;color:#FFC9B3;min-height:18px;margin-top:6px}
.gatefoot{margin-top:22px;font-size:11px;color:rgba(255,255,255,.55);line-height:1.7}

/* الرأس */
.roletag{flex:none;font-size:10.5px;padding:4px 10px;border-radius:20px;color:#fff;
  background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.26)}
.roletag.admin{background:#fff;color:var(--navy);font-weight:600;border-color:#fff}
.iconbtn.always{display:grid}
#brandLogo img{width:100%;height:100%;object-fit:contain;border-radius:9px}
.pagehead{font-size:13px;font-weight:500;color:var(--muted);margin:0 0 14px}

/* بطاقات الذكاء */
.ailist{margin:8px 0 0;padding-inline-start:18px;font-size:13px;line-height:1.9}
.ailist.good li::marker{color:var(--sage)}
.ailist.bad li::marker{color:var(--terra)}
.alert-card{background:var(--card);border:1px solid var(--line);border-radius:12px;
  padding:14px 16px;margin-bottom:11px;border-inline-start:3px solid var(--muted);box-shadow:var(--shadow)}
.alert-card.crit{border-inline-start-color:var(--terra)}
.alert-card.warn{border-inline-start-color:#D9A21B}
.alert-card.info{border-inline-start-color:var(--teal)}
.alert-card .ah{display:flex;align-items:center;gap:8px;margin-bottom:6px;flex-wrap:wrap}
.alert-card .at{font-weight:600;font-size:14.5px}
.alert-card .ab{font-size:13px;color:#33455C}
.alert-card .ae{font-size:11.5px;color:var(--muted);margin-top:6px}
.alert-card .ar{font-size:13px;margin-top:10px;padding-top:9px;border-top:1px dashed var(--line)}
.alert-card .ar .k{display:inline-block;font-size:10.5px;font-weight:700;color:var(--teal);
  margin-inline-end:7px}

/* ما الذي تغيّر */
.chg{display:flex;align-items:center;gap:10px;margin-bottom:9px}
.chg .cl{flex:0 0 40%;font-size:12.8px}
.chg .cbar{flex:1;height:8px;border-radius:5px;background:var(--soft);overflow:hidden}
.chg .cbar span{display:block;height:100%;border-radius:5px;background:var(--muted)}
.chg .cbar span.up{background:var(--sage)} .chg .cbar span.dn{background:var(--terra)}
.chg .cv{flex:0 0 74px;text-align:end;font-size:12px;font-variant-numeric:tabular-nums}
.chg .cv.up{color:var(--sage)} .chg .cv.dn{color:var(--terra)} .chg .cv.mid{color:var(--muted)}

/* اسأل */
.askbox{margin-bottom:14px}
.askrow{display:flex;gap:8px}
.askrow input{flex:1;font:inherit;font-size:14px;padding:11px 13px;border:1px solid var(--line);
  border-radius:11px;background:#fff;color:var(--ink)}
.askrow input:focus{outline:2px solid var(--teal);outline-offset:-1px}
button.ghost.primary{background:var(--teal);color:#fff;border-color:var(--teal);font-weight:600}
button.ghost.primary:hover{filter:brightness(1.08);background:var(--teal)}
button.ghost.danger{color:var(--terra);border-color:#F3CDBB}
.askchips{display:flex;flex-wrap:wrap;gap:6px;margin-top:11px}
.chipbtn{font:inherit;font-size:11.5px;padding:6px 11px;border-radius:20px;cursor:pointer;
  border:1px solid var(--line);background:var(--soft);color:var(--muted)}
.chipbtn:hover{color:var(--teal);border-color:var(--teal)}
.qa{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px 16px;
  margin-bottom:10px;box-shadow:var(--shadow)}
.qa .qq{font-size:12.5px;color:var(--muted);margin-bottom:7px}
.qa .qa-a{font-size:14px;line-height:1.85}
.qa-e{margin-top:10px}
.qa-e summary{font-size:12px;color:var(--teal);cursor:pointer}
.qa-e table{margin-top:9px}

/* لوحة المسؤول */
.frow{display:flex;align-items:center;gap:10px;margin-top:10px;flex-wrap:wrap}
.frow label{flex:0 0 40%;font-size:12.5px;color:var(--muted)}
.frow input[type=text],.frow input:not([type]),.frow input[type=password],.frow input[type=number]{
  flex:1;min-width:130px;font:inherit;font-size:13px;padding:8px 10px;border:1px solid var(--line);
  border-radius:9px;background:#fff;color:var(--ink)}
.frow input[type=color]{width:52px;height:32px;padding:2px;border:1px solid var(--line);
  border-radius:8px;background:#fff;cursor:pointer}
.frow input[type=range]{flex:1}
.secgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
@media(max-width:700px){.secgrid{grid-template-columns:1fr 1fr}}
.secitem{display:flex;align-items:center;gap:8px;font-size:12.8px;padding:8px 10px;
  border:1px solid var(--line);border-radius:9px;cursor:pointer}
.adminbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:18px}
.fileLbl{cursor:pointer;display:inline-flex;align-items:center}
.cfmsg{font-size:12px}
.cfmsg.ok{color:var(--sage)} .cfmsg.err{color:var(--terra)}

/* ================= الواجهة الرئيسية ================= */
.hero{position:relative;overflow:hidden;border-radius:20px;padding:30px 24px 26px;margin-bottom:16px;
  background:var(--hero);background-size:cover;background-position:center;color:#fff;
  box-shadow:0 10px 34px rgba(8,21,44,.2)}
.hbrand{font-size:26px;font-weight:700;letter-spacing:-.02em}
.htag{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.72);margin-top:3px}
.hwelcome{font-size:17px;font-weight:600;margin:20px 0 4px}
.hsub{margin:0;font-size:13px;color:rgba(255,255,255,.78)}
.hflow{display:flex;align-items:center;flex-wrap:wrap;gap:6px;margin-top:20px}
.hstep{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;padding:5px 11px;border-radius:20px;
  background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2)}
.hstep b{font-size:9.5px;width:15px;height:15px;border-radius:50%;background:rgba(255,255,255,.24);
  display:grid;place-items:center;font-weight:700}
.harrow{color:rgba(255,255,255,.45);font-size:12px}

/* AI Spotlight */
.spot{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px 20px;
  margin-bottom:6px;border-inline-start:4px solid var(--teal);box-shadow:var(--shadow)}
.spot.crit{border-inline-start-color:var(--terra)}
.spot.warn{border-inline-start-color:#D9A21B}
.sph{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:9px}
.spk{font-size:10px;font-weight:700;letter-spacing:.13em;color:#fff;background:var(--teal);
  padding:4px 9px;border-radius:6px}
.spl{font-size:11.5px;color:var(--muted)}
.spt{font-size:16px;font-weight:600;line-height:1.65}
.spn{font-size:12.5px;color:var(--muted);margin-top:6px;font-variant-numeric:tabular-nums}
.spw{font-size:13px;margin-top:11px;padding-top:10px;border-top:1px dashed var(--line);line-height:1.85}
.spw .k{font-size:10.5px;font-weight:700;color:var(--teal);margin-inline-end:7px}
.spot button{margin-top:12px}

/* بطاقات المؤشرات التفاعلية */
.kpibtn{display:flex;flex-direction:column;align-items:flex-start;gap:0;text-align:start;width:100%;
  font:inherit;cursor:pointer;background:var(--card);border:1px solid var(--line);border-radius:14px;
  padding:16px 17px;color:var(--ink);box-shadow:var(--shadow);
  transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease}
.kpibtn:hover{transform:translateY(-2px);box-shadow:0 10px 26px rgba(13,27,46,.1);border-color:var(--teal)}
.kpibtn.on{border-color:var(--teal);box-shadow:0 0 0 2px rgba(22,104,179,.14),var(--shadow)}
.kpibtn.alert{border-color:#F3CDBB;background:#FEF5F0}
.kpibtn .ki{width:32px;height:32px;border-radius:9px;display:grid;place-items:center;
  background:var(--soft);color:var(--teal);margin-bottom:11px}
.kpibtn.alert .ki{background:#FDF0E9;color:var(--terra)}
.kpibtn .ki svg{width:17px;height:17px}
.kpibtn .kl{font-size:12px;color:var(--muted)}
.kpibtn .kv{font-size:27px;font-weight:600;line-height:1.15;margin-top:5px;color:var(--navy)}
.kpibtn.alert .kv{color:var(--terra)}
.kpibtn .kn{font-size:11.5px;color:var(--muted);margin-top:6px}
.kpibtn .kmore{font-size:11px;color:var(--teal);margin-top:10px}
.kpanel{margin-top:14px;animation:rise .2s ease both}
@keyframes rise{from{opacity:0;transform:translateY(-5px)}to{opacity:1;transform:none}}

.navcard{display:flex;flex-direction:column;align-items:flex-start;gap:4px;text-align:start;width:100%;
  font:inherit;cursor:pointer;background:var(--card);border:1px solid var(--line);border-radius:14px;
  padding:15px 17px;color:var(--ink);box-shadow:var(--shadow);
  transition:transform .16s ease,border-color .16s ease}
.navcard:hover{transform:translateY(-2px);border-color:var(--teal)}
.navcard .nt{font-size:14px;font-weight:600}
.navcard .ns{font-size:11.5px;color:var(--muted)}

/* أولويات التنبيه */
.prio{display:inline-block;font-size:10.5px;font-weight:700;padding:3px 10px;border-radius:6px;
  letter-spacing:.02em}
.prio.hi{background:#FDF0E9;color:var(--terra);border:1px solid #F3CDBB}
.prio.md{background:#FFF7EC;color:#8A6410;border:1px solid #F0DFBB}
.prio.lo{background:var(--soft);color:var(--teal);border:1px solid #CFE0F5}
.prioline{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:12px}
.pev{display:flex;gap:10px;font-size:13px;margin-top:8px;line-height:1.8}
.pev .k{flex:0 0 58px;font-size:10.5px;font-weight:700;color:var(--muted);padding-top:4px}
.pev.rec{margin-top:11px;padding-top:10px;border-top:1px dashed var(--line)}
.pev.rec .k{color:var(--teal)}

/* سجل العيادات */
.exnote{background:#FFF7EC;border:1px solid #F0DFBB;border-radius:10px;padding:11px 14px;
  font-size:12.4px;color:#7A5D24;margin-top:14px;line-height:1.8}
.exnote .k{display:inline-block;font-weight:700;margin-inline-end:7px}
.clinic-row{display:flex;gap:13px;background:var(--card);border:1px solid var(--line);
  border-radius:12px;padding:14px 16px;margin-bottom:10px;box-shadow:var(--shadow)}
.clinic-row.ex{background:#FBFCFE}
.clinic-row .cn{flex:none;width:44px;height:44px;border-radius:11px;display:grid;place-items:center;
  background:var(--soft);color:var(--teal);font-weight:700;font-size:15px;
  font-variant-numeric:tabular-nums}
.clinic-row.ex .cn{background:#EFF3F8;color:var(--muted)}
.clinic-row .cbody{flex:1;min-width:0}
.ctop{display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.ctitle{font-weight:600;font-size:14.5px}
.cmeta{font-size:12px;color:var(--muted);margin-top:3px}
tr.dim td{color:var(--muted)}
.empty{text-align:center;padding:28px 20px}
.empty .ct{font-size:15px;margin-bottom:8px}
.empty .cs{max-width:520px;margin:0 auto 8px;line-height:1.9}
.csvbox{width:100%;font:inherit;font-size:12.5px;line-height:1.8;padding:11px 13px;margin-top:10px;
  border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink);resize:vertical;
  font-family:"IBM Plex Mono",ui-monospace,monospace;direction:ltr;text-align:left}
code{font-family:"IBM Plex Mono",ui-monospace,monospace;font-size:11.5px;background:var(--soft);
  padding:2px 6px;border-radius:5px;direction:ltr;display:inline-block}

@media(prefers-reduced-motion:reduce){
  .kpibtn,.navcard,.kpanel{transition:none;animation:none}
}

.progress{display:flex;align-items:flex-start;gap:11px;background:#E8F5EF;border:1px solid #C4E4D5;
  border-radius:12px;padding:13px 16px;margin-top:14px;animation:rise .25s ease both}
.progress .pi{flex:none;width:26px;height:26px;border-radius:8px;background:var(--sage);color:#fff;
  display:grid;place-items:center;font-size:14px}
.progress .pt{font-size:13px;line-height:1.8;color:#16714D}
.progress .pt b{display:block;font-size:13.5px}
svg{animation:fadeIn .28s ease both}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.card,.alert-card,.qa,.clinic-row{animation:rise .22s ease both}
@media(prefers-reduced-motion:reduce){
  svg,.card,.alert-card,.qa,.clinic-row,.progress{animation:none}
}

.iconbtn.lang{width:auto;padding:0 11px;font-size:11.5px;font-weight:700;letter-spacing:.04em}
.glang{margin-top:14px;background:none;border:0;font:inherit;font-size:12px;cursor:pointer;
  color:rgba(255,255,255,.7);text-decoration:underline;text-underline-offset:3px}
html[dir=ltr] .mono,html[dir=ltr] .kv{direction:ltr}
html[dir=ltr] .sig{direction:ltr}

#paneUser[hidden],#paneReq[hidden],#paneSuper[hidden],#paneChoose[hidden]{display:none}
.gatecard input{width:100%;padding:12px;border-radius:12px;border:1px solid rgba(255,255,255,.3);
  background:rgba(255,255,255,.1);color:#fff;font:inherit;font-size:14px;margin-bottom:9px;
  text-align:center}
.gatecard input::placeholder{color:rgba(255,255,255,.55)}
.gbtn.ghosty{background:none;border-color:rgba(255,255,255,.22);color:rgba(255,255,255,.8);font-size:13px}
.glink{background:none;border:0;font:inherit;font-size:12px;cursor:pointer;margin-top:8px;
  color:rgba(255,255,255,.65);text-decoration:underline;text-underline-offset:3px}
.gmsg{font-size:12px;min-height:18px;margin-top:6px;line-height:1.7}
.gmsg.err{color:#FFC9B3} .gmsg.ok{color:#A8E6C6}
.prio.ok{background:#E8F5EF;color:#16714D;border:1px solid #C4E4D5}
.acts{white-space:nowrap}
.mini{font:inherit;font-size:11.5px;padding:5px 10px;border-radius:8px;cursor:pointer;
  border:1px solid var(--line);background:#fff;color:var(--ink);margin-inline-end:5px}
.mini.ok{border-color:#C4E4D5;color:#16714D;background:#E8F5EF}
.mini.no{border-color:#F3CDBB;color:var(--terra);background:#FDF0E9}
.mini:hover{filter:brightness(.97)}
td.dim{color:var(--muted);font-size:11.5px}

.alertrow{padding:12px 0;border-bottom:1px solid var(--line)}
.alertrow:last-of-type{border-bottom:0}
.alerthd{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:6px}
.alertev{font-size:12.5px;color:var(--muted);margin-bottom:4px}
#nav button,#tabrow button{position:relative}
.pdot{position:absolute;top:4px;inset-inline-end:14px;min-width:17px;height:17px;line-height:17px;
  padding:0 4px;border-radius:9px;background:#D4531D;color:#fff;font-size:11px;font-weight:700;text-align:center}
.pendstrip{display:flex;align-items:center;gap:10px;width:100%;margin:0 0 14px;padding:12px 14px;
  border:1px solid #F0C4AE;border-radius:12px;background:#FDF1EA;color:#8A3410;
  font:inherit;font-size:13.5px;font-weight:600;text-align:start;cursor:pointer}
.pdot2{min-width:22px;height:22px;line-height:22px;border-radius:11px;background:#D4531D;color:#fff;
  font-size:12px;font-weight:700;text-align:center;flex:0 0 auto}

/* ---- app feel ---- */
@media (max-width:820px){
  h2.sec{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);
    font-weight:700;margin:22px 0 8px}
  .card{border-radius:16px;padding:14px 15px;border-color:transparent;
    box-shadow:0 1px 2px rgba(13,27,46,.05),0 6px 18px rgba(13,27,46,.06)}
  table{font-size:13px}
  th{font-size:10.5px;letter-spacing:.04em;text-transform:uppercase;padding:6px 8px;border:0}
  td{padding:11px 8px;border-bottom:1px solid #F2F5F9}
  tr:last-child td{border-bottom:0}
  .grid.g4{gap:10px}
}
button,.kpibtn,.navcard,.pendstrip,.mini,.ghost{
  -webkit-tap-highlight-color:transparent;
  transition:transform .12s ease, opacity .12s ease, background .15s ease}
button:active,.kpibtn:active,.navcard:active,.pendstrip:active,.mini:active,.ghost:active{
  transform:scale(.975);opacity:.9}
#page{animation:appin .22s cubic-bezier(.22,.7,.3,1)}
@keyframes appin{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.tabbar button.on span{font-weight:700}
.tabbar button.on svg{transform:scale(1.06)}
.tabbar button svg{transition:transform .15s ease}

/* ================= sign-in screen ================= */
#gate{position:relative;min-height:100svh;padding:0 20px 0;display:flex;flex-direction:column;
  align-items:center;overflow:hidden;background:#F6FAFD}
.gbgwrap{position:absolute;inset:0;z-index:0;pointer-events:none}
.gbg{width:100%;height:100%;display:block}
#gate > *:not(.gbgwrap){position:relative;z-index:1;width:100%;max-width:430px}
#gate > .glang{width:auto;max-width:none}

.glang{align-self:flex-end;display:inline-flex;align-items:center;gap:7px;width:auto;margin:14px 0 0;
  padding:8px 14px;border:1px solid #D4E3F1;border-radius:999px;background:rgba(255,255,255,.75);
  backdrop-filter:blur(8px);color:#1B4B7A;font:inherit;font-size:13px;font-weight:600;cursor:pointer}
.glang svg{width:16px;height:16px}

.gtop{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:18px}
.gpitch{padding-top:4px}
.gpl{font-size:18px;line-height:1.5;color:#123A63;font-weight:600}
.gpl.str{font-weight:800;color:#0B1F3D}
.grule{display:block;width:40px;height:3px;border-radius:2px;background:#2E7CC0;margin:14px 0 12px}
.gkick{font-size:10px;letter-spacing:.18em;line-height:1.9;color:#7C97B4;font-weight:700}
.gviz{flex:0 0 130px;background:rgba(255,255,255,.62);border:1px solid rgba(255,255,255,.9);
  border-radius:18px;padding:12px;box-shadow:0 10px 26px rgba(19,60,102,.10)}
.gviz svg{width:100%;height:auto;display:block}

.gbrand{text-align:center;margin:30px 0 18px}
.gatemark{width:64px;height:64px;margin:0 auto 14px;border-radius:18px;display:grid;place-items:center;
  background:linear-gradient(150deg,#0B1F3D,#1668B3);box-shadow:0 14px 30px rgba(11,31,61,.28)}
.gatemark svg{width:32px;height:32px}
#gateBrand{margin:0;font-size:34px;letter-spacing:-.4px;color:#0B1F3D;font-weight:800}
#gateTag{margin:4px 0 0;font-size:14px;color:#5C7A99;font-weight:500}

.gatecard{background:#fff;border-radius:20px;padding:24px 20px;
  box-shadow:0 18px 44px rgba(19,60,102,.13),0 2px 6px rgba(19,60,102,.06)}
.gct{margin:0 0 18px;text-align:center;font-size:21px;font-weight:800;color:#0B1F3D}
.gcs{margin:-10px 0 18px;text-align:center;font-size:13px;color:#6B87A5}
.gfield{display:flex;align-items:center;gap:10px;margin-bottom:14px;padding:0 14px;
  border:1px solid #E1EAF3;border-radius:14px;background:#FBFDFF;transition:border-color .15s,box-shadow .15s}
.gfield:focus-within{border-color:#2E7CC0;box-shadow:0 0 0 3px rgba(46,124,192,.13)}
.gfield svg{width:19px;height:19px;color:#8AA5C0;flex:0 0 auto}
.gfield input{flex:1;min-width:0;border:0;outline:0;background:none;font:inherit;font-size:15px;
  padding:14px 0;color:var(--ink)}
.gbtn{display:flex;align-items:center;justify-content:center;gap:9px;width:100%;margin-top:0;
  padding:15px;border-radius:14px;border:1px solid transparent;font:inherit;font-size:15.5px;
  font-weight:700;cursor:pointer}
.gbtn + .gbtn{margin-top:10px}
.gbtn.tiny{padding:11px;font-size:13px;font-weight:600;background:transparent;color:#5C7A99;
  border:1px solid #DCE7F2}
.gbtn.tiny svg{width:16px;height:16px;opacity:.75}
.gbtn svg{width:19px;height:19px}
.gbtn.primary{background:#144E80;color:#fff;box-shadow:0 8px 20px rgba(20,78,128,.26)}
.gbtn.ghosty{background:#fff;color:#144E80;border-color:#BBD6EC}
.gor{display:flex;align-items:center;gap:12px;margin:18px 0 14px;color:#94A9BE;font-size:13px}
.gor::before,.gor::after{content:"";flex:1;height:1px;background:#E6EDF4}
.gask{margin-top:18px;text-align:center;font-size:13.5px;color:#6B87A5}
.glink{background:none;border:0;padding:0;font:inherit;font-weight:700;color:#1668B3;
  text-decoration:underline;cursor:pointer}
.gmsg{margin-top:12px;font-size:13px;text-align:center}
#paneUser .glink[data-back],#paneReq .glink[data-back],#paneSuper .glink[data-back]{display:block;margin:18px auto 0}
.gmsg.err{color:#C1440E}
.gmsg.ok{color:#1B8A63}

.gfeat{display:flex;justify-content:space-around;gap:8px;margin:22px 0 26px}
.gfeat div{display:flex;flex-direction:column;align-items:center;gap:6px;color:#3E6A96;font-size:12.5px;font-weight:600}
.gfeat svg{width:24px;height:24px}
.gatefoot{margin:auto 0 0;padding:20px 16px calc(24px + env(safe-area-inset-bottom));text-align:center;
  font-size:12px;line-height:1.7;color:rgba(255,255,255,.82);max-width:none;width:100vw;
  margin-inline:calc(50% - 50vw)}
@media (min-width:600px){ .gpl{font-size:22px} }

/* ---- home: welcome + tiles ---- */
.whero{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:4px 0 18px}
.wtxt h2{margin:0;font-size:22px;font-weight:800;color:#0B1F3D;line-height:1.35}
.wtxt h2 b{color:#1668B3;font-weight:800}
.wtxt p{margin:6px 0 0;font-size:14px;color:#6B87A5}
.wviz{position:relative;flex:0 0 132px;background:rgba(255,255,255,.72);
  border:1px solid rgba(255,255,255,.95);border-radius:18px;padding:14px 12px 12px;
  box-shadow:0 12px 28px rgba(19,60,102,.10)}
.wviz svg{width:100%;height:auto;display:block}
.wbadge{position:absolute;top:-12px;inset-inline-start:-8px;display:flex;flex-direction:column;
  align-items:center;gap:1px;padding:6px 10px;border-radius:12px;background:#1B8A63;color:#fff;
  font-size:13px;font-weight:800;box-shadow:0 8px 18px rgba(27,138,99,.32)}
.wbadge.down{background:#C1440E;box-shadow:0 8px 18px rgba(193,68,14,.3)}
.wbadge i{font-style:normal;font-size:9.5px;font-weight:600;opacity:.92}

.tiles{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px}
.tile{position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:6px;
  padding:16px 14px 52px;border:1px solid rgba(255,255,255,.9);border-radius:20px;
  background:rgba(255,255,255,.82);backdrop-filter:blur(6px);font:inherit;text-align:start;cursor:pointer;
  box-shadow:0 10px 26px rgba(19,60,102,.09)}
.tico{display:grid;place-items:center;width:46px;height:46px;border-radius:14px;margin-bottom:6px}
.tico svg{width:23px;height:23px}
.tile .ttl{font-size:16px;font-weight:800;color:#0B1F3D}
.tile .tsb{font-size:12.5px;line-height:1.5;color:#6B87A5}
.tgo{position:absolute;bottom:14px;inset-inline-start:14px;width:34px;height:34px;border-radius:17px;
  display:grid;place-items:center;color:#fff}
.tgo svg{width:16px;height:16px;transform:scaleX(-1)}
.t1 .tico{background:#DCEBF9;color:#14538B} .t1 .tgo{background:#14538B}
.t2 .tico{background:#D6F0E7;color:#12775A} .t2 .tgo{background:#12775A}
.t3 .tico{background:#E2E3FA;color:#4B4FB0} .t3 .tgo{background:#4B4FB0}
.t4 .tico{background:#DCE9FB;color:#1668B3} .t4 .tgo{background:#1668B3}

.todaycard{display:block;width:100%;text-align:start;font:inherit;cursor:pointer;
  border:1px solid rgba(255,255,255,.9);border-radius:20px;padding:16px;margin-bottom:6px;
  background:rgba(255,255,255,.85);box-shadow:0 10px 26px rgba(19,60,102,.09)}
.tdh{display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:700;color:#1668B3;margin-bottom:8px}
.tdi{display:grid;place-items:center;width:26px;height:26px;border-radius:9px;background:#DCE9FB}
.tdi svg{width:15px;height:15px}
.tdt{font-size:15px;font-weight:700;line-height:1.5;color:#0B1F3D}
.tdn{margin-top:6px;font-size:12.5px;color:#6B87A5}

/* ---- signature bar ---- */
.sigbar{direction:ltr;display:flex;align-items:center;gap:18px;margin:26px 0 8px;padding:18px 20px;
  border:1px solid rgba(127,192,242,.28);border-radius:20px;overflow:hidden;position:relative;
  background:linear-gradient(105deg,#0A1B30 0%,#0E2C4E 55%,#123B67 100%)}
.sigbar::after{content:"";position:absolute;right:-40px;bottom:-70px;width:200px;height:200px;
  border-radius:50%;background:rgba(58,124,190,.16)}
.sig-logo{flex:0 0 auto;width:54px;height:54px;border-radius:16px;display:grid;place-items:center;
  background:rgba(127,192,242,.12);border:1px solid rgba(127,192,242,.18)}
.sig-logo svg{width:26px;height:26px}
.sig-sep{flex:0 0 1px;align-self:stretch;background:rgba(127,192,242,.22)}
.sig-main{flex:1 1 auto;min-width:0}
.sig-top{font-size:9.5px;letter-spacing:.11em;text-transform:uppercase;color:rgba(214,231,246,.72)}
.sig-by{font-size:11px;letter-spacing:.02em;color:rgba(226,238,250,.86);margin-top:8px}
.sig-name{font-size:21px;font-weight:800;letter-spacing:.02em;color:#fff;margin-top:1px}
.sig-sub{font-size:12px;letter-spacing:.14em;color:#4FA3E3;margin-top:3px;font-weight:600}
.sig-end{flex:0 0 auto;text-align:center;position:relative;z-index:1}
.sig-ar{direction:rtl;font-size:17px;font-weight:700;color:#DCEAF8;padding-bottom:7px;position:relative}
.sig-ar::after{content:"";position:absolute;left:50%;bottom:0;transform:translateX(-50%);
  width:34px;height:2px;border-radius:1px;background:#4FA3E3}
.sig-en{margin-top:7px;font-size:9px;letter-spacing:.14em;color:rgba(200,222,243,.66)}
@media (max-width:620px){
  .sigbar{flex-wrap:nowrap;gap:11px;padding:12px 13px;border-radius:16px;margin:22px 0 6px}
  .sig-logo{width:38px;height:38px;border-radius:12px}
  .sig-logo svg{width:19px;height:19px}
  .sig-top{font-size:7px;letter-spacing:.07em;line-height:1.5}
  .sig-by{font-size:8px;margin-top:5px}
  .sig-name{font-size:15px}
  .sig-sub{font-size:8.5px;letter-spacing:.1em;margin-top:1px}
  .sig-ar{font-size:12.5px;padding-bottom:5px}
  .sig-ar::after{width:24px}
  .sig-en{font-size:6.5px;letter-spacing:.09em;margin-top:5px}
  .sigbar::after{width:130px;height:130px;right:-30px;bottom:-55px}
}
/* password reveal */
.gpeek{flex:0 0 auto;background:none;border:0;padding:6px;margin-inline-start:2px;cursor:pointer;color:#8AA5C0}
.gpeek svg{width:19px;height:19px}
.gpeek.on{color:#1668B3}

/* ================= dark app shell ================= */
#app{--dbg:#0A1420;--dpanel:#0F1C2B;--dline:rgba(127,176,224,.16);--dtext:#E7F0F9;--dmuted:#8FA8C0}
body:has(#app:not([hidden])){background:var(--dbg)}
#app{background:var(--dbg);color:var(--dtext)}
#app header{background:linear-gradient(180deg,#0C1929,#0A1420);border-bottom:1px solid var(--dline);box-shadow:none}
#app h2.sec{color:var(--dmuted)}
#app .whero .wtxt h2{color:var(--dtext)}
#app .whero .wtxt h2 b{color:#4FA3E3}
#app .whero .wtxt p{color:var(--dmuted)}
#app .wviz{background:rgba(255,255,255,.05);border-color:var(--dline);box-shadow:none}
#app .tile{background:linear-gradient(160deg,#DCEBF8 0%,#CBE2F5 100%);border-color:rgba(255,255,255,.35);
  box-shadow:0 10px 24px rgba(0,0,0,.35)}
#app .tile .ttl{color:#0A2540}
#app .tile .tsb{color:#40688C}
#app .tgo{inset-inline-end:14px;inset-inline-start:auto}
#app .todaycard{background:linear-gradient(120deg,#0C2540,#123B67);
  border:1px solid rgba(79,163,227,.28);box-shadow:0 12px 30px rgba(0,0,0,.35)}
#app .todaycard .tdh{color:#7FC0F2}
#app .todaycard .tdi{background:rgba(127,192,242,.16)}
#app .todaycard .tdt{color:#fff}
#app .todaycard .tdn{color:rgba(206,227,246,.78)}
#app .card,#app .filters,#app .banner,#app .kpibtn,#app .navcard,#app .alert-card,#app .ins,#app .act{
  background:#12203100;background-color:#101E2E;border-color:var(--dline);color:var(--dtext);
  box-shadow:0 8px 22px rgba(0,0,0,.28)}
#app .card .ct,#app .banner .q,#app .kpibtn .kv{color:var(--dtext)}
#app .kpibtn .kl,#app .kpibtn .kn,#app .kpibtn .kmore,#app .banner .a,#app .cs,#app .dim{color:var(--dmuted)}
#app th{color:var(--dmuted)}
#app td{border-bottom-color:rgba(127,176,224,.12)}
#app .tabbar{background:rgba(12,25,41,.94);border-top:1px solid var(--dline)}
#app .tabbar button{color:var(--dmuted)}
#app .tabbar button.on{color:#4FA3E3}
#app .pendstrip{background:rgba(212,83,29,.14);border-color:rgba(212,83,29,.4);color:#F3B79A}
#app .ghost{background:transparent;border:1px solid var(--dline);color:#7FC0F2}
#app .mono{color:inherit}
#app .sigbar{border-color:rgba(127,192,242,.2)}

/* ---- dark: Q&A cards + readable contrast ---- */
#app .qa{background-color:#101E2E;border-color:var(--dline);color:var(--dtext);
  box-shadow:0 8px 22px rgba(0,0,0,.28)}
#app .qa .qq{color:#7FC0F2;font-weight:700;font-size:13.5px}
#app .qa .qa-a{color:#FFFFFF;font-weight:600}
#app .qa .pev .k{color:#8FA8C0}
#app .qa .pev .v{color:#E7F0F9}
#app .qa-e summary{color:#7FC0F2}
#app .chipbtn{background:#16273A;border:1px solid var(--dline);color:#CFE2F4}
#app .chipbtn:active{background:#1D3350}
#app .askbox input{background:#0C1929;border:1px solid var(--dline);color:var(--dtext)}
#app .askbox input::placeholder{color:#6E88A3}
#app .pev .v{color:var(--dtext)}
#app .pev .k{color:var(--dmuted)}
#app .assume,#app .cap,#app .exnote{color:var(--dmuted)}
#app details,#app summary{color:var(--dtext)}
/* password reveal — always visible tap target */
.gfield .gpeek{width:38px;height:38px;display:grid;place-items:center;border-radius:10px;
  background:#EEF4FA;color:#3B6C97;border:1px solid #DCE7F2}
.gfield .gpeek.on{background:#1668B3;color:#fff;border-color:#1668B3}
.rolesel{margin-top:6px;padding:6px 8px;border-radius:9px;border:1px solid var(--line);
  background:var(--card);font:inherit;font-size:12px;color:inherit}
#app .rolesel{background:#16273A;border-color:var(--dline);color:#CFE2F4}
#paneSuper .gfield{background:#FFFFFF;border:1.5px solid #C7DAEC;box-shadow:inset 0 1px 2px rgba(19,60,102,.06)}
#paneSuper .gfield input{color:#0B1F3D;font-weight:600;letter-spacing:.06em}
#paneSuper .gfield input::placeholder{color:#8AA5C0;font-weight:500;letter-spacing:normal}

/* ===== sign-in refinements ===== */
:root{--hb:#1668B3;--hb-d:#11507F;--hb-l:#E8F1FA;--hb-br:#A9CDEA}

#gate{padding-bottom:0}
.glang{margin-top:10px;padding:7px 12px;font-size:12.5px}
.gtop{margin-top:14px;gap:16px}
.gpl{font-size:16px;line-height:1.45;color:#3C5E80;font-weight:500}
.gpl.str{font-size:23px;line-height:1.3;font-weight:800;color:#0B2240;letter-spacing:-.2px;margin:2px 0}
.grule{width:32px;height:2px;margin:11px 0 9px;background:var(--hb);opacity:.65}
.gkick{font-size:8.5px;letter-spacing:.2em;line-height:2;color:#90A8C0;font-weight:600}
.gviz{flex:0 0 112px;padding:11px 10px;border-radius:16px;background:rgba(255,255,255,.55);
  border:1px solid rgba(255,255,255,.85);box-shadow:0 6px 18px rgba(19,60,102,.07)}

.gbrand{margin:22px 0 14px}
.gatemark{width:54px;height:54px;border-radius:16px;margin-bottom:10px;
  box-shadow:0 10px 22px rgba(11,31,61,.22)}
.gatemark svg{width:27px;height:27px}
#gateBrand{font-size:30px;letter-spacing:-.3px}
#gateTag{font-size:12.5px;letter-spacing:.01em;color:#6B87A5;margin-top:3px}

.gatecard{padding:20px 18px;border-radius:18px;border:1px solid #EBF1F7;
  box-shadow:0 6px 20px rgba(19,60,102,.07)}
.gct{font-size:19px;margin-bottom:16px}

.gbtn{padding:14px;font-size:15px;border-radius:13px;gap:8px}
.gbtn + .gbtn{margin-top:9px}
.gbtn svg{width:18px;height:18px}
.gbtn.primary{background:var(--hb);color:#fff;border-color:var(--hb);box-shadow:0 6px 16px rgba(22,104,179,.22)}
.gbtn.primary:active{background:var(--hb-d);border-color:var(--hb-d)}
.gbtn.ghosty{background:#fff;color:var(--hb);border:1.5px solid var(--hb-br);box-shadow:none}
.gbtn.ghosty:active{background:var(--hb-l)}
.gbtn.tiny{padding:10px;font-size:12.5px;font-weight:600;background:#F4F8FC;
  color:#6E8CA8;border:1px solid #E6EEF6}
.gbtn.tiny:active{background:var(--hb-l);color:var(--hb)}
.gbtn.tiny svg{width:15px;height:15px;opacity:.7}

.gor{margin:14px 0 11px;font-size:11.5px;color:#A6B8CA;letter-spacing:.04em}
.gor::before,.gor::after{background:#EDF2F7}

.gfeat{margin:20px 0 22px;gap:4px;align-items:start}
.gfeat div{flex:1 1 0;gap:7px;font-size:11.5px;font-weight:600;color:#7691AC;line-height:1.4;text-align:center}
.gfeat svg{width:19px;height:19px;color:#9BB8D2;stroke-width:1.5}
.gatefoot{font-size:11px;padding:18px 16px calc(22px + env(safe-area-inset-bottom))}
@media (min-width:600px){ .gpl{font-size:17px} .gpl.str{font-size:25px} }

/* dark: keep wide tables on the panel colour when they scroll sideways */
#app .card > div[style*="overflow-x"],#app div[style*="overflow-x"]{background:transparent}
#app table{background:transparent;color:var(--dtext)}
#app thead tr,#app tbody tr{background:transparent}
#app td,#app th{background:transparent;color:inherit}
#app tbody tr:nth-child(even) td{background:rgba(127,176,224,.04)}
#app .card{overflow:hidden}
#app .mini{background:#16273A;border:1px solid var(--dline);color:#CFE2F4}
#app .mini.ok{background:rgba(27,138,99,.16);border-color:rgba(27,138,99,.45);color:#7FD8B4}
#app .mini.no{background:rgba(193,68,14,.16);border-color:rgba(193,68,14,.45);color:#F0A57F}
#app .badge,#app .chip{color:inherit}

/* ---- access list as cards ---- */
.ulist{display:flex;flex-direction:column;gap:10px}
.ucard{border:1px solid var(--line);border-radius:14px;padding:13px 14px;background:var(--card)}
#app .ucard{background:#101E2E;border-color:var(--dline);box-shadow:0 6px 16px rgba(0,0,0,.24)}
#app .ucard.pending{border-color:rgba(212,83,29,.45)}
.uhead{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
.uname{font-size:15px;font-weight:700;line-height:1.3}
.umail{font-size:12px;opacity:.75;direction:ltr;text-align:start;margin-top:3px;word-break:break-all}
.umeta{font-size:11px;opacity:.6;margin-top:8px}
.uacts{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:12px}
.uacts .mini{flex:1 1 auto;min-width:78px;padding:9px 10px;border-radius:10px;font-size:13px;font-weight:600}
.uacts .rolesel{flex:1 1 100%;margin-top:2px;padding:9px 10px;border-radius:10px;font-size:13px}
</style>
</head>
<body>

<div id="bgLayer" style="background-image: none; opacity: 0;"></div>

<section id="gate">
  <div class="gbgwrap" aria-hidden="true">
    <svg class="gbg" viewBox="0 0 390 844" preserveAspectRatio="xMidYMid slice">
      <defs>
        <linearGradient id="gwaveA" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#E8F1FA"></stop><stop offset="1" stop-color="#F6FAFD"></stop></linearGradient>
        <linearGradient id="gwaveB" x1="0" y1="1" x2="1" y2="0">
          <stop offset="0" stop-color="#0B1F3D"></stop><stop offset="1" stop-color="#17548C"></stop></linearGradient>
      </defs>
      <rect width="390" height="844" fill="url(#gwaveA)"></rect>
      <path d="M0 120 Q120 40 250 120 T390 90 V0 H0Z" fill="#E4EFF9" opacity=".55"></path>
      <path d="M0 250 Q140 170 260 260 T390 230" fill="none" stroke="#DBE9F6" stroke-width="22" opacity=".4"></path>
      <path d="M0 690 Q110 620 220 680 T390 640 V844 H0Z" fill="#D7E7F5" opacity=".42"></path>
      <path d="M0 760 Q120 700 240 756 T390 720 V844 H0Z" fill="url(#gwaveB)"></path>
    </svg>
  </div>

  <button class="glang" id="gateLang">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18M12 3c2.6 2.6 2.6 15.4 0 18M12 3c-2.6 2.6-2.6 15.4 0 18"></path></svg>
    <span id="glangt">العربية</span>
  </button>

  <div class="gtop">
    <div class="gpitch">
      <div class="gpl" id="gp1">من البيانات</div>
      <div class="gpl str" id="gp2">إلى قرارات أفضل</div>
      <div class="gpl" id="gp3">لرعاية صحية أكثر كفاءة</div>
      <span class="grule"></span>
      <div class="gkick" id="gp4">SMARTER DATA<br>HEALTHIER PEOPLE</div>
    </div>
    <div class="gviz">
      <svg viewBox="0 0 108 60" aria-hidden="true">
        <g fill="#CBE0F2">
          <rect x="2" y="34" width="12" height="24" rx="2.5"></rect>
          <rect x="21" y="24" width="12" height="34" rx="2.5"></rect>
          <rect x="40" y="12" width="12" height="46" rx="2.5" fill="#1668B3"></rect>
          <rect x="59" y="28" width="12" height="30" rx="2.5"></rect>
          <rect x="78" y="20" width="12" height="38" rx="2.5" fill="#7FB6E3"></rect>
        </g>
      </svg>
    </div>
  </div>

  <div class="gbrand">
    <div class="gatemark"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><path d="M5 19v-4.5"></path><path d="M12 19V9"></path><path d="M19 19v-7"></path>
      <circle cx="12" cy="4.6" r="1.7" fill="#fff" stroke="none"></circle></svg></div>
    <h1 id="gateBrand">HealthIQ</h1>
    <p id="gateTag">AI-Powered Healthcare Analytics</p>
  </div>

  <div class="gatecard">
    <div id="paneChoose">
      <button class="gbtn primary" id="goUser">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2.5"></rect><path d="m3.5 7 8.5 6 8.5-6"></path></svg>
        <span id="gb1">تسجيل الدخول</span></button>
      <button class="gbtn ghosty" id="goReq">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="11" cy="8" r="3.4"></circle><path d="M4.4 19.6c.8-3.2 3.4-4.9 6.6-4.9"></path><path d="M17.5 14.8v5.2M14.9 17.4h5.2"></path></svg>
        <span id="gb2">إنشاء حساب جديد</span></button>
      <div class="gor"><span id="gor1">أو</span></div>
      <button class="gbtn tiny" id="goSuper">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3.5 5 6.4v5c0 4.2 2.9 7.6 7 9.1 4.1-1.5 7-4.9 7-9.1v-5z"></path><path d="M12 9.6v3"></path><circle cx="12" cy="15.4" r=".8" fill="currentColor" stroke="none"></circle></svg> دخول المسؤول الأعلى</button>
    </div>

    <div id="paneUser" hidden="">
      <h2 class="gct" id="gt1">تسجيل الدخول</h2>
      <label class="gfield">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2.5"></rect><path d="m3.5 7 8.5 6 8.5-6"></path></svg>
        <input type="email" id="uEmail" placeholder="البريد المعتمد" dir="ltr">
      </label>
      <button class="gbtn primary" id="uGo">دخول</button>
      <div id="uErr" class="gmsg"></div>
      <button class="glink" data-back="">رجوع</button>
    </div>

    <div id="paneReq" hidden="">
      <h2 class="gct" id="gt2">إنشاء حساب جديد</h2>
      <div class="gcs" id="gt2s">يُراجع الطلب قبل تفعيله</div>
      <label class="gfield">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="3.6"></circle><path d="M4.8 20c.9-3.4 3.7-5.2 7.2-5.2s6.3 1.8 7.2 5.2"></path></svg>
        <input type="text" id="rName" placeholder="الاسم الكامل">
      </label>
      <label class="gfield">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2.5"></rect><path d="m3.5 7 8.5 6 8.5-6"></path></svg>
        <input type="email" id="rEmail" placeholder="البريد" dir="ltr">
      </label>
      <button class="gbtn primary" id="rGo">إرسال الطلب</button>
      <div id="rErr" class="gmsg"></div>
      <button class="glink" data-back="">رجوع</button>
    </div>

    <div id="paneSuper" hidden="">
      <h2 class="gct" id="gt3">دخول المسؤول الأعلى</h2>
      <label class="gfield">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="4.5" y="10" width="15" height="10" rx="2.4"></rect><path d="M8.2 10V7.6a3.8 3.8 0 0 1 7.6 0V10"></path></svg>
        <input type="password" id="gatePw" placeholder="كلمة مرور المسؤول الأعلى">
        <button type="button" class="gpeek" id="pwPeek" aria-label="إظهار">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M2.6 12S6.4 5.8 12 5.8 21.4 12 21.4 12 17.6 18.2 12 18.2 2.6 12 2.6 12z"></path>
            <circle cx="12" cy="12" r="3.1"></circle></svg></button>
      </label>
      <button class="gbtn primary" id="gateGo">دخول</button>
      <div id="gateErr" class="gmsg"></div>
      <button class="glink" data-back="">رجوع</button>
    </div>
  </div>

  <div class="gfeat">
    <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3.5 5 6.4v5c0 4.2 2.9 7.6 7 9.1 4.1-1.5 7-4.9 7-9.1v-5z"></path></svg><span id="gf1">آمن وموثوق</span></div>
    <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 19v-5M10 19v-9M15 19v-6M20 19v-11"></path></svg><span id="gf2">بيانات أدق</span></div>
    <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="9" cy="8.5" r="3.2"></circle><path d="M3.6 19.5c.8-3 3-4.6 5.4-4.6s4.6 1.6 5.4 4.6"></path><path d="M16.5 7.4a3 3 0 0 1 0 5.8"></path></svg><span id="gf3">رعاية أفضل</span></div>
  </div>

  <div class="gatefoot" id="gateFoot">لا يُعتمد أي مستخدم تلقائيًا · الاعتماد قرار يدوي من المسؤول الأعلى</div>
</section>

<div id="app" hidden="">

<header>
  <div class="hwrap">
    <div class="appbar">
      <span class="mark" id="brandLogo" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><path d="M5 19v-4.5"></path><path d="M12 19V9"></path><path d="M19 19v-7"></path><circle cx="12" cy="4.6" r="1.7" fill="#fff" stroke="none"></circle></svg></span>
      <span class="titles">
        <h1 id="brandName">HealthIQ</h1>
        <span class="sub" id="brandTag">AI-Powered Healthcare Analytics</span>
      </span>
      <button class="iconbtn lang" id="langBtn" aria-label="Language">EN</button>
      <span class="roletag" id="roleTag">مستخدم</span>
      <button class="iconbtn" id="btnFilters" aria-label="التصفية"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M7 12h10M10 17h4"></path></svg></button>
      <button class="iconbtn always" id="btnOut" aria-label="خروج"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 17l5-5-5-5"></path><path d="M20 12H9"></path><path d="M12 20H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h6"></path></svg></button>
    </div>
    <nav id="nav"></nav>
  </div>
</header>

<main>
  <h2 class="pagehead" id="titleAr">منصة تحليل أوضاع العيادات الخارجية</h2>
  <div class="filters" id="mainFilters">
    <span><label id="lbDept">القسم</label><select id="fDept"></select></span>
    <span><label id="lbType">النوع</label><select id="fType"></select></span>
    <span><label id="lbFrom">من</label><input type="date" id="fFrom"></span>
    <span><label id="lbTo">إلى</label><input type="date" id="fTo"></span>
    <button class="ghost" id="fClear">مسح</button>
    <span id="fInfo" style="font-size:11.5px;color:var(--muted);margin-inline-start:auto"></span>
  </div>
  <div id="page"></div>
</main>

<footer id="foot"></footer>

<nav class="tabbar" id="tabbar" aria-label="التنقل الرئيسي"><div class="row" id="tabrow"></div></nav>

<div class="scrim" id="scrim" hidden=""></div>
<section class="sheet" id="sheet" hidden="" role="dialog" aria-modal="true" aria-labelledby="sheetTitle">
  <div class="grab"></div>
  <div class="sheet-head"><span class="t" id="sheetTitle"></span><button id="sheetClose">تم</button></div>
  <div class="sheet-body" id="sheetBody"></div>
</section>

</div>

<script>
/* ============================================================
   منصة تحليل أوضاع العيادات الخارجية
   Developed, Analyzed & Prepared by Dina
   ============================================================ */

/* ================= البيانات ================= */
const DOCTORS = /*__DOCTORS__*/[{"id": "d1", "name": "Dr. Musleh", "department": "Internal Medicine", "visiting": true}, {"id": "d2", "name": "Dr. Samer", "department": "Urology"}, {"id": "d3", "name": "Dr. Mazen", "department": "Ophthalmology"}, {"id": "d4", "name": "Dr. Ibrahim Al-Arefi", "department": "ENT", "visiting": true}, {"id": "d5", "name": "Dr. Al-Suwaileh", "department": "General Surgery", "visiting": true}, {"id": "d6", "name": "Dr. Al-Dawood", "department": "Ophthalmology", "visiting": true}, {"id": "d7", "name": "Dr. Raed", "department": "Rheumatology"}, {"id": "d9", "name": "Dr. Al-Ghamdi", "department": "Psychiatry"}, {"id": "d10", "name": "Dr. Al-Ghanmi", "department": "Psychiatry"}, {"id": "txrm43eg", "name": "Dr.Mansur", "department": "Orthopedics", "visiting": true}, {"id": "rvkiqu8f", "name": "Dr. Fawaz", "department": "Cardiology"}, {"id": "msaqr001", "name": "Dr. Mubarak Al-Saqr", "department": "Internal Medicine", "visiting": true}]/*__END__*/;
const RECORDS = /*__RECORDS__*/[{"id": "qq159cos", "doctorId": "d1", "date": "2026-08-02", "booked": 13, "attended": 4, "walkIns": 5}, {"id": "n5jxrbe4", "doctorId": "d2", "date": "2026-08-02", "booked": 3, "attended": 2, "walkIns": 3}, {"id": "fhewfug9", "doctorId": "d2", "date": "2026-08-09", "booked": 4, "attended": 3, "walkIns": 1}, {"id": "6j4uzqkz", "doctorId": "d2", "date": "2026-08-16", "booked": 2, "attended": 2, "walkIns": 1}, {"id": "ha3gwb75", "doctorId": "d3", "date": "2026-08-02", "booked": 8, "attended": 7, "walkIns": 0}, {"id": "v82dde72", "doctorId": "d3", "date": "2026-08-04", "booked": 3, "attended": 3, "walkIns": 0}, {"id": "dcam7eyl", "doctorId": "d3", "date": "2026-08-10", "booked": 6, "attended": 3, "walkIns": 1}, {"id": "u3ebttog", "doctorId": "d3", "date": "2026-08-11", "booked": 4, "attended": 4, "walkIns": 0}, {"id": "4nzrhqvr", "doctorId": "d3", "date": "2026-08-17", "booked": 10, "attended": 4, "walkIns": 1}, {"id": "kvjbsl1j", "doctorId": "d3", "date": "2026-08-18", "booked": 4, "attended": 2, "walkIns": 0}, {"id": "3o3oiuk1", "doctorId": "d4", "date": "2026-08-04", "booked": 12, "attended": 6, "walkIns": 6}, {"id": "a3n3ixww", "doctorId": "d4", "date": "2026-08-11", "booked": 11, "attended": 5, "walkIns": 5}, {"id": "jtmpkjad", "doctorId": "d4", "date": "2026-08-18", "booked": 12, "attended": 6, "walkIns": 2}, {"id": "f596e12u", "doctorId": "d5", "date": "2026-08-04", "booked": 5, "attended": 3, "walkIns": 0}, {"id": "xuzmrw2q", "doctorId": "d5", "date": "2026-08-11", "booked": 7, "attended": 5, "walkIns": 0}, {"id": "f3uviq8v", "doctorId": "d6", "date": "2026-08-05", "booked": 9, "attended": 6, "walkIns": 6}, {"id": "fcrrkl37", "doctorId": "d6", "date": "2026-08-12", "booked": 7, "attended": 5, "walkIns": 0}, {"id": "5nm8vc3c", "doctorId": "d6", "date": "2026-08-19", "booked": 8, "attended": 3, "walkIns": 0}, {"id": "bdwifbyx", "doctorId": "d7", "date": "2026-08-10", "booked": 5, "attended": 5, "walkIns": 0}, {"id": "uorty0u2", "doctorId": "d7", "date": "2026-08-19", "booked": 6, "attended": 6, "walkIns": 0}, {"id": "b4az27fd", "doctorId": "d1", "date": "2026-08-16", "booked": 16, "attended": 6, "walkIns": 3}, {"id": "j62yu2ky", "doctorId": "txrm43eg", "date": "2026-08-16", "booked": 16, "attended": 6, "walkIns": 3}, {"id": "7lxned2g", "doctorId": "rvkiqu8f", "date": "2026-08-20", "booked": 3, "attended": 3, "walkIns": 0}, {"id": "48mwjqcm", "doctorId": "rvkiqu8f", "date": "2026-08-27", "booked": 5, "attended": 5, "walkIns": 0}, {"id": "w3m09emb", "doctorId": "txrm43eg", "date": "2026-08-23", "booked": 16, "attended": 8, "walkIns": 3}, {"id": "65f6dgpn", "doctorId": "d1", "date": "2026-08-30", "booked": 16, "attended": 6, "walkIns": 3}, {"id": "w2k9pbr5", "doctorId": "d2", "date": "2026-08-30", "booked": 4, "attended": 3, "walkIns": 2}, {"id": "1pbvd58w", "doctorId": "txrm43eg", "date": "2026-08-30", "booked": 16, "attended": 8, "walkIns": 3}, {"id": "svjtjahp", "doctorId": "d3", "date": "2026-08-31", "booked": 6, "attended": 3, "walkIns": 0}]/*__END__*/;
const HOURS   = /*__HOURS__*/{"Dr.Mansur": {"hours": 4, "label": "د. منصور", "slot": 15}, "Dr. Musleh": {"hours": 4, "label": "د. مصلح", "slot": 15}, "Dr. Samer": {"hours": 3, "label": "د. سامر", "slot": 15}, "Dr. Mazen": {"hours": 3, "label": "د. مازن", "slot": 15}, "Dr. Mubarak Al-Saqr": {"hours": 4, "label": "د. مبارك الصقر", "slot": 15}, "Dr. Al-Suwaileh": {"hours": 3, "label": "د. عبدالعزيز الصويلح", "slot": 15}, "Dr. Raed": {"hours": 5, "label": "د. رائد", "slot": 15}, "Dr. Ibrahim Al-Arefi": {"hours": 3, "label": "د. إبراهيم العريفي", "slot": 15}, "Dr. Al-Ghanmi": {"hours": 3, "label": "د. عبدالله الغانمي", "slot": 40}, "Dr. Al-Ghamdi": {"hours": 3, "label": "د. عبدالله الغامدي", "slot": 40}, "Dr. Al-Dawood": {"hours": 3, "label": "د. الدوود", "slot": 15}, "Dr. Fawaz": {"hours": 4, "label": "د. فواز", "slot": 15}, "Dr. Salah Al-Haidar": {"hours": 3, "label": "د. صلاح الحيدر", "department": "Psychiatry", "note": "غير مسجّل في اللوحة الحالية", "slot": 40}}/*__END__*/;

const SIG_TOP  = "AI • HEALTHCARE ANALYTICS • BUSINESS INTELLIGENCE";
const SIG_BY   = "Designed & Developed by";
const DEV_LINE = "HealthIQ was developed by Dina, Health Informatics Specialist.";
const SIG_NAME = "Dina";
const SIG_SUB  = "Health Informatics";

const DEPT_AR = {"Internal Medicine":"الباطنية","Pediatrics":"الأطفال","OB/GYN":"النساء والولادة",
"Orthopedics":"العظام","Dermatology":"الجلدية","Ophthalmology":"العيون","ENT":"الأنف والأذن والحنجرة",
"Dental":"الأسنان","General Surgery":"الجراحة العامة","Cardiology":"القلب","Psychiatry":"جودة الحياة",
"Urology":"المسالك البولية","Rheumatology":"الروماتيزم"};
const WD = ["الأحد","الإثنين","الثلاثاء","الأربعاء","الخميس","الجمعة","السبت"];
const MIN_BOOKINGS = 10, MIN_HOURS = 6;
const C = {teal:"#1668B3",terra:"#D4531D",ochre:"#0E7C91",line:"#E1E9F3",muted:"#667A93",
           ink:"#0D1B2E",soft:"#EAF1FA",sage:"#1B8A63"};

/* ================= أدوات ================= */
const $ = id => document.getElementById(id);
const NLOC = () => (typeof LANG!=="undefined" && LANG==="en") ? "en-US" : "ar-EG";
const n1 = v => (v==null||isNaN(v)) ? "—" : (Math.round(v*10)/10).toLocaleString(NLOC(),{maximumFractionDigits:1});
const n2 = v => (v==null||isNaN(v)) ? "—" : (Math.round(v*100)/100).toFixed(2);
const n0 = v => (v==null||isNaN(v)) ? "—" : Math.round(v).toLocaleString(NLOC());
const pc = v => (v==null||isNaN(v)) ? "—" : Math.round(v)+"%";
const esc = s => String(s).replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c]));
const sum = (a,f) => a.reduce((s,x)=>s+f(x),0);
const uniq = a => [...new Set(a)];
const label = name => (typeof LANG!=="undefined" && LANG==="en")
  ? name : ((HOURS[name]&&HOURS[name].label) || name);
const deptAr = d => DEPT_AR[d] || d || "غير محدد";

/* ================= طبقة الحساب ================= */
function enrich(){
  const dm = {}; DOCTORS.forEach(d=>dm[d.id]=d);
  return RECORDS.map(r=>{
    const d = dm[r.doctorId]; if(!d) return null;
    const dt = new Date(r.date+"T00:00:00");
    const attended = +r.attended||0, booked = +r.booked||0, walk = +r.walkIns||0;
    return {...r, booked, attended, walkIns:walk, date:r.date, dt,
      noShows: Math.max(0, booked-attended), seen: attended+walk,
      name:d.name, department:d.department, deptAr:deptAr(d.department),
      visiting:!!d.visiting, typeAr:d.visiting?"استشاري زائر":"طبيب مقيم",
      weekday: WD[dt.getDay()], month: r.date.slice(0,7),
      hoursPerDay: (HOURS[d.name]||{}).hours };
  }).filter(Boolean);
}

function roster(){
  const list = DOCTORS.map(d=>({name:d.name, department:d.department, deptAr:deptAr(d.department),
    visiting:!!d.visiting, typeAr:d.visiting?"استشاري زائر":"طبيب مقيم", inDashboard:true}));
  const known = new Set(list.map(d=>d.name));
  Object.keys(HOURS).forEach(nm=>{
    if(!known.has(nm)){
      const cfg = HOURS[nm];
      list.push({name:nm, department:cfg.department||"", deptAr:deptAr(cfg.department),
        visiting:false, typeAr:"غير محدد", inDashboard:false});
    }
  });
  return list;
}

function summarize(recs, docs){
  return docs.map(d=>{
    const rs = recs.filter(r=>r.name===d.name);
    const days = uniq(rs.map(r=>r.date)).length;
    const hpd = (HOURS[d.name]||{}).hours;
    const booked = sum(rs,r=>r.booked), attended = sum(rs,r=>r.attended),
          walk = sum(rs,r=>r.walkIns), noShows = sum(rs,r=>r.noShows), seen = attended+walk;
    const hours = hpd ? hpd*days : null;
    const bph = hours ? booked/hours : null;
    const slot = (HOURS[d.name]||{}).slot;
    const cap = (hours && slot) ? hours*60/slot : null;
    const mins = slot ? slot/60 : null;
    return {...d, label:label(d.name), days, hoursPerDay:hpd, hours, slot, booked, attended,
      capacity:cap,
      fillRate: cap? booked/cap*100 : null,
      utilization: cap? seen/cap*100 : null,
      unbookedSlots: cap? Math.max(0,cap-booked) : null,
      deliveredHours: mins? seen*mins : null,
      noShowHours: mins? noShows*mins : null,
      unbookedHours: (cap&&mins)? Math.max(0,cap-booked)*mins : null,
      walkinHours: mins? walk*mins : null,
      unusedHours: (hours&&mins)? Math.max(0,hours-seen*mins) : null,
      walkIns:walk, noShows, seen,
      attendanceRate: booked? attended/booked*100 : null,
      noShowRate: booked? noShows/booked*100 : null,
      walkShare: seen? walk/seen*100 : null,
      seenPerHour: hours? seen/hours : null,
      bookedPerHour: bph,
      wastedHours: (slot)? noShows*slot/60 : null,
      hasData: days>0,
      comparable: booked>=MIN_BOOKINGS && hours>=MIN_HOURS };
  }).sort((a,b)=>(b.seenPerHour||-1)-(a.seenPerHour||-1));
}

function totals(sm){
  const s = sm.filter(d=>d.hasData);
  const t = {doctorsTotal:sm.length, doctorsActive:s.length, doctorsIdle:sm.length-s.length,
    days:sum(s,d=>d.days), booked:sum(s,d=>d.booked), attended:sum(s,d=>d.attended),
    walkIns:sum(s,d=>d.walkIns), noShows:sum(s,d=>d.noShows), seen:sum(s,d=>d.seen),
    hours:sum(s,d=>d.hours||0), wasted:sum(s,d=>d.noShowHours||0),
    capacity:sum(s,d=>d.capacity||0), delivered:sum(s,d=>d.deliveredHours||0),
    unbookedHours:sum(s,d=>d.unbookedHours||0), walkinHours:sum(s,d=>d.walkinHours||0)};
  t.unusedHours = Math.max(0, t.hours - t.delivered);
  t.utilization = t.hours? t.delivered/t.hours*100 : null;
  t.fillRate = t.capacity? t.booked/t.capacity*100 : null;
  t.attendanceRate = t.booked? t.attended/t.booked*100 : null;
  t.walkShare = t.seen? t.walkIns/t.seen*100 : null;
  t.seenPerHour = t.hours? t.seen/t.hours : null;
  t.bookedPerHour = t.hours? t.booked/t.hours : null;
  t.wastedShare = t.hours? t.wasted/t.hours*100 : null;
  return t;
}

function wilson(succ, trials){
  if(!trials) return [null,null];
  const z=1.96, p=succ/trials, den=1+z*z/trials;
  const ctr=(p+z*z/(2*trials))/den;
  const half=z*Math.sqrt(p*(1-p)/trials + z*z/(4*trials*trials))/den;
  return [Math.max(0,(ctr-half)*100), Math.min(100,(ctr+half)*100)];
}

function benchmark(sm, key){
  key = key || "seenPerHour";
  const pool = sm.filter(d=>d.comparable && d[key]!=null).map(d=>d[key]);
  const mean = pool.length? pool.reduce((a,b)=>a+b,0)/pool.length : null;
  const sd = pool.length>1 ? Math.sqrt(pool.reduce((s,v)=>s+(v-mean)**2,0)/(pool.length-1)) : 0;
  const sorted = [...pool].sort((a,b)=>a-b);
  return sm.map(d=>{
    let pos=L("بيانات غير كافية","insufficient data"), vs=null, pctile=null;
    if(d.comparable && d[key]!=null && mean!=null){
      const z = sd? (d[key]-mean)/sd : 0;
      pos = z>=0.5 ? L("أعلى من المجموعة","above group") : (z<=-0.5 ? L("أقل من المجموعة","below group") : L("ضمن النطاق","within range"));
      vs = mean? (d[key]-mean)/mean*100 : null;
      pctile = sorted.filter(v=>v<=d[key]).length/sorted.length*100;
    }
    const ci = d.booked? wilson(d.attended,d.booked) : [null,null];
    return {...d, groupMean:mean, groupSd:sd, position:pos, vsGroup:vs, percentile:pctile,
            ciLow:ci[0], ciHigh:ci[1]};
  });
}

function byDept(sm){
  const g = {};
  sm.filter(d=>d.hasData).forEach(d=>{
    const k=d.deptAr; g[k] = g[k] || {deptAr:k,doctors:0,hours:0,booked:0,attended:0,walkIns:0,noShows:0,seen:0};
    g[k].doctors++; g[k].hours+=d.hours||0; g[k].booked+=d.booked; g[k].attended+=d.attended;
    g[k].walkIns+=d.walkIns; g[k].noShows+=d.noShows; g[k].seen+=d.seen;
  });
  return Object.values(g).map(x=>({...x,
    attendanceRate:x.booked?x.attended/x.booked*100:null,
    seenPerHour:x.hours?x.seen/x.hours:null,
    bookedPerHour:x.hours?x.booked/x.hours:null,
    single:x.doctors===1})).sort((a,b)=>b.seenPerHour-a.seenPerHour);
}

function weekdayMatrix(recs){
  const names = uniq(recs.map(r=>r.name));
  const days = WD.filter(d=>recs.some(r=>r.weekday===d));
  const cells = names.map(nm=>days.map(wd=>{
    const rs = recs.filter(r=>r.name===nm && r.weekday===wd);
    if(!rs.length) return null;
    const hrs = uniq(rs.map(r=>r.date)).length * (rs[0].hoursPerDay||0);
    return hrs ? sum(rs,r=>r.seen)/hrs : null;
  }));
  return {names:names.map(label), days, cells};
}

/* ---- الاستنتاجات ---- */
function insights(sm, bm, t){
  const out=[], s = bm.filter(d=>d.comparable);
  if(!s.length) return [{h:L("لا توجد بيانات كافية للمقارنة","Not enough data to compare"), e:L("لم يبلغ أي طبيب الحد الأدنى من الحجوزات والساعات.","No doctor reached the minimum bookings and hours."), c:"", lv:""}];

  const byRate=[...s].sort((a,b)=>b.attendanceRate-a.attendanceRate)[0];
  const byProd=[...s].sort((a,b)=>b.seenPerHour-a.seenPerHour)[0];
  if(byRate.name!==byProd.name)
    out.push({lv:"key", h:L("الترتيب حسب نسبة الحضور يعطي نتيجة مختلفة عن الترتيب حسب الإنتاجية بالساعة","Ranking by attendance rate gives a different result from ranking by output per hour"),
      e:`${byRate.label} ${L("الأعلى في نسبة الحضور (","Highest attendance rate (")}${pc(byRate.attendanceRate)}) ${L("لكن إنتاجيته","but output is")} ${n2(byRate.seenPerHour)} ${L("مراجع/ساعة، بينما","visitors/hour, while")} ${byProd.label} ${L("إنتاجيته","reaches")} ${n2(byProd.seenPerHour)} ${L("مراجع/ساعة بنسبة حضور","visitors/hour at an attendance rate of")} ${pc(byProd.attendanceRate)}.`,
      c:L("الحضور يقيس دقة الجدولة، والإنتاجية تقيس استخدام الوقت.","Attendance measures scheduling accuracy; output measures use of time.")});

  if(t.utilization!=null){
    out.push({lv:"warn", h:`${pc(t.utilization)} ${L("فقط من الطاقة العيادية أنتجت مراجعًا فعليًا","of clinical capacity produced an actual visitor")}`,
      e:`${L("الطاقة المتاحة","Available capacity")} ${n0(t.capacity)} ${L("موعدًا (","appointments (")}${n0(t.hours)} ${L("ساعة). لم يُحجز منها","hours). Never booked:")} ${n0(t.unbookedHours)} ${L("ساعة، وضاعت","hours; lost:")} ${n0(t.wasted)} ${L("ساعة بسبب عدم الحضور، واسترجع الدخول بلا موعد","hours to no-shows; walk-ins recovered")} ${n0(t.walkinHours)} ${L("ساعة. الناتج النهائي","hours. Net result:")} ${n0(t.delivered)} ${L("ساعة منتجة من أصل","productive hours out of")} ${n0(t.hours)}.`,
      c:L("محسوب من مدة الموعد، وليس تقديرًا.","Computed from appointment length, not estimated.")});
    const fh=[...s].sort((a,b)=>b.fillRate-a.fillRate);
    if(fh.length>=2 && fh[0].fillRate-fh[fh.length-1].fillRate>=30){
      const hi2=fh[0], lo2=fh[fh.length-1];
      out.push({lv:"key", h:L("نسبة ملء المواعيد المتاحة متفاوتة بشدة بين العيادات","Fill rate of available appointments varies sharply between clinics"),
        e:`${hi2.label} ${L("يملأ","fills")} ${pc(hi2.fillRate)} ${L("من مواعيده المتاحة، بينما","of available appointments, while")} ${lo2.label} ${L("يملأ","fills")} ${pc(lo2.fillRate)} ${L("فقط (","only (")}${n0(lo2.unbookedSlots)} ${L("موعدًا لم يُحجز).","appointments unbooked).")}`,
        c:L("السبب غير واضح: ضعف طلب أم مواعيد غير مفتوحة.","The cause is unclear: weak demand or appointments never opened.")});
    }
  }

  const hi=[...s].sort((a,b)=>b.bookedPerHour-a.bookedPerHour)[0];
  const lo=[...s].sort((a,b)=>a.bookedPerHour-b.bookedPerHour)[0];
  if(lo.bookedPerHour>0 && hi.bookedPerHour/lo.bookedPerHour>=2)
    out.push({lv:"key", h:L("كثافة الجدولة متفاوتة بشكل كبير بين الأطباء","Scheduling density varies widely between doctors"),
      e:`${hi.label}: ${n2(hi.bookedPerHour)} ${L("حجز/ساعة مقابل","bookings/hour against")} ${lo.label}: ${n2(lo.bookedPerHour)} ${L("حجز/ساعة، أي فارق","bookings/hour, a gap of")} ${n1(hi.bookedPerHour/lo.bookedPerHour)} ${L("ضعف.","times.")}`,
      c:L("السبب غير معروف من البيانات.","The cause is not known from the data.")});

  if(s.length>=5){
    const xs=s.map(d=>d.bookedPerHour), ys=s.map(d=>d.attendanceRate);
    const mx=xs.reduce((a,b)=>a+b)/xs.length, my=ys.reduce((a,b)=>a+b)/ys.length;
    const cov=xs.reduce((a,x,i)=>a+(x-mx)*(ys[i]-my),0);
    const r = cov/Math.sqrt(xs.reduce((a,x)=>a+(x-mx)**2,0)*ys.reduce((a,y)=>a+(y-my)**2,0));
    if(Math.abs(r)>=0.5)
      out.push({lv:"key", h:`${L("نسبة الحضور","Attendance rate")} ${r<0?L("تنخفض","falls"):L("ترتفع","rises")} ${L("كلما زادت كثافة الحجز في الساعة","as booking density per hour increases")}`,
        e:`${L("معامل ارتباط","correlation coefficient")} ${n2(r)} ${L("على","across")} ${s.length} ${L("أطباء.","doctors.")}`,
        c:L("ارتباط لا سببية، والعينة صغيرة.","Correlation, not causation, and the sample is small.")});
  }

  const top=[...s].sort((a,b)=>b.seenPerHour-a.seenPerHour)[0];
  const bot=[...s].sort((a,b)=>a.seenPerHour-b.seenPerHour)[0];
  out.push({lv:"", h:`${L("أعلى إنتاجية:","Highest output:")} ${top.label} · ${L("أقل إنتاجية:","Lowest output:")} ${bot.label}`,
    e:`${n2(top.seenPerHour)} ${L("مقابل","vs")} ${n2(bot.seenPerHour)} ${L("مراجع/ساعة ضمن","visitors/hour among")} ${s.length} ${L("أطباء تجاوزوا حد المقارنة.","doctors above the comparison threshold.")}`, c:""});

  const heavy=s.filter(d=>d.walkShare>=35).sort((a,b)=>b.walkShare-a.walkShare);
  if(heavy.length)
    out.push({lv:"key", h:L("جزء كبير من المراجعين يصل بلا موعد لدى بعض الأطباء","A large share of visitors arrive without an appointment for some doctors"),
      e:`${heavy.slice(0,3).map(d=>`${d.label} (${pc(d.walkShare)})`).join("، ")}. ${L("على مستوى المنشأة","facility-wide")} ${pc(t.walkShare)} ${L("من المراجعين بلا موعد.","of visitors are walk-ins.")}`,
      c:L("قد يكون ضعف قناة الحجز أو حالات عاجلة.","This may be a weak booking channel or urgent cases.")});

  const vis=s.filter(d=>d.typeAr===L("استشاري زائر","Visiting consultant")), res=s.filter(d=>d.typeAr===L("طبيب مقيم","Resident physician"));
  if(vis.length>=2 && res.length>=2){
    const mv=vis.reduce((a,d)=>a+d.seenPerHour,0)/vis.length;
    const mr=res.reduce((a,d)=>a+d.seenPerHour,0)/res.length;
    if(Math.abs(mv-mr)>=0.3)
      out.push({lv:"", h:L("فرق في الإنتاجية بين الاستشاريين الزائرين والأطباء المقيمين","Output differs between visiting consultants and resident physicians"),
        e:`${L("متوسط الزائرين","Visiting average:")} ${n2(mv)} ${L("مقابل","vs")} ${n2(mr)} ${L("مراجع/ساعة للمقيمين.","visitors/hour for residents.")}`,
        c:L("قد يعود لطبيعة التخصصات لا لنوع التعاقد.","This may reflect the specialties involved rather than the contract type.")});
  }
  return out;
}

/* ---- المحاكاة ---- */
function scDensity(d, dens){
  const rate = d.booked? d.attended/d.booked : 0;
  const wph = d.hours? d.walkIns/d.hours : 0;
  const booked = dens*d.hours, attended = booked*rate;
  const seen = attended + wph*d.hours, ns = booked-attended;
  return {booked, attended, seen, noShows:ns, seenPerHour:seen/d.hours, wastedHours: dens? ns/dens : null};
}
function scLift(d, pts){
  const rate = Math.min(100,(d.attendanceRate||0)+pts)/100;
  const attended = d.booked*rate, seen = attended+d.walkIns, ns = d.booked-attended;
  const dens = d.hours? d.booked/d.hours : null;
  return {booked:d.booked, attended, seen, noShows:ns, seenPerHour:seen/d.hours,
          wastedHours: dens? ns/dens : null};
}
function scDays(d, days){
  const hours = d.hoursPerDay*days, k = d.days? days/d.days : 0;
  const booked=d.booked*k, attended=d.attended*k, seen=d.seen*k, ns=booked-attended;
  const dens = hours? booked/hours : null;
  return {booked, attended, seen, noShows:ns, hours, seenPerHour: hours? seen/hours : null,
          wastedHours: dens? ns/dens : null};
}

/* ---- التوصيات ---- */
function recommendations(bm){
  const out=[], s=bm.filter(d=>d.comparable);
  s.filter(d=>d.bookedPerHour>=3 && d.attendanceRate<50)
   .sort((a,b)=>b.wastedHours-a.wastedHours).forEach(d=>{
    const prop = Math.max(2, Math.round(d.bookedPerHour*0.75*100)/100);
    const sim = scDensity(d, prop);
    out.push({a:`${L("مراجعة كثافة جدولة","Review scheduling density for")} ${d.label}`,
      r:`${n2(d.bookedPerHour)} ${L("حجز/ساعة مقابل نسبة حضور","bookings/hour against an attendance rate of")} ${pc(d.attendanceRate)}${L("، وما يعادل",", equal to")} ${n0(d.wastedHours)} ${L("ساعة مهدرة.","wasted hours.")}`,
      e:`${L("عند","At")} ${n2(prop)} ${L("حجز/ساعة ينخفض عدم الحضور من","bookings/hour, no-shows drop from")} ${n0(d.noShows)} ${L("إلى","to")} ${n0(sim.noShows)}${L("، لكن المراجعين ينخفضون أيضًا من",", but visitors also drop from")} ${n0(d.seen)} ${L("إلى","to")} ${n0(sim.seen)}. ${L("الأثر الحقيقي يأتي من رفع نسبة الحضور لا من تقليل الحجز.","Real impact comes from raising attendance, not from cutting bookings.")}`,
      n:L("سبب عدم الحضور غير مسجّل.","The no-show reason is not recorded.")});
  });
  s.filter(d=>d.fillRate<55).sort((a,b)=>b.unbookedSlots-a.unbookedSlots).forEach(d=>{
    out.push({a:`${L("مراجعة فتح المواعيد لعيادة","Review how appointments are opened for clinic")} ${d.label}`,
      r:`${pc(d.fillRate)} ${L("فقط من المواعيد المتاحة محجوزة، أي","of available appointments are booked, i.e.")} ${n0(d.unbookedSlots)} ${L("موعدًا فارغًا (","empty appointments (")}${n0(d.unbookedHours)} ${L("ساعة) خلال","hours) over")} ${d.days} ${L("أيام عيادة.","clinic days.")}`,
      e:`${L("ملء نصف هذه المواعيد يضيف نحو","Filling half of these appointments adds about")} ${n0(d.unbookedSlots*0.5*(d.attendanceRate||0)/100)} ${L("مراجعًا دون أي ساعة إضافية.","visitors with no extra hours.")}`,
      n:L("قائمة الانتظار غير متاحة.","A waiting list is not available.")});
  });
  const idle = bm.filter(d=>!d.hasData).map(d=>d.label);
  if(idle.length) out.push({a:L("تأكيد حالة الأطباء بلا سجلات","Confirm the status of doctors with no records"),
    r:`${idle.length} ${L("طبيب دون أي يوم عيادة مسجّل:","doctors with no clinic day recorded:")} ${idle.join("، ")}.`,
    e:L("استبعادهم يصحّح كل المتوسطات والترتيب في التقارير.","Excluding them corrects every average and ranking in reports."),
    n:L("تأكيد إداري لحالتهم.","Administrative confirmation of their status.")});
  const heavy = s.filter(d=>d.walkShare>=40);
  if(heavy.length) out.push({a:L("مراجعة مسار الحجز للعيادات عالية الدخول بلا موعد","Review the booking path for clinics with high walk-in volume"),
    r:`${L("نسبة المراجعين بلا موعد تتجاوز 40% لدى:","Walk-in share exceeds 40% for:")} ${heavy.map(d=>d.label).join("، ")}.`,
    e:L("تحويل جزء منهم إلى مواعيد يرفع القدرة على التخطيط ويقلل الازدحام غير المتوقع.","Converting some of them into appointments improves planning and reduces unexpected congestion."),
    n:L("تصنيف الحالة غير مسجّل.","Case classification is not recorded.")});
  return out;
}

/* ---- جودة البيانات ---- */
function quality(recs, sm){
  const out=[];
  const idle = sm.filter(d=>!d.hasData);
  if(idle.length) out.push({lv:"تنبيه", t:L("أطباء بلا أي سجل","Doctors with no record at all"),
    d:`${idle.length} ${L("طبيب دون أي يوم عيادة:","doctors with no clinic day:")} ${idle.map(x=>x.label).join("، ")}`,
    i:L("يظهرون بإنتاجية صفر في أي ترتيب، والصحيح استبعادهم أو تأكيد توقفهم فعلًا.","They appear with zero output in every ranking; they should be excluded or confirmed as genuinely inactive.")});
  const noHours = sm.filter(d=>!d.hoursPerDay).map(d=>d.label);
  if(noHours.length) out.push({lv:"حرج", t:L("ساعات عيادة غير معرّفة","Clinic hours not defined"), d:noHours.join("، "),
    i:L("كل مؤشرات الإنتاجية بالساعة تُحذف لهؤلاء.","All per-hour output metrics are dropped for them.")});
  const seen={};
  recs.forEach(r=>{ if(!r.booked) return;
    const k=[r.name,r.booked,r.attended,r.walkIns].join("|");
    (seen[k]=seen[k]||[]).push(r.date); });
  Object.entries(seen).filter(([,v])=>v.length>1).forEach(([k,v])=>{
    const p=k.split("|");
    out.push({lv:"تنبيه", t:L("سجلات متطابقة الأرقام","Records with identical figures"),
      d:`${label(p[0])}: ${p[1]}/${p[2]}/${p[3]} ${L("في","in")} ${v.map(x=>x.slice(8)+"/"+x.slice(5,7)).join("، ")}`,
      i:L("قد يكون إدخالًا مكررًا. يرفع أو يخفض المؤشر دون واقع مقابل.","This may be duplicate entry. It moves the metric with no matching reality.")});
  });
  const thin = sm.filter(d=>d.hasData && !d.comparable).map(d=>d.label);
  if(thin.length) out.push({lv:"منهجي", t:L("عينة أصغر من حد المقارنة","Sample below the comparison threshold"), d:thin.join("، "),
    i:`${L("أقل من","fewer than")} ${MIN_BOOKINGS} ${L("حجزًا أو","bookings or")} ${MIN_HOURS} ${L("ساعات. يُعرضون دون ترتيب.","hours. They are shown without a rank.")}`});
  const months = uniq(recs.map(r=>r.month)).sort();
  if(months.length<2) out.push({lv:"منهجي", t:L("شهر واحد فقط في البيانات","Only one month in the data"),
    d:`${L("الفترة المتاحة:","Available period:")} ${months[0]||"—"}`,
    i:L("لا يمكن حساب اتجاه زمني أو مقارنة فترة بفترة. أقصى ما يمكن هو التقسيم الأسبوعي.","No time trend or period-to-period comparison can be computed. Weekly splitting is the most that is possible.")});
  const absent = WD.filter(d=>!recs.some(r=>r.weekday===d));
  if(absent.length) out.push({lv:"معلومة", t:L("أيام أسبوع بلا تسجيل","Weekdays with no records"), d:absent.join("، "),
    i:L("إما لا توجد عيادات فيها، أو التسجيل غير مكتمل. الفرق مهم قبل أي قرار توزيع.","Either no clinics run on them, or recording is incomplete. The difference matters before any distribution decision.")});
  return out;
}

/* ================= الرسوم (SVG) ================= */
function svg(w,h,inner){
  return `<svg viewBox="0 0 ${w} ${h}" width="100%" style="display:block;height:auto" xmlns="http://www.w3.org/2000/svg">${inner}</svg>`;
}
function txt(x,y,s,o){o=o||{};return `<text x="${x}" y="${y}" font-size="${o.size||11}" fill="${o.fill||C.muted}" text-anchor="${o.anchor||"start"}" font-weight="${o.weight||400}">${esc(s)}</text>`;}

/* أشرطة أفقية مزدوجة (خلفية = القيمة الكبرى) */
function hBarOverlay(rows, opts){
  const W=680, rowH=30, padT=26, padR=150, padL=48;
  const H = padT + rows.length*rowH + 22;
  const max = Math.max(...rows.map(r=>Math.max(r.back,r.front)))*1.12 || 1;
  const sx = v => padL + (W-padL-padR)*(v/max);
  let g="";
  rows.forEach((r,i)=>{
    const y = padT + i*rowH;
    g += `<text x="${W-padR+10}" y="${y+14}" font-size="11.5" fill="${C.ink}" text-anchor="start">${esc(r.label)}</text>`;
    g += `<rect x="${padL}" y="${y+3}" width="${sx(r.back)-padL}" height="16" rx="3" fill="${C.line}"/>`;
    g += `<rect x="${padL}" y="${y+3}" width="${sx(r.front)-padL}" height="16" rx="3" fill="${C.teal}"/>`;
    g += `<text x="${sx(r.back)+6}" y="${y+15}" font-size="10.5" fill="${C.muted}">${n2(r.back)}</text>`;
  });
  if(opts && opts.mean!=null){
    const x=sx(opts.mean);
    g += `<line x1="${x}" y1="${padT-8}" x2="${x}" y2="${H-18}" stroke="${C.terra}" stroke-dasharray="3 3"/>`;
    g += txt(x, padT-12, opts.meanLabel||"", {fill:C.terra, anchor:"middle", size:10.5});
  }
  return svg(W,H,g);
}

/* أشرطة عمودية (مجموعة أو مفردة) */
function vBars(cats, series, opts){
  opts=opts||{};
  const W=680, padT=30, padB=52, padL=44, padR=10, H=opts.height||300;
  const all = series.flatMap(s=>s.values.filter(v=>v!=null));
  const max = Math.max(...all,0)*1.15 || 1;
  const cw = (W-padL-padR)/cats.length;
  const bw = Math.min(38, (cw*0.72)/series.length);
  const sy = v => padT + (H-padT-padB)*(1-v/max);
  let g=`<line x1="${padL}" y1="${H-padB}" x2="${W-padR}" y2="${H-padB}" stroke="${C.line}"/>`;
  for(let i=0;i<=4;i++){
    const v=max*i/4, y=sy(v);
    g+=`<line x1="${padL}" y1="${y}" x2="${W-padR}" y2="${y}" stroke="${C.line}" stroke-dasharray="2 4"/>`;
    g+=txt(padL-6,y+4,n1(v),{anchor:"end",size:10});
  }
  cats.forEach((c,i)=>{
    const cx = padL + cw*i + cw/2;
    series.forEach((s,j)=>{
      const v=s.values[i]; if(v==null) return;
      const x = cx - (series.length*bw)/2 + j*bw;
      g+=`<rect x="${x}" y="${sy(v)}" width="${bw-3}" height="${H-padB-sy(v)}" rx="3" fill="${s.color}"><title>${esc(c)} · ${esc(s.name)}: ${n2(v)}</title></rect>`;
    });
    g+=`<g transform="translate(${cx},${H-padB+14}) rotate(${opts.rotate||0})">${txt(0,0,c,{anchor:"middle",size:10.5,fill:C.ink})}</g>`;
  });
  let lg=""; series.forEach((s,i)=>{ lg+=`<rect x="${W-padR-140-i*0}" y="0" width="0" height="0"/>`; });
  return svg(W,H,g);
}

/* نقاط بفواصل ثقة */
function dotCI(rows){
  const W=680, rowH=26, padT=24, padR=150, padL=40;
  const H=padT+rows.length*rowH+24;
  const sx = v => padL + (W-padL-padR)*(v/100);
  let g="";
  [0,25,50,75,100].forEach(v=>{
    g+=`<line x1="${sx(v)}" y1="${padT-10}" x2="${sx(v)}" y2="${H-22}" stroke="${C.line}" stroke-dasharray="2 4"/>`;
    g+=txt(sx(v),H-8,v+"%",{anchor:"middle",size:10});
  });
  rows.forEach((r,i)=>{
    const y=padT+i*rowH+8;
    g+=`<text x="${W-padR+10}" y="${y+4}" font-size="11.5" fill="${C.ink}">${esc(r.label)}</text>`;
    if(r.low!=null){
      g+=`<line x1="${sx(r.low)}" y1="${y}" x2="${sx(r.high)}" y2="${y}" stroke="${C.muted}" stroke-width="1.4"/>`;
      g+=`<line x1="${sx(r.low)}" y1="${y-4}" x2="${sx(r.low)}" y2="${y+4}" stroke="${C.muted}"/>`;
      g+=`<line x1="${sx(r.high)}" y1="${y-4}" x2="${sx(r.high)}" y2="${y+4}" stroke="${C.muted}"/>`;
    }
    g+=`<circle cx="${sx(r.value)}" cy="${y}" r="5" fill="${C.teal}"><title>${esc(r.label)}: ${pc(r.value)}</title></circle>`;
  });
  return svg(W,H,g);
}

/* مخطط انتشار */
function scatter(pts, xl, yl){
  const W=680, H=360, padL=52, padB=48, padT=22, padR=24;
  const xs=pts.map(p=>p.x), ys=pts.map(p=>p.y);
  const xmax=Math.max(...xs)*1.18||1, ymax=Math.max(...ys)*1.15||1;
  const sx=v=>padL+(W-padL-padR)*(v/xmax), sy=v=>H-padB-(H-padT-padB)*(v/ymax);
  let g=`<line x1="${padL}" y1="${H-padB}" x2="${W-padR}" y2="${H-padB}" stroke="${C.line}"/>
        <line x1="${padL}" y1="${padT}" x2="${padL}" y2="${H-padB}" stroke="${C.line}"/>`;
  for(let i=0;i<=4;i++){
    const y=sy(ymax*i/4); g+=`<line x1="${padL}" y1="${y}" x2="${W-padR}" y2="${y}" stroke="${C.line}" stroke-dasharray="2 4"/>`;
    g+=txt(padL-6,y+4,n0(ymax*i/4),{anchor:"end",size:10});
    const x=sx(xmax*i/4); g+=txt(x,H-padB+16,n1(xmax*i/4),{anchor:"middle",size:10});
  }
  const rmax=Math.max(...pts.map(p=>p.r||1));
  pts.forEach(p=>{
    g+=`<circle cx="${sx(p.x)}" cy="${sy(p.y)}" r="${6+(p.r||1)/rmax*10}" fill="${C.terra}" opacity="0.72"><title>${esc(p.label)}</title></circle>`;
    g+=txt(sx(p.x),sy(p.y)-14,p.label,{anchor:"middle",size:10,fill:C.ink});
  });
  g+=txt(W/2,H-8,xl,{anchor:"middle",size:11});
  g+=`<g transform="translate(14,${H/2}) rotate(-90)">${txt(0,0,yl,{anchor:"middle",size:11})}</g>`;
  return svg(W,H,g);
}

/* رادار */
function radar(axes, sets){
  const W=420,H=360,cx=W/2,cy=H/2+6,R=118;
  let g="";
  [0.25,0.5,0.75,1].forEach(f=>{
    const pts=axes.map((a,i)=>{const ang=-Math.PI/2+i*2*Math.PI/axes.length;
      return `${cx+Math.cos(ang)*R*f},${cy+Math.sin(ang)*R*f}`;}).join(" ");
    g+=`<polygon points="${pts}" fill="none" stroke="${C.line}"/>`;
  });
  axes.forEach((a,i)=>{
    const ang=-Math.PI/2+i*2*Math.PI/axes.length;
    g+=`<line x1="${cx}" y1="${cy}" x2="${cx+Math.cos(ang)*R}" y2="${cy+Math.sin(ang)*R}" stroke="${C.line}"/>`;
    g+=txt(cx+Math.cos(ang)*(R+22), cy+Math.sin(ang)*(R+22)+4, a, {anchor:"middle",size:10.5,fill:C.ink});
  });
  sets.forEach(s=>{
    const pts=s.values.map((v,i)=>{const ang=-Math.PI/2+i*2*Math.PI/axes.length;
      const f=Math.max(0,Math.min(1,v/100));
      return `${cx+Math.cos(ang)*R*f},${cy+Math.sin(ang)*R*f}`;}).join(" ");
    g+=`<polygon points="${pts}" fill="${s.color}" fill-opacity="0.22" stroke="${s.color}" stroke-width="2"/>`;
  });
  return svg(W,H,g);
}

/* خريطة حرارية */
function heatmap(m){
  const cellW=78, cellH=30, padR=150, padT=26;
  const W=padR+m.days.length*cellW+16, H=padT+m.names.length*cellH+18;
  const vals=m.cells.flat().filter(v=>v!=null);
  const max=Math.max(...vals,0.001);
  let g="";
  m.days.forEach((d,j)=> g+=txt(W-padR-j*cellW-cellW/2, padT-8, d, {anchor:"middle",size:10.5,fill:C.ink}));
  m.names.forEach((nm,i)=>{
    g+=`<text x="${W-padR+10}" y="${padT+i*cellH+20}" font-size="11.5" fill="${C.ink}">${esc(nm)}</text>`;
    m.cells[i].forEach((v,j)=>{
      const x=W-padR-j*cellW-cellW+4, y=padT+i*cellH+3;
      if(v==null){ g+=`<rect x="${x}" y="${y}" width="${cellW-8}" height="${cellH-6}" rx="4" fill="#F7FAFE" stroke="${C.line}" stroke-dasharray="2 3"/>`; return; }
      const f=v/max;
      g+=`<rect x="${x}" y="${y}" width="${cellW-8}" height="${cellH-6}" rx="4" fill="${C.teal}" fill-opacity="${0.12+f*0.85}"><title>${esc(m.names[i])} · ${esc(m.days[j])}: ${n2(v)}</title></rect>`;
      g+=`<text x="${x+(cellW-8)/2}" y="${y+16}" font-size="10.5" text-anchor="middle" fill="${f>0.55?"#fff":C.ink}">${n2(v)}</text>`;
    });
  });
  return svg(W,H,g);
}

function legend(items){
  return `<div style="font-size:11.5px;color:var(--muted);margin-top:8px">` +
    items.map(i=>`<span style="margin-inline-end:14px"><span class="sw" style="background:${i.c}"></span>${esc(i.t)}</span>`).join("") + `</div>`;
}

/* ================= الحالة والتصفية ================= */
const ALL = enrich();
const ROSTER = roster();
let state = {kpi:null, clinic:null, askLog:[], askDraft:"", page:"home", dept:"__ALL_DEPT__", type:"__ALL_TYPE__", from:"", to:"", a:null, b:null, deptSel:null,
              metric:"seenPerHour", scen:"density", scenDoc:null, scenVal:null};

function filtered(){
  return ALL.filter(r=>
    (state.dept===ALL_DEPT || r.deptAr===state.dept) &&
    (state.type===ALL_TYPE || r.typeAr===state.type) &&
    (!state.from || r.date>=state.from) &&
    (!state.to || r.date<=state.to));
}
function docsFiltered(){
  return ROSTER.filter(d=>
    (state.dept===ALL_DEPT || d.deptAr===state.dept) &&
    (state.type===ALL_TYPE || d.typeAr===state.type || !d.inDashboard));
}

/* ================= الصفحات ================= */
const PAGE_KEYS = ["home","ai","exec","changed","clinic","forecast","ask",
  "bench","compare","dept","insights","sim","time","registry","dq"];
const PAGES_BASE = () => PAGE_KEYS.map(k=>[k, tr(k)]);
Object.defineProperty(globalThis, "PAGES", {get:()=>PAGES_BASE()});

function navPages(){
  const base = PAGES.filter(p => canSee(p[0]));
  if(isSuper()) return base.concat([["access", L("طلبات الوصول","Access Requests")], ["admin", tr("admin")]]);
  if(isDataAdmin()) return base.concat([["access", L("طلبات الوصول","Access Requests")]]);
  return base;
}
function pageAllowed(k){ return navPages().some(p=>p[0]===k); }
function pendingCount(){ return (isSuper()||isDataAdmin()) ? users().filter(u=>u.status===ST.PENDING).length : 0; }

function kpiCard(l,v,note,alert){
  return `<div class="card kpi ${alert?"alert":""}"><div class="l">${l}</div>
    <div class="v mono">${v}</div><div class="n">${note||""}</div></div>`;
}
function insCard(i){
  return `<div class="ins ${i.lv||""}"><div class="h">${esc(i.h)}</div>
    <div class="e">${esc(i.e)}</div>${i.c?`<div class="c">${esc(i.c)}</div>`:""}</div>`;
}
function recCard(r){
  return `<div class="rec"><div class="a">${esc(r.a)}</div>
    <div class="row"><span class="k">السبب</span> ${esc(r.r)}</div>
    <div class="row"><span class="k">الأثر</span> ${esc(r.e)}</div>
    <div class="row"><span class="k">ينقصنا</span> ${esc(r.n)}</div></div>`;
}

function capacityBar(t){
  const W=680,H=96,padL=10,padR=10,y=24,h=34;
  const segs=[{v:t.attended,c:C.teal,l:L("حضروا بموعد","Attended with appointment")},
              {v:t.walkIns,c:C.sage,l:L("دخلوا بلا موعد","Walk-ins")},
              {v:t.capacity-t.seen,c:C.line,l:L("غير مستغلة","Unused")}];
  const tot=segs.reduce((a,s)=>a+s.v,0)||1;
  let x=W-padR, g="";
  segs.forEach(s=>{
    const w=(W-padL-padR)*(s.v/tot);
    g+=`<rect x="${x-w}" y="${y}" width="${w}" height="${h}" fill="${s.c}"><title>${esc(s.l)}: ${n0(s.v)}</title></rect>`;
    if(w>54) g+=`<text x="${x-w/2}" y="${y+22}" font-size="12" text-anchor="middle" fill="${s.c===C.line?C.ink:"#fff"}" font-weight="600">${n0(s.v)}</text>`;
    x-=w;
  });
  let lx=W-padR, lg="";
  segs.forEach(s=>{
    const w=(W-padL-padR)*(s.v/tot);
    lg+=`<text x="${lx-w/2}" y="${y+h+18}" font-size="10.5" text-anchor="middle" fill="${C.muted}">${esc(s.l)} · ${pc(s.v/tot*100)}</text>`;
    lx-=w;
  });
  return svg(W,H,g+lg);
}

/* ---- تصنيفات تشغيلية ---- */
function perfLabels(d, cmp){
  if(!d.hasData) return [{t:L("بلا سجلات","no records"),c:"mid"}];
  if(!d.comparable) return [{t:L("عينة صغيرة","small sample"),c:"mid"}];
  const q=(arr,pp)=>{const a=arr.filter(v=>v!=null).sort((x,y)=>x-y);
    return a.length? a[Math.min(a.length-1,Math.floor(a.length*pp))] : 0;};
  const prodHi=q(cmp.map(x=>x.seenPerHour),0.6), attHi=q(cmp.map(x=>x.attendanceRate),0.6);
  const out=[];
  if(d.seenPerHour>=prodHi) out.push({t:L("إنتاجية عالية","high output"),c:"up"});
  if(d.attendanceRate>=attHi) out.push({t:L("حضور مرتفع","high attendance"),c:"up"});
  if(d.fillRate<55) out.push({t:L("طاقة غير مستغلة","unused capacity"),c:"dn"});
  if(d.attendanceRate<50 && d.fillRate>=80) out.push({t:L("يحتاج مراجعة","needs review"),c:"dn"});
  if(!out.length) out.push({t:L("ضمن النطاق","within range"),c:"mid"});
  return out;
}
const chips = ls => ls.map(x=>`<span class="chip ${x.c}">${esc(x.t)}</span>`).join("");

/* ---- إجراءات ذات أولوية ---- */
function priorityActions(sm, bm, t){
  const out=[], s=bm.filter(d=>d.comparable);

  s.filter(d=>d.fillRate>=80 && d.attendanceRate<60)
   .sort((a,b)=>b.noShowHours-a.noShowHours).forEach(d=>{
    out.push({w:d.noShowHours, lv:"hi", ttl:`${L("عدم حضور مرتفع في عيادة","High no-show rate in clinic")} ${d.label}`,
      p:`${L("مواعيده ممتلئة","appointments are full at")} ${pc(d.fillRate)} ${L("لكن الحضور","but attendance is")} ${pc(d.attendanceRate)} ${L("فقط.","only.")}`,
      im:`${n0(d.noShows)} ${L("موعدًا ضاع، أي","appointments lost, equal to")} ${n1(d.noShowHours)} ${L("ساعة.","hours.")}`,
      sg:`${L("كثافة الحجز","Booking density:")} ${n2(d.bookedPerHour)} ${L("حجز/ساعة. السبب غير معروف من البيانات.","bookings/hour. The cause is not known from the data.")}`,
      ac:L("مراجعة التذكير بالمواعيد، وتسجيل سبب عدم الحضور: إلغاء أم تخلّف.","Review appointment reminders and record the no-show reason: cancellation or failure to attend.")});
  });

  s.filter(d=>d.fillRate<55).sort((a,b)=>b.unbookedSlots-a.unbookedSlots).forEach(d=>{
    out.push({w:d.unbookedHours, lv:"", ttl:`${L("طاقة غير محجوزة في عيادة","Unbooked capacity in clinic")} ${d.label}`,
      p:`${pc(d.fillRate)} ${L("فقط من المواعيد المتاحة محجوزة.","of available appointments are booked.")}`,
      im:`${n0(d.unbookedSlots)} ${L("موعدًا فارغًا، أي","empty appointments, equal to")} ${n1(d.unbookedHours)} ${L("ساعة.","hours.")}`,
      sg:`${L("نسبة حضوره","Attendance is")} ${pc(d.attendanceRate)}${L("، فالخلل في الحجز لا في المرضى.",", so the problem is booking, not patients.")}`,
      ac:`${L("مراجعة فتح المواعيد. ملء نصفها يضيف نحو","Review how appointments are opened. Filling half of them adds about")} ${n0(d.unbookedSlots*0.5*(d.attendanceRate||0)/100)} ${L("مراجعًا بلا ساعة إضافية.","visitors with no extra hours.")}`});
  });

  const heavy = s.filter(d=>d.walkShare>=40);
  if(heavy.length) out.push({w:8, lv:"", ttl:L("اعتماد مرتفع على الدخول بلا موعد","Heavy reliance on walk-ins"),
    p:`${L("نسبة المراجعين بلا موعد تتجاوز 40% لدى:","Walk-in share exceeds 40% for:")} ${heavy.map(d=>d.label).join("، ")}.`,
    im:`${n0(t.walkIns)} ${L("مراجعًا بلا موعد، أي","walk-in visitors, equal to")} ${pc(t.walkShare)} ${L("من المراجعين.","of all visitors.")}`,
    sg:L("البيانات لا تفرّق بين حالة عاجلة وحالة كان يمكن حجزها.","The data does not separate urgent cases from cases that could have been booked."),
    ac:L("تصنيف الحالة عند الاستقبال، وتحويل ما يمكن منها إلى مواعيد.","Classify cases at reception and convert what can be converted into appointments.")});

  const idle = bm.filter(d=>!d.hasData);
  if(idle.length) out.push({w:6, lv:"", ttl:L("أطباء بلا أي سجل نشاط","Doctors with no activity record"),
    p:`${idle.length} ${L("طبيب مسجّل دون أي يوم عيادة:","doctors registered with no clinic day:")} ${idle.map(d=>d.label).join("، ")}.`,
    im:L("يظهرون بإنتاجية صفر ويؤثرون على كل المتوسطات.","They show zero output and distort every average."),
    sg:L("غير واضح إن كان توقفًا أم نقص تسجيل.","It is unclear whether this is a stoppage or incomplete recording."),
    ac:L("تأكيد حالتهم، ثم استبعادهم أو استكمال تسجيلهم.","Confirm their status, then exclude them or complete their records.")});

  if(t.utilization!=null && t.utilization<60) out.push({w:99, lv:"hi",
    ttl:L("أكثر من نصف الطاقة العيادية غير مستغلة","More than half of clinical capacity is unused"),
    p:`${pc(t.utilization)} ${L("فقط من الطاقة المتاحة أنتجت مراجعًا فعليًا.","of available capacity produced an actual visitor.")}`,
    im:`${n1(t.unusedHours)} ${L("ساعة من","hours of")} ${n0(t.hours)} ${L("لم تنتج زيارة:","produced no visit:")} ${n1(t.unbookedHours)} ${L("بلا حجز و","with no booking and")}${n1(t.wasted)} ${L("بعدم حضور.","to no-shows.")}`,
    sg:L("مشكلتان منفصلتان، لكل منهما عيادات مختلفة.","Two separate problems, each in different clinics."),
    ac:L("رفع الحجز حيث المواعيد فارغة، ورفع الحضور حيث المواعيد ممتلئة.","Raise bookings where slots are empty, and raise attendance where slots are full.")});

  return out.sort((a,b)=>b.w-a.w);
}
function actCard(a,i){
  return `<div class="act ${a.lv}">
    <div class="top"><span class="num">${i+1}</span><span class="ttl">${esc(a.ttl)}</span></div>
    <div class="body">
      <div class="b"><div class="lab">المشكلة</div>${esc(a.p)}</div>
      <div class="b"><div class="lab">الأثر</div>${esc(a.im)}</div>
      <div class="b"><div class="lab">ملاحظة</div>${esc(a.sg)}</div>
      <div class="b"><div class="lab">المقترح</div>${esc(a.ac)}</div>
    </div></div>`;
}

/* ---- حلقة (Donut) ---- */
function donut(parts, centerV, centerL){
  const W=300,H=230,cx=W/2,cy=112,R=78,r=48;
  const tot=parts.reduce((a,p)=>a+p.v,0)||1;
  let ang=-Math.PI/2, g="";
  parts.forEach(p=>{
    const a2=ang+2*Math.PI*(p.v/tot);
    const big=(a2-ang)>Math.PI?1:0;
    const x1=cx+Math.cos(ang)*R, y1=cy+Math.sin(ang)*R, x2=cx+Math.cos(a2)*R, y2=cy+Math.sin(a2)*R;
    const x3=cx+Math.cos(a2)*r, y3=cy+Math.sin(a2)*r, x4=cx+Math.cos(ang)*r, y4=cy+Math.sin(ang)*r;
    g+=`<path d="M${x1},${y1} A${R},${R} 0 ${big} 1 ${x2},${y2} L${x3},${y3} A${r},${r} 0 ${big} 0 ${x4},${y4} Z" fill="${p.c}"><title>${esc(p.l)}: ${n0(p.v)} (${pc(p.v/tot*100)})</title></path>`;
    ang=a2;
  });
  g+=`<text x="${cx}" y="${cy+2}" font-size="24" font-weight="700" text-anchor="middle" fill="${C.ink}">${esc(centerV)}</text>`;
  g+=`<text x="${cx}" y="${cy+20}" font-size="10.5" text-anchor="middle" fill="${C.muted}">${esc(centerL)}</text>`;
  parts.forEach((p,i)=>{
    const y=H-32+ (i%2)*15, x= i<2? W/2-70 : W/2+10;
    g+=`<rect x="${x}" y="${y-8}" width="9" height="9" rx="2" fill="${p.c}"/>`;
    g+=`<text x="${x+14}" y="${y}" font-size="10.5" fill="${C.muted}">${esc(p.l)} ${pc(p.v/tot*100)}</text>`;
  });
  return svg(W,H,g);
}

/* ---- مصفوفة 2×2 ---- */
function quadrant(pts, xMid, yMid){
  const W=680,H=430,padL=56,padR=20,padT=28,padB=56;
  const xmax=100, ymax=Math.max(...pts.map(p=>p.y),1)*1.2;
  const sx=v=>padL+(W-padL-padR)*(v/xmax), sy=v=>H-padB-(H-padT-padB)*(v/ymax);
  const x0=sx(xMid), y0=sy(yMid);
  let g="";
  g+=`<rect x="${x0}" y="${padT}" width="${W-padR-x0}" height="${y0-padT}" fill="#EAF6F0"/>`;
  g+=`<rect x="${padL}" y="${padT}" width="${x0-padL}" height="${y0-padT}" fill="#FFF7EC"/>`;
  g+=`<rect x="${x0}" y="${y0}" width="${W-padR-x0}" height="${H-padB-y0}" fill="#F5F8FC"/>`;
  g+=`<rect x="${padL}" y="${y0}" width="${x0-padL}" height="${H-padB-y0}" fill="#FDF0E9"/>`;
  g+=`<line x1="${x0}" y1="${padT}" x2="${x0}" y2="${H-padB}" stroke="${C.muted}" stroke-dasharray="4 4"/>`;
  g+=`<line x1="${padL}" y1="${y0}" x2="${W-padR}" y2="${y0}" stroke="${C.muted}" stroke-dasharray="4 4"/>`;
  const qs=[[L("حضور مرتفع + إنتاجية عالية","High attendance + high output"),(x0+W-padR)/2,padT+16],
            [L("حضور منخفض + إنتاجية عالية","Low attendance + high output"),(padL+x0)/2,padT+16],
            [L("حضور مرتفع + إنتاجية منخفضة","High attendance + low output"),(x0+W-padR)/2,H-padB-10],
            [L("حضور منخفض + إنتاجية منخفضة","Low attendance + low output"),(padL+x0)/2,H-padB-10]];
  qs.forEach(q=>{ g+=txt(q[1],q[2],q[0],{anchor:"middle",size:10.5,fill:C.muted}); });
  for(let i=0;i<=4;i++){
    g+=txt(padL-8,sy(ymax*i/4)+4,n1(ymax*i/4),{anchor:"end",size:10});
    g+=txt(sx(100*i/4),H-padB+16,(100*i/4)+"%",{anchor:"middle",size:10});
  }
  pts.forEach(p=>{
    g+=`<circle cx="${sx(p.x)}" cy="${sy(p.y)}" r="7" fill="${C.teal}" opacity="0.85"><title>${esc(p.label)} · ${L("حضور","attendance")} ${pc(p.x)} · ${n2(p.y)} ${L("مراجع/ساعة","visitors/hour")}</title></circle>`;
    g+=txt(sx(p.x),sy(p.y)-13,p.label,{anchor:"middle",size:10.5,fill:C.ink,weight:600});
  });
  g+=txt(W/2,H-10,L("نسبة الحضور","Attendance rate"),{anchor:"middle",size:11.5});
  g+=`<g transform="translate(16,${H/2}) rotate(-90)">${txt(0,0,L("مراجعون لكل ساعة","Visitors per hour"),{anchor:"middle",size:11.5})}</g>`;
  return svg(W,H,g);
}

/* ---- أعمدة متراكمة ---- */
function stackedBars(cats, series, opts){
  opts=opts||{};
  const W=680,padT=26,padB=56,padL=44,padR=10,H=opts.height||320;
  const totals=cats.map((c,i)=>series.reduce((a,s)=>a+(s.values[i]||0),0));
  const max=Math.max(...totals,1)*1.12;
  const cw=(W-padL-padR)/cats.length, bw=Math.min(46,cw*0.6);
  const sy=v=>padT+(H-padT-padB)*(1-v/max);
  let g=`<line x1="${padL}" y1="${H-padB}" x2="${W-padR}" y2="${H-padB}" stroke="${C.line}"/>`;
  for(let i=0;i<=4;i++){const y=sy(max*i/4);
    g+=`<line x1="${padL}" y1="${y}" x2="${W-padR}" y2="${y}" stroke="${C.line}" stroke-dasharray="2 4"/>`;
    g+=txt(padL-6,y+4,n0(max*i/4),{anchor:"end",size:10});}
  cats.forEach((c,i)=>{
    const cx=padL+cw*i+cw/2; let acc=0;
    series.forEach(sr=>{
      const v=sr.values[i]||0; if(!v) return;
      const y1=sy(acc+v), y2=sy(acc);
      g+=`<rect x="${cx-bw/2}" y="${y1}" width="${bw}" height="${y2-y1}" fill="${sr.color}"><title>${esc(c)} · ${esc(sr.name)}: ${n0(v)}</title></rect>`;
      acc+=v;
    });
    g+=txt(cx,H-padB+16,c,{anchor:"middle",size:10.5,fill:C.ink});
  });
  return svg(W,H,g);
}

function kpiX(l,v,note,explain,alert){
  return `<div class="card kpi ${alert?"alert":""}"><div class="l">${l}</div>
    <div class="v mono">${v}</div>${note?`<div class="n">${note}</div>`:""}
    <div class="x">${explain}</div></div>`;
}

function pageExec(recs, sm, bm, t){
  const cmp = bm.filter(d=>d.comparable);
  const rows = [...cmp].sort((a,b)=>a.seenPerHour-b.seenPerHour)
    .map(d=>({label:d.label, back:d.bookedPerHour, front:d.seenPerHour}));
  const fill = [...cmp].sort((a,b)=>b.fillRate-a.fillRate);
  const util = [...cmp].sort((a,b)=>b.utilization-a.utilization);
  const acts = priorityActions(sm,bm,t);
  const meanAtt = cmp.length? cmp.reduce((a,d)=>a+d.attendanceRate,0)/cmp.length : 0;
  const meanProd = cmp.length? cmp.reduce((a,d)=>a+d.seenPerHour,0)/cmp.length : 0;
  const stacked = [...cmp].sort((a,b)=>b.booked-a.booked);
  const emptyClinics = cmp.filter(d=>d.fillRate<55).length;
  const fullClinics = cmp.filter(d=>d.fillRate>=80).length;

  return `
  <div class="banner">
    <div class="a">${L("من","of")} <b>${n0(t.capacity)}</b> ${L("موعدًا متاحًا،","available appointments,")} <b>${n0(t.seen)}</b> ${L("موعدًا فقط أنتج زيارة. الباقي","produced an actual visit. The remainder:")} <b>${n1(t.unusedHours)}</b> ${L("ساعة:","hours:")} <b>${n1(t.unbookedHours)}</b> ${L("لم تُحجز، و","were never booked, and")}<b>${n1(t.wasted)}</b> ${L("حُجزت ولم يحضر أصحابها.","were booked but not attended.")}</div>
    <div class="a" style="margin-top:8px">${fullClinics} ${L("عيادات مواعيدها ممتلئة ومشكلتها الحضور، و","clinics are fully booked and their problem is attendance, while")}${emptyClinics} ${L("عيادات مواعيدها فارغة ومشكلتها الحجز.","clinics have empty slots and their problem is booking.")}</div>
  </div>

  <div class="grid g4">
    ${kpiX(L("الطاقة المتاحة","Available capacity"), n0(t.capacity), `${n0(t.hours)} ${L("ساعة عيادة","clinic hours")}`,
      L("ساعات العيادة ÷ مدة الموعد","clinic hours ÷ appointment length"))}
    ${kpiX(L("الحجوزات","Bookings"), n0(t.booked), `${pc(t.fillRate)} ${L("من الطاقة","of capacity")}`,
      L("ما تم حجزه من المتاح","booked out of available"))}
    ${kpiX(L("الحضور بموعد","Attended with appointment"), n0(t.attended), "", L("حجوزات حضر أصحابها","bookings that were attended"))}
    ${kpiX(L("الدخول بلا موعد","Walk-ins"), n0(t.walkIns), `${pc(t.walkShare)} ${L("من المراجعين","of visitors")}`,
      L("مراجعون بلا حجز مسبق","visitors with no prior booking"))}
  </div>

  <div class="grid g4" style="margin-top:14px">
    ${kpiX(L("عدم الحضور","No-shows"), n0(t.noShows), `${pc(100-t.attendanceRate)} ${L("من الحجوزات","of bookings")}`,
      L("حجوزات لم يحضر أصحابها","bookings that were not attended"), true)}
    ${kpiX(L("نسبة الحضور","Attendance rate"), pc(t.attendanceRate), "", L("الحضور ÷ الحجوزات","attended ÷ booked"))}
    ${kpiX(L("ملء المواعيد","Fill rate"), pc(t.fillRate), "", L("المحجوز ÷ المتاح","booked ÷ available"))}
    ${kpiX(L("استغلال الطاقة","Capacity utilization"), pc(t.utilization), "", L("الزيارات ÷ المتاح","visits ÷ available"), true)}
  </div>

  <div class="grid g2" style="margin-top:14px">
    ${kpiX(L("المراجعون لكل ساعة عيادة","Visitors per clinic hour"), n2(t.seenPerHour), `${n0(t.seen)} ${L("مراجعًا في","visitors in")} ${n0(t.hours)} ${L("ساعة","hours")}`,
      L("أعدل أساس للمقارنة بين الأطباء","the fairest basis for comparing doctors"))}
    ${kpiX(L("الطاقة المهدرة","Wasted capacity"), n1(t.unusedHours)+L("ساعة","hours"), `${pc(100-t.utilization)} ${L("من الطاقة ·","of capacity ·")} ${n0(t.capacity-t.seen)} ${L("موعدًا","appointments")}`,
      L("ساعات لم تنتج زيارة","hours that produced no visit"), true)}
  </div>

  <h2 class="sec">الطاقة المهدرة</h2>
  <div class="card">
    <div class="split">
      <div>
        <div class="l">${L("طاقة لم تُحجز أصلًا","Capacity never booked")}</div>
        <div class="n mono">${n0(t.capacity-t.booked)} ${L("موعدًا ·","appointments ·")} ${n1(t.unbookedHours)} ${L("ساعة","hours")}</div>
        <div class="s">${L("مواعيد متاحة لم يحجزها أحد.","available appointments nobody booked.")}</div>
      </div>
      <div>
        <div class="l">${L("طاقة ضاعت بعدم الحضور","Capacity lost to no-shows")}</div>
        <div class="n mono" style="color:var(--terra)">${n0(t.noShows)} ${L("موعدًا ·","appointments ·")} ${n1(t.wasted)} ${L("ساعة","hours")}</div>
        <div class="s">${L("مواعيد حُجزت وحُجب وقتها ثم لم يحضر أصحابها.","appointments that reserved and blocked time, then went unattended.")}</div>
      </div>
    </div>
    <div style="margin-top:16px">
      <div class="ct">${L("توزيع الطاقة الكلية","Total capacity distribution")}</div>
      ${capacityBar(t)}
      <div class="cap">${L("الدخول بلا موعد استرجع","Walk-ins recovered")} ${n0(t.walkIns)} ${L("موعدًا، فنزل الفاقد إلى","appointments, bringing waste down to")} ${n0(t.capacity-t.seen)}.</div>
    </div>
  </div>

  <h2 class="sec">${L("أولويات للمراجعة","Review priorities")}</h2>
  <div class="cs" style="margin-bottom:10px">${L("مرتبة حسب حجم الأثر","ordered by size of impact")}</div>
  ${acts.slice(0,4).map(actCard).join("")}

  <h2 class="sec">${L("مصفوفة الأداء التشغيلي","Operational performance matrix")}</h2>
  <div class="card">
    <div class="ct">${L("الحضور مقابل الإنتاجية","attendance vs productivity")}</div>
    <div class="cs">${L("الخطوط المتقطعة = متوسط المجموعة (","Dashed lines = group average (")}${pc(meanAtt)} · ${n2(meanProd)} ${L("مراجع/ساعة)","visitors/hour)")}</div>
    <div style="overflow-x:auto">${quadrant(cmp.map(d=>({x:d.attendanceRate,y:d.seenPerHour,label:d.label})), meanAtt, meanProd)}</div>
    <div class="cap">${L("مؤشرات تشغيلية، ليست تقييمًا للأداء الطبي.","Operational indicators, not an assessment of clinical performance.")}</div>
  </div>

  <div class="grid g23" style="margin-top:14px">
    <div class="card">
      <div class="ct">${L("الفجوة بين ما يُحجز وما يُخدم — لكل ساعة عيادة","The gap between what is booked and what is served — per clinic hour")}</div>
      <div class="cs">${L("المسافة بين الشريطين هي الفاقد","the distance between the two bars is the waste")}</div>
      ${hBarOverlay(rows,{mean:t.seenPerHour, meanLabel:L("متوسط المنشأة","Facility average")+n2(t.seenPerHour)})}
      ${legend([{c:C.line,t:L("حجوزات/ساعة","Bookings/hour")},{c:C.teal,t:L("مراجعون/ساعة","Visitors/hour")}])}
    </div>
    <div class="card">
      <div class="ct">${L("الحضور مقابل عدم الحضور","Attendance vs no-shows")}</div>
      <div class="cs">${L("من إجمالي","out of")} ${n0(t.booked)} ${L("حجز","bookings")}</div>
      <div style="max-width:300px;margin:0 auto">
      ${donut([{v:t.attended,c:C.teal,l:L("حضروا","attended")},{v:t.noShows,c:C.terra,l:L("لم يحضروا","no-shows")}], pc(t.attendanceRate), L("نسبة الحضور","Attendance rate"))}
      </div>
    </div>
  </div>

  <div class="grid g2" style="margin-top:14px">
    <div class="card">
      <div class="ct">${L("الحجوزات والحضور والدخول بلا موعد","Bookings, attendance and walk-ins")}</div>
      <div class="cs">${L("الحضور + عدم الحضور = الحجوزات","attended + no-shows = bookings")}</div>
      ${stackedBars(stacked.map(d=>d.label),[
        {name:L("حضور بموعد","Attended"),color:C.teal,values:stacked.map(d=>d.attended)},
        {name:L("عدم حضور","No-show"),color:C.terra,values:stacked.map(d=>d.noShows)},
        {name:L("بلا موعد","Walk-in"),color:C.sage,values:stacked.map(d=>d.walkIns)}],{height:330})}
      ${legend([{c:C.teal,t:L("حضور بموعد","Attended")},{c:C.terra,t:L("عدم حضور","No-show")},{c:C.sage,t:L("بلا موعد","Walk-in")}])}
    </div>
    <div class="card">
      <div class="ct">${L("الطاقة المتاحة مقابل الزيارات الفعلية","Available capacity vs actual visits")}</div>
      <div class="cs">${L("لكل طبيب، بعدد المواعيد","per doctor, in appointments")}</div>
      ${vBars(util.map(d=>d.label),[
        {name:L("الطاقة","Capacity"),color:C.line,values:util.map(d=>d.capacity)},
        {name:L("الزيارات","Visits"),color:C.teal,values:util.map(d=>d.seen)}],{height:330})}
      ${legend([{c:C.line,t:L("الطاقة المتاحة","Available capacity")},{c:C.teal,t:L("الزيارات الفعلية","Actual visits")}])}
    </div>
  </div>

  <div class="grid g2" style="margin-top:14px">
    <div class="card">
      <div class="ct">${L("نسبة ملء المواعيد المتاحة","Fill rate of available appointments")}</div>
      <div class="cs">${L("كم من مواعيد الطبيب المتاحة تم حجزها فعلًا","how much of each doctor's available appointments were actually booked")}</div>
      ${vBars(fill.map(d=>d.label), [{name:L("ملء %","Fill %"),color:C.ochre,values:fill.map(d=>d.fillRate)}], {height:300})}
      <div class="cap">100% = ${L("كل المواعيد محجوزة","all appointments booked")}</div>
    </div>
    <div class="card">
      <div class="ct">${L("استغلال الطاقة لكل طبيب","Capacity utilization per doctor")}</div>
      <div class="cs">${L("نسبة المواعيد التي أنتجت زيارة فعلية","share of appointments that produced an actual visit")}</div>
      ${vBars(util.map(d=>d.label), [{name:L("استغلال %","Utilization %"),color:C.teal,values:util.map(d=>d.utilization)}], {height:300})}
      <div class="cap">${L("يجمع أثر الحجز والحضور معًا","combines the effect of booking and attendance")}</div>
    </div>
  </div>

  <h2 class="sec">${L("ملاحظات على البيانات","Notes on the data")}</h2>
  ${insights(sm,bm,t).slice(0,4).map(insCard).join("")}

  <div class="assume" style="margin-top:16px">
    ${L("كل الأرقام محسوبة من بيانات تشغيلية فقط: الطبيب، التاريخ، الحجوزات، الحضور، الدخول بلا موعد، ساعات العيادة، ومدة الموعد. لا أسماء مرضى ولا أرقام ملفات ولا تشخيصات.","All figures come from operational data only: doctor, date, bookings, attendance, walk-ins, clinic hours and appointment length. No patient names, file numbers or diagnoses.")}
  </div>`;
}

function pageCompare(recs, sm, bm){
  const act = bm.filter(d=>d.hasData);
  if(act.length<2) return `<div class="card">${L("تحتاج طبيبين على الأقل ضمن التصفية الحالية.","At least two doctors are needed under the current filters.")}</div>`;
  if(!state.a || !act.some(d=>d.name===state.a)) state.a = act[0].name;
  if(!state.b || !act.some(d=>d.name===state.b) || state.b===state.a)
    state.b = act.find(d=>d.name!==state.a).name;
  const A = act.find(d=>d.name===state.a), B = act.find(d=>d.name===state.b);
  const cmp = bm.filter(d=>d.comparable);
  const mx = k => Math.max(...cmp.map(d=>d[k]||0),0.001);

  const metrics = [
    ["seenPerHour",L("مراجعون لكل ساعة","Visitors per hour"),"up"], ["bookedPerHour",L("حجوزات لكل ساعة","Bookings per hour"),"ctx"],
    ["attendanceRate",L("نسبة الحضور %","Attendance rate %"),"up"], ["noShowRate",L("نسبة عدم الحضور %","No-show rate %"),"dn"],
    ["fillRate",L("ملء المواعيد %","Fill rate %"),"up"], ["utilization",L("استغلال الطاقة %","Capacity utilization %"),"up"],
    ["walkShare",L("نسبة بلا موعد %","Walk-in share %"),"ctx"], ["seen",L("إجمالي المراجعين","Total visitors"),"ctx"],
    ["hours",L("ساعات العيادة","Clinic hours"),"ctx"], ["capacity",L("المواعيد المتاحة","Available appointments"),"ctx"],
    ["noShowHours",L("ساعات ضاعت بعدم الحضور","Hours lost to no-shows"),"dn"]];

  let best=null, bestPct=-1;
  const rows = metrics.map(([k,l,dir])=>{
    const va=A[k], vb=B[k], diff=(va!=null&&vb!=null)?va-vb:null;
    const pct = (diff!=null && vb) ? diff/Math.abs(vb)*100 : null;
    if(pct!=null && Math.abs(pct)>bestPct){bestPct=Math.abs(pct); best={l,va,vb,pct};}
    let win="—";
    if(dir==="up" && diff) win = diff>0?A.label:B.label;
    if(dir==="dn" && diff) win = diff<0?A.label:B.label;
    return `<tr><td>${l}</td><td class="mono">${n2(va)}</td><td class="mono">${n2(vb)}</td>
      <td class="mono">${diff==null?"—":(diff>0?"+":"")+n2(diff)}</td>
      <td class="mono">${pct==null?"—":(pct>0?"+":"")+n0(pct)+"%"}</td>
      <td>${win==="—"?"<span class='pill'>"+L("سياق","Context")+"</span>":"<span class='pill up'>"+esc(win)+"</span>"}</td></tr>`;
  }).join("");

  const barCats=[L("مراجعون/ساعة","Visitors/hour"),L("حجوزات/ساعة","Bookings/hour"),L("نسبة الحضور","Attendance rate"),L("بلا موعد %","Walk-in %")];
  const pick=d=>[d.seenPerHour,d.bookedPerHour,d.attendanceRate,d.walkShare];
  const axes=[L("إنتاجية/ساعة","Output/hour"),L("الحضور","Attendance"),L("كثافة الحجز","Booking density"),L("حجم المراجعين","Visitor volume"),L("الساعات","Hours")];
  const norm=d=>[d.seenPerHour/mx("seenPerHour")*100, d.attendanceRate/mx("attendanceRate")*100,
                 d.bookedPerHour/mx("bookedPerHour")*100, d.seen/mx("seen")*100, d.hours/mx("hours")*100];

  const opts = ns => act.map(d=>`<option value="${esc(d.name)}" ${d.name===ns?"selected":""}>${esc(d.label)}</option>`).join("");

  return `
  <div class="card" style="margin-bottom:14px">
    <span><label>${L("الطبيب الأول","First doctor")}</label><select id="selA">${opts(state.a)}</select></span>
    <span style="margin-inline-start:14px"><label>${L("الطبيب الثاني","Second doctor")}</label><select id="selB">${opts(state.b)}</select></span>
  </div>

  <div class="card" style="margin-bottom:14px;padding:12px 18px">
    <div style="font-size:12px;color:var(--muted);margin-bottom:6px">${L("التصنيف","Category")}</div>
    <div><b style="font-size:12.5px">${esc(A.label)}</b> ${chips(perfLabels(A,cmp))}</div>
    <div style="margin-top:7px"><b style="font-size:12.5px">${esc(B.label)}</b> ${chips(perfLabels(B,cmp))}</div>
  </div>

  <div class="grid g4">
    ${["seenPerHour|مراجعون/ساعة","attendanceRate|نسبة الحضور","fillRate|ملء المواعيد %","utilization|استغلال الطاقة %"]
      .map(s=>{const [k,l]=s.split("|"); const d=(A[k]||0)-(B[k]||0);
        return kpiCard(l, `${n2(A[k])} · ${n2(B[k])}`,
          `${d>0?"▲":d<0?"▼":"="} ${L("فرق","difference")} ${n2(Math.abs(d))} ${L("لصالح","in favour of")} ${d>0?A.label:B.label}`);}).join("")}
  </div>

  <div class="grid g2" style="margin-top:14px">
    <div class="card">
      <div class="ct">${L("مقارنة المؤشرات","Indicator comparison")}</div><div class="cs">${esc(A.label)} ${L("مقابل","vs")} ${esc(B.label)}</div>
      ${vBars(barCats,[{name:A.label,color:C.teal,values:pick(A)},{name:B.label,color:C.ochre,values:pick(B)}],{height:320})}
      ${legend([{c:C.teal,t:A.label},{c:C.ochre,t:B.label}])}
    </div>
    <div class="card">
      <div class="ct">${L("الملف التشغيلي","Operational profile")}</div><div class="cs">${L("كل محور نسبة لأعلى قيمة في المجموعة","each axis is relative to the highest value in the group")}</div>
      <div style="max-width:420px;margin:0 auto">
      ${radar(axes,[{color:C.teal,values:norm(A)},{color:C.ochre,values:norm(B)}])}</div>
      ${legend([{c:C.teal,t:A.label},{c:C.ochre,t:B.label}])}
    </div>
  </div>

  <div class="card" style="margin-top:14px">
    <table><thead><tr><th>${L("المؤشر","Indicator")}</th><th>${esc(A.label)}</th><th>${esc(B.label)}</th>
    <th>${L("الفرق","Difference")}</th><th>${L("الفرق %","Difference %")}</th><th>${L("الأفضل","Better")}</th></tr></thead><tbody>${rows}</tbody></table>
  </div>

  ${best?insCard({lv:"key", h:`${L("أكبر فرق بين الطبيبين يظهر في:","The largest gap between the two doctors appears in:")} ${best.l}`,
    e:`${A.label}: ${n2(best.va)} ${L("مقابل","vs")} ${B.label}: ${n2(best.vb)}${L("، أي فارق",", a difference of")} ${best.pct>0?"+":""}${n0(best.pct)}%.`,
    c:L("البيانات المتاحة توضح وجود الفرق، ولا تكفي لتحديد سببه. لا توجد حقول عن نوع الحالة أو مدة الكشف أو مصدر الإحالة.","The available data shows the gap exists but cannot explain its cause. There are no fields for case type, consultation length or referral source.")}):""}`;
}

function pageBench(recs, sm){
  const key = state.metric;
  const bm = benchmark(sm, key);
  const names = {seenPerHour:L("مراجعون لكل ساعة","Visitors per hour"), utilization:L("استغلال الطاقة %","Capacity utilization %"), fillRate:L("ملء المواعيد %","Fill rate %"),
                 attendanceRate:L("نسبة الحضور","Attendance rate"), bookedPerHour:L("كثافة الحجز لكل ساعة","Booking density per hour")};
  const cmp = bm.filter(d=>d.comparable).sort((a,b)=>a[key]-b[key]);
  const mean = cmp.length? cmp.reduce((s,d)=>s+d[key],0)/cmp.length : 0;
  const dots = bm.filter(d=>d.booked>0).sort((a,b)=>a.attendanceRate-b.attendanceRate)
    .map(d=>({label:d.label, value:d.attendanceRate, low:d.ciLow, high:d.ciHigh}));
  const pts = bm.filter(d=>d.comparable).map(d=>({x:d.bookedPerHour,y:d.attendanceRate,r:d.hours,label:d.label}));
  const dept = byDept(sm);

  const cmpAll = bm.filter(d=>d.comparable);
  const rows = bm.map(d=>`<tr><td>${esc(d.label)}</td><td>${esc(d.deptAr)}</td><td>${esc(d.typeAr)}</td>
    <td class="mono">${n0(d.hours)}</td><td class="mono">${n0(d.seen)}</td><td class="mono">${n2(d[key])}</td>
    <td><span class="pill ${d.position===L("أعلى من المجموعة","above the group")?"up":d.position===L("أقل من المجموعة","below the group")?"dn":"mid"}">${esc(d.position)}</span></td>
    <td class="mono">${d.vsGroup==null?"—":(d.vsGroup>0?"+":"")+n0(d.vsGroup)+"%"}</td></tr>`).join("");

  const rank = [...bm].sort((a,b)=>(b.seenPerHour||-1)-(a.seenPerHour||-1));
  const rankRows = rank.map((d,i)=>`<tr>
    <td class="mono">${d.comparable?i+1:"—"}</td>
    <td><b>${esc(d.label)}</b><div style="margin-top:4px">${chips(perfLabels(d,cmpAll))}</div></td>
    <td class="mono">${n2(d.seenPerHour)}</td><td class="mono">${pc(d.attendanceRate)}</td>
    <td class="mono">${pc(d.fillRate)}</td><td class="mono">${pc(d.utilization)}</td>
    <td class="mono">${pc(d.noShowRate)}</td><td class="mono">${pc(d.walkShare)}</td>
    <td class="mono">${n0(d.hours)}</td></tr>`).join("");

  return `
  <div class="card" style="margin-bottom:14px">
    <div class="ct">${L("ترتيب الأطباء","Doctor ranking")}</div>
    <div class="cs">${L("مرتب حسب المراجعين لكل ساعة. من عينته صغيرة بلا رقم ترتيب.","Ordered by visitors per hour. Doctors with a small sample carry no rank number.")}</div>
    <div style="overflow-x:auto"><table><thead><tr><th>#</th><th>${L("الطبيب","Doctor")}</th><th>مراجعون/ساعة</th>
    <th>${L("الحضور","Attendance")}</th><th>${L("ملء المواعيد","Fill rate")}</th><th>${L("استغلال الطاقة","Capacity utilization")}</th><th>${L("عدم الحضور","No-shows")}</th><th>${L("بلا موعد","Walk-ins")}</th><th>${L("ساعات","Hours")}</th>
    </tr></thead><tbody>${rankRows}</tbody></table></div>
    <div class="cap">${L("مؤشرات تشغيلية، ليست تقييمًا للأداء الطبي.","Operational indicators, not an assessment of clinical performance.")}</div>
  </div>

  <div class="card" style="margin-bottom:14px">
    <label>${L("مؤشر المقارنة","Comparison metric")}</label>
    <select id="selMetric">${Object.entries(names).map(([k,v])=>
      `<option value="${k}" ${k===key?"selected":""}>${v}</option>`).join("")}</select>
  </div>

  <div class="card">
    <div class="ct">${names[key]} — ${L("الترتيب مقابل متوسط المجموعة","ranking against the group average")}</div>
    <div class="cs">${L("يُستبعد من لم يبلغ","Excluded below")} ${MIN_BOOKINGS} ${L("حجزًا و","bookings and")}${MIN_HOURS} ${L("ساعات","Hours")}</div>
    ${hBarOverlay(cmp.map(d=>({label:d.label, back:d[key], front:d[key]})),
                  {mean:mean, meanLabel:L("المتوسط","Average")+n2(mean)})}
  </div>

  <div class="grid g2" style="margin-top:14px">
    <div class="card">
      <div class="ct">${L("نسبة الحضور بفاصل ثقة 95%","Attendance rate with a 95% confidence interval")}</div>
      <div class="cs">${L("الفاصل العريض = عينة صغيرة","a wide interval means a small sample")}</div>
      ${dotCI(dots)}
    </div>
    <div class="card">
      <div class="ct">${L("كثافة الحجز مقابل نسبة الحضور","Booking density vs attendance rate")}</div>
      <div class="cs">${L("حجم الدائرة = عدد ساعات العيادة","circle size = number of clinic hours")}</div>
      ${scatter(pts,L("حجوزات لكل ساعة","Bookings per hour"),L("نسبة الحضور %","Attendance rate %"))}
    </div>
  </div>

  <div class="card" style="margin-top:14px">
    <div class="ct">${L("موقع كل طبيب","position of each doctor")}</div>
    <table><thead><tr><th>${L("الطبيب","Doctor")}</th><th>${L("القسم","Department")}</th><th>${L("النوع","Type")}</th><th>${L("الساعات","Hours")}</th>
    <th>${L("المراجعون","Visitors")}</th><th>${names[key]}</th><th>${L("الموقع","Position")}</th><th>${L("مقابل المتوسط","vs average")}</th></tr></thead>
    <tbody>${rows}</tbody></table>
  </div>

  <div class="assume" style="margin-top:14px">${L("المقارنة مع كل الأطباء وليس مع التخصص، لأن أغلب الأقسام فيها طبيب واحد.","Comparison is against all doctors rather than the specialty, because most departments have a single doctor.")}</div>

  <div class="card" style="margin-top:14px">
    <div class="ct">${L("الأقسام","Departments")}</div>
    <div class="cs">${L("الرمادي = قسم بطبيب واحد، لا يمثل التخصص","grey = a department with one doctor, not representative of the specialty")}</div>
    ${vBars(dept.map(d=>d.deptAr),[{name:L("مراجعون/ساعة","Visitors/hour"),color:C.teal,
      values:dept.map(d=>d.seenPerHour)}],{height:300})}
  </div>`;
}

function pageDept(recs, sm){
  const g = byDept(sm);
  if(!g.length) return `<div class="card">${L("لا توجد بيانات ضمن التصفية الحالية.","No data under the current filters.")}</div>`;
  const withCap = g.map(x=>{
    const docs = sm.filter(d=>d.hasData && d.deptAr===x.deptAr);
    const cap = docs.reduce((a,d)=>a+(d.capacity||0),0);
    return {...x, capacity:cap, fillRate: cap? x.booked/cap*100 : null,
            utilization: cap? x.seen/cap*100 : null, docsList:docs};
  });
  const sel = state.deptSel && withCap.find(x=>x.deptAr===state.deptSel);

  const rows = withCap.map(x=>`<tr class="click ${state.deptSel===x.deptAr?"on":""}" data-dept="${esc(x.deptAr)}">
    <td><b>${esc(x.deptAr)}</b>${x.single?' <span class="tag">${L("طبيب واحد","one doctor")}</span>':""}</td>
    <td class="mono">${n0(x.doctors)}</td><td class="mono">${n0(x.hours)}</td>
    <td class="mono">${n0(x.capacity)}</td><td class="mono">${n0(x.booked)}</td>
    <td class="mono">${n0(x.attended)}</td><td class="mono">${n0(x.noShows)}</td>
    <td class="mono">${n0(x.walkIns)}</td><td class="mono">${pc(x.attendanceRate)}</td>
    <td class="mono">${pc(x.fillRate)}</td><td class="mono">${pc(x.utilization)}</td>
    <td class="mono">${n2(x.seenPerHour)}</td></tr>`).join("");

  const detail = sel ? `
    <div class="card" style="margin-top:14px">
      <div class="ct">${esc(sel.deptAr)} — ${L("تفاصيل الأطباء","Doctor details")}</div>
      <div class="cs">${sel.doctors} ${L("طبيب ·","doctors ·")} ${n0(sel.hours)} ${L("ساعة ·","hours ·")} ${n0(sel.capacity)} ${L("موعدًا متاحًا","available appointments")}</div>
      <table><thead><tr><th>${L("الطبيب","Doctor")}</th><th>${L("أيام","Days")}</th><th>${L("ساعات","Hours")}</th><th>${L("الطاقة","Capacity")}</th><th>${L("حجوزات","Bookings")}</th>
      <th>${L("حضور","Attended")}</th><th>بلا موعد</th><th>${L("الحضور %","Attendance %")}</th><th>${L("الملء %","Fill %")}</th><th>${L("الاستغلال %","Utilization %")}</th><th>مراجعون/ساعة</th></tr></thead>
      <tbody>${sel.docsList.map(d=>`<tr><td>${esc(d.label)}</td><td class="mono">${d.days}</td>
        <td class="mono">${n0(d.hours)}</td><td class="mono">${n0(d.capacity)}</td>
        <td class="mono">${n0(d.booked)}</td><td class="mono">${n0(d.attended)}</td>
        <td class="mono">${n0(d.walkIns)}</td><td class="mono">${pc(d.attendanceRate)}</td>
        <td class="mono">${pc(d.fillRate)}</td><td class="mono">${pc(d.utilization)}</td>
        <td class="mono">${n2(d.seenPerHour)}</td></tr>`).join("")}</tbody></table>
      ${sel.single?`<div class="assume" style="margin-top:12px">${L("القسم فيه طبيب واحد، فأرقامه تمثله هو.","This department has one doctor, so its figures represent that doctor.")}</div>`:""}
    </div>` : `<div class="cap" style="margin-top:10px">${L("اضغط على قسم لعرض أطبائه.","Tap a department to see its doctors.")}</div>`;

  return `
  <div class="card">
    <div class="ct">${L("مقارنة الأقسام","Department comparison")}</div>
    <div class="cs">${L("اضغط على القسم لعرض التفاصيل","tap a department for details")}</div>
    <div style="overflow-x:auto"><table><thead><tr><th>${L("القسم","Department")}</th><th>${L("أطباء","Doctors")}</th><th>${L("ساعات","Hours")}</th><th>${L("الطاقة","Capacity")}</th>
    <th>${L("حجوزات","Bookings")}</th><th>${L("حضور","Attended")}</th><th>عدم ${L("حضور","Attended")}</th><th>بلا موعد</th><th>${L("الحضور %","Attendance %")}</th><th>${L("الملء %","Fill %")}</th>
    <th>${L("الاستغلال %","Utilization %")}</th><th>مراجعون/ساعة</th></tr></thead><tbody>${rows}</tbody></table></div>
  </div>
  ${detail}

  <div class="grid g2" style="margin-top:14px">
    <div class="card"><div class="ct">${L("الإنتاجية لكل ساعة حسب القسم","Productivity per hour by department")}</div>
      ${vBars(withCap.map(x=>x.deptAr),[{name:L("مراجعون/ساعة","Visitors/hour"),color:C.teal,values:withCap.map(x=>x.seenPerHour)}],{height:320})}
      <div class="cap">${L("القسم بطبيب واحد يمثل ذلك الطبيب.","A single-doctor department represents that doctor.")}</div></div>
    <div class="card"><div class="ct">${L("الملء مقابل الاستغلال حسب القسم","Fill rate vs utilization by department")}</div>
      ${vBars(withCap.map(x=>x.deptAr),[
        {name:L("ملء %","Fill %"),color:C.ochre,values:withCap.map(x=>x.fillRate)},
        {name:L("استغلال %","Utilization %"),color:C.teal,values:withCap.map(x=>x.utilization)}],{height:320})}
      ${legend([{c:C.ochre,t:L("ملء المواعيد","Fill rate")},{c:C.teal,t:L("استغلال الطاقة","Capacity utilization")}])}</div>
  </div>

  <div class="card" style="margin-top:14px">
    <div class="ct">${L("تركيبة المراجعين حسب القسم","Visitor mix by department")}</div>
    ${stackedBars(withCap.map(x=>x.deptAr),[
      {name:L("حضور بموعد","Attended"),color:C.teal,values:withCap.map(x=>x.attended)},
      {name:L("عدم حضور","No-shows"),color:C.terra,values:withCap.map(x=>x.noShows)},
      {name:L("بلا موعد","Walk-ins"),color:C.sage,values:withCap.map(x=>x.walkIns)}],{height:330})}
    ${legend([{c:C.teal,t:L("حضور بموعد","Attended")},{c:C.terra,t:L("عدم حضور","No-shows")},{c:C.sage,t:L("بلا موعد","Walk-ins")}])}
  </div>`;
}

function pageInsights(recs, sm, bm, t){
  const m = weekdayMatrix(recs);
  return `
  <h2 class="sec" style="margin-top:0">${L("الاستنتاجات","Insights")}</h2>
  ${insights(sm,bm,t).map(insCard).join("")}
  <h2 class="sec">${L("التوصيات","Recommendations")}</h2>
  <div class="cs">${L("كل توصية ومعها الرقم الذي أنتجها.","Each recommendation with the figure that produced it.")}</div>
  ${recommendations(bm).map(recCard).join("")}
  <h2 class="sec">${L("نمط أيام الأسبوع","Weekday pattern")}</h2>
  <div class="card">
    <div class="ct">${L("المراجعون لكل ساعة حسب يوم الأسبوع","Visitors per hour by weekday")}</div>
    <div class="cs">${L("الخلايا الفارغة = لا عيادة في ذلك اليوم","empty cells = no clinic that day")}</div>
    <div style="overflow-x:auto">${m.names.length?heatmap(m):L("لا توجد بيانات","No data")}</div>
  </div>`;
}

function pageSim(recs, sm, bm, t){
  const cmp = bm.filter(d=>d.comparable);
  if(!cmp.length) return `<div class="card">${L("لا يوجد طبيب تجاوز حد المقارنة ضمن التصفية الحالية.","No doctor passes the comparison threshold under the current filters.")}</div>`;
  if(!state.scenDoc || !cmp.some(d=>d.name===state.scenDoc)) { state.scenDoc = cmp[0].name; state.scenVal=null; }
  const d = cmp.find(x=>x.name===state.scenDoc);

  let val, after, assume, ctrl;
  if(state.scen==="density"){
    val = state.scenVal!=null ? state.scenVal : Math.round(d.bookedPerHour*100)/100;
    after = scDensity(d,val);
    const maxDens = 60/(d.slot||15);
    ctrl = `<input class="slider" type="range" id="sl" min="0.5" max="${maxDens}" step="0.25" value="${Math.min(val,maxDens)}">
            <div class="cs">${L("حجوزات لكل ساعة:","Bookings per hour:")} <b class="mono">${n2(val)}</b> (الحالي ${n2(d.bookedPerHour)} · ${L("الحد الأقصى","maximum")} ${n2(maxDens)} ${L("بمدة موعد","at an appointment length of")} ${d.slot} ${L("دقيقة)","minutes)")}</div>`;
    assume = `${L("ثبات نسبة الحضور عند","Attendance rate held at")} ${pc(d.attendanceRate)} ${L("وثبات المراجعين بلا موعد عند","and walk-ins held at")} ${n2(d.walkIns/d.hours)} ${L("لكل ساعة. خفض الحجز يقلل المتخلفين لكنه يترك مواعيد فارغة بدلهم، فالطاقة لا تتحسن. استرجاع الوقت يحتاج رفع الحضور نفسه.","per hour. Cutting bookings reduces no-shows but leaves empty slots in their place, so capacity does not improve. Recovering time requires raising attendance itself.")}`;
  } else if(state.scen==="lift"){
    val = state.scenVal!=null ? state.scenVal : 10;
    after = scLift(d,val);
    ctrl = `<input class="slider" type="range" id="sl" min="0" max="40" step="5" value="${val}">
            <div class="cs">${L("نقاط مئوية إضافية على نسبة الحضور:","Additional percentage points on the attendance rate:")} <b class="mono">+${val}</b>
            (${L("من","from")} ${pc(d.attendanceRate)} ${L("إلى","to")} ${pc(Math.min(100,d.attendanceRate+val))})</div>`;
    assume = L("ثبات عدد الحجوزات والساعات، والتغيير فقط في نسبة من يحضر.","Bookings and hours held constant; only the share who attend changes.");
  } else {
    val = state.scenVal!=null ? state.scenVal : d.days;
    after = scDays(d,val);
    ctrl = `<input class="slider" type="range" id="sl" min="1" max="12" step="1" value="${val}">
            <div class="cs">${L("عدد أيام العيادة:","Number of clinic days:")} <b class="mono">${val}</b> (الحالي ${d.days})</div>`;
    assume = `${L("تكرار نمط اليوم الواحد الحالي (","Repeating the current single-day pattern (")}${d.hoursPerDay} ${L("ساعات) على العدد الجديد.","hours) across the new count.")}`;
  }

  const keys = [["booked",L("الحجوزات","Bookings")],["seen",L("المراجعون","Visitors")],["noShows",L("عدم الحضور","No-shows")],
                ["utilization",L("استغلال الطاقة %","Capacity utilization %")],["wastedHours",L("ساعات ضائعة","Lost hours")],
                ["unusedHours",L("طاقة غير مستغلة (ساعة)","Unused capacity (hours)")]];
  const before = {booked:d.booked, seen:d.seen, noShows:d.noShows,
                  seenPerHour:d.seenPerHour, wastedHours:d.noShowHours,
                  utilization:d.utilization, unusedHours:d.unusedHours, capacity:d.capacity};
  const mins=(d.slot||15)/60;
  after.wastedHours = after.noShows*mins;
  after.capacity = after.hours!=null ? after.hours*60/(d.slot||15) : d.capacity;
  after.utilization = after.capacity? after.seen/after.capacity*100 : null;
  after.unusedHours = Math.max(0, (after.hours!=null?after.hours:d.hours) - after.seen*mins);

  const opts = cmp.map(x=>`<option value="${esc(x.name)}" ${x.name===state.scenDoc?"selected":""}>${esc(x.label)}</option>`).join("");
  const scens = [["density",L("تغيير كثافة الحجز","Change booking density")],["lift",L("تحسين نسبة الحضور","Improve attendance rate")],["days",L("تغيير عدد أيام العيادة","Change number of clinic days")]];

  return `
  <div class="mock" style="margin-bottom:14px">${L("محاكاة حسابية وليست توقعًا. تعيد حساب الأرقام على افتراض ثبات نسبة الحضور الحالية لكل طبيب.","An arithmetic simulation, not a forecast. It recomputes the figures assuming each doctor's current attendance rate holds.")}</div>

  <div class="card" style="margin-bottom:14px">
    <span><label>${L("الطبيب","Doctor")}</label><select id="selSim">${opts}</select></span>
    <span style="margin-inline-start:14px"><label>السيناريو</label>
      <select id="selScen">${scens.map(([k,v])=>`<option value="${k}" ${k===state.scen?"selected":""}>${v}</option>`).join("")}</select></span>
    <div style="margin-top:14px">${ctrl}</div>
  </div>

  <div class="grid g4">
    ${keys.map(([k,l])=>{const df=after[k]-before[k];
      return kpiCard(l, n1(after[k]), `الحالي ${n1(before[k])} · ${df>0?"+":""}${n1(df)}`,
        (k==="noShows"||k==="wastedHours") && df>0.05);}).join("")}
  </div>

  <div class="card" style="margin-top:14px">
    <div class="ct">${L("الوضع الحالي مقابل السيناريو —","Current state vs scenario —")} ${esc(d.label)}</div>
    ${vBars(keys.map(k=>k[1]),
      [{name:L("الحالي","current"),color:C.line,values:keys.map(k=>before[k[0]])},
       {name:L("السيناريو","Scenario"),color:C.teal,values:keys.map(k=>after[k[0]])}],{height:320})}
    ${legend([{c:C.line,t:L("الوضع الحالي","Current")},{c:C.teal,t:L("السيناريو المقترح","Scenario")}])}
    <div class="assume" style="margin-top:10px">${assume}</div>
  </div>

  <div class="rec" style="margin-top:14px">
    <div class="a">${L("الأثر على مستوى المنشأة","Facility-level impact")}</div>
    <div class="row">${L("إجمالي المراجعين ينتقل من","Total visitors move from")} <b class="mono">${n0(t.seen)}</b> ${L("إلى","to")}
    <b class="mono">${n0(t.seen + (after.seen-before.seen))}</b>${L("، والساعات المهدرة من",", and wasted hours from")}
    <b class="mono">${n0(t.wasted)}</b> ${L("إلى","to")} <b class="mono">${n0(t.wasted + (after.wastedHours-before.wastedHours))}</b>
    ${L("من أصل","out of")} ${n0(t.hours)} ${L("ساعة.","hours.")}</div>
  </div>`;
}

function pageTime(recs){
  const months = uniq(recs.map(r=>r.month)).sort();
  if(months.length>=2){
    const rows = months.map(m=>{
      const rs=recs.filter(r=>r.month===m);
      const b=sum(rs,r=>r.booked), a=sum(rs,r=>r.attended);
      return {m, booked:b, seen:sum(rs,r=>r.seen), rate: b? a/b*100 : 0};
    });
    const last=rows[rows.length-1], prev=rows[rows.length-2];
    const dRate=last.rate-prev.rate, dSeen=last.seen-prev.seen;
    return `<div class="banner"><div class="q">${L("مقارنة الشهر الأخير بما قبله","Latest month compared with the one before")}</div>
      <div class="a">المراجعون ${dSeen>=0?L("ارتفعوا","rose"):L("انخفضوا","fell")} ${L("بمقدار","by")} <b>${n0(Math.abs(dSeen))}</b>${L("، ونسبة الحضور",", and the attendance rate")} ${dRate>=0?L("ارتفعت","rose"):L("انخفضت","fell")} ${L("بمقدار","by")} <b>${n1(Math.abs(dRate))}</b> ${L("نقطة.","points.")}</div></div>
    <div class="card">
      <div class="ct">${L("التغيّر الشهري","Monthly change")}</div>
      ${vBars(rows.map(r=>r.m),[{name:L("الحجوزات","Bookings"),color:C.line,values:rows.map(r=>r.booked)},
        {name:L("المراجعون","Visitors"),color:C.teal,values:rows.map(r=>r.seen)}],{height:340})}
      ${legend([{c:C.line,t:L("الحجوزات","Bookings")},{c:C.teal,t:L("المراجعون","Visitors")}])}</div>
      <div class="card" style="margin-top:14px"><div class="ct">${L("نسبة الحضور شهريًا","Monthly attendance rate")}</div>
      ${vBars(rows.map(r=>r.m),[{name:L("نسبة الحضور","Attendance rate"),color:C.terra,values:rows.map(r=>r.rate)}],{height:300})}</div>`;
  }
  // شهر واحد: تقسيم أسبوعي حقيقي
  const weeks = {};
  recs.forEach(r=>{
    const day = new Date(r.date+"T00:00:00").getDate();
    const w = "الأسبوع " + (Math.floor((day-1)/7)+1);
    weeks[w] = weeks[w] || {booked:0,attended:0,seen:0,days:new Set()};
    weeks[w].booked+=r.booked; weeks[w].attended+=r.attended; weeks[w].seen+=r.seen; weeks[w].days.add(r.date);
  });
  const ks = Object.keys(weeks).sort();
  const rate = ks.map(k=> weeks[k].booked? weeks[k].attended/weeks[k].booked*100 : 0);
  return `
  <div class="mock" style="margin-bottom:14px"><b>${L("الفترة المتاحة شهر واحد فقط (","The available period is a single month (")}${months[0]||"—"}).</b>
  ${L("لا يمكن حساب اتجاه زمني حقيقي منه، فالرسم أدناه يستخدم التقسيم الأسبوعي داخل الشهر. يتحول إلى مقارنة شهرية عند إضافة شهر ثانٍ.","A real time trend cannot be computed from it, so the chart below uses weekly splits inside the month. It switches to a monthly comparison once a second month is added.")}</div>
  <div class="card" style="margin-bottom:14px">
    <div class="ct">${L("ما الذي يصبح متاحًا عند توفر أشهر إضافية","What becomes available with more months")}</div>
    <table><tbody>
    <tr><td>${L("مقارنة شهر بشهر (Month over Month)","Month-over-month comparison")}</td><td class="tag">${L("غير متاح حاليًا","Not available yet")}</td></tr>
    <tr><td>${L("اتجاه نسبة الحضور","Attendance rate trend")}</td><td class="tag">${L("غير متاح حاليًا","Not available yet")}</td></tr>
    <tr><td>${L("اتجاه عدم الحضور","No-show trend")}</td><td class="tag">${L("غير متاح حاليًا","Not available yet")}</td></tr>
    <tr><td>${L("اتجاه استغلال الطاقة","Capacity utilization trend")}</td><td class="tag">${L("غير متاح حاليًا","Not available yet")}</td></tr>
    <tr><td>${L("اتجاه الإنتاجية لكل ساعة","Productivity per hour trend")}</td><td class="tag">${L("غير متاح حاليًا","Not available yet")}</td></tr>
    <tr><td>${L("اكتشاف الشذوذ الموسمي","Seasonal anomaly detection")}</td><td class="tag">${L("غير متاح حاليًا","Not available yet")}</td></tr>
    </tbody></table>
    <div class="cap">${L("تعمل تلقائيًا عند إضافة شهر ثانٍ.","These activate automatically once a second month is added.")}</div>
  </div>
  <div class="grid g2">
    <div class="card"><div class="ct">${L("الحجوزات مقابل المراجعين أسبوعيًا","Weekly bookings vs visitors")}</div>
      ${vBars(ks,[{name:L("الحجوزات","Bookings"),color:C.line,values:ks.map(k=>weeks[k].booked)},
        {name:L("المراجعون","Visitors"),color:C.teal,values:ks.map(k=>weeks[k].seen)}],{height:320})}
      ${legend([{c:C.line,t:L("الحجوزات","Bookings")},{c:C.teal,t:L("المراجعون","Visitors")}])}</div>
    <div class="card"><div class="ct">${L("نسبة الحضور أسبوعيًا","Weekly attendance rate")}</div>
      ${vBars(ks,[{name:L("نسبة الحضور","Attendance rate"),color:C.terra,values:rate}],{height:320})}
      <div class="cap">${L("الأسابيع غير متساوية في عدد الأيام","weeks differ in number of days")}</div></div>
  </div>`;
}

function pageDQ(recs, sm){
  const cols = {"حرج":C.terra,"تنبيه":C.ochre,"منهجي":C.teal,"معلومة":C.muted};
  const gaps = [[L("وقت بداية ونهاية الموعد","Appointment start and end time"),L("خريطة حرارية بالساعة، ذروة الازدحام، وقت الانتظار","Hourly heatmap, peak congestion, waiting time")],
    [L("رقم العيادة أو الغرفة","Clinic or room number"),L("مقارنة عيادة بعيادة، وتعارض استخدام الغرف","Clinic-to-clinic comparison and room conflicts")],
    [L("حالة الحجز: ملغي أم متخلف","Booking status: cancelled or no-show"),L("فصل عدم الحضور القابل للتدارك عن غير القابل","Separating recoverable no-shows from unrecoverable ones")],
    [L("ملفات الأشهر السابقة","Previous months' files"),L("الاتجاه الزمني، اكتشاف الشذوذ، ومقارنة فترة بفترة","Time trend, anomaly detection and period-to-period comparison")]];
  return `
  <div class="cs">${L("هذه الملاحظات تؤثر على كل الأرقام.","These notes affect every figure.")}</div>
  ${quality(recs,sm).map(q=>`<div class="ins" style="border-right-color:${cols[q.lv]||C.muted}">
    <div class="h">${esc(q.t)} <span class="pill">${esc(q.lv)}</span></div>
    <div class="e">${esc(q.d)}</div><div class="c">${esc(q.i)}</div></div>`).join("")}

  <h2 class="sec">${L("حدود التحليل — Data Limitations","Analysis limits — Data Limitations")}</h2>
  <div class="card">
    <table><tbody>
    <tr><td>${L("تحديد سبب عدم الحضور","Determining the cause of a no-show")}</td><td class="tag">غير متاح حاليًا</td><td style="color:var(--muted)">${L("لا يوجد حقل يفرّق بين الإلغاء والتخلّف","No field distinguishes a cancellation from a no-show")}</td></tr>
    <tr><td>${L("ذروة الازدحام خلال اليوم","Peak congestion during the day")}</td><td class="tag">غير متاح حاليًا</td><td style="color:var(--muted)">${L("أوقات المواعيد غير مسجّلة","Appointment times are not recorded")}</td></tr>
    <tr><td>${L("مقارنة عيادة بعيادة","Clinic-to-clinic comparison")}</td><td class="tag">غير متاح حاليًا</td><td style="color:var(--muted)">${L("لا يوجد رقم عيادة أو غرفة","No clinic or room number")}</td></tr>
    <tr><td>${L("اتجاه زمني عبر الأشهر","Time trend across months")}</td><td class="tag">غير متاح حاليًا</td><td style="color:var(--muted)">${L("شهر واحد فقط في الملف","Only one month in the file")}</td></tr>
    <tr><td>${L("اكتشاف الشذوذ إحصائيًا","Statistical anomaly detection")}</td><td class="tag">غير متاح حاليًا</td><td style="color:var(--muted)">${L("حجم العينة أصغر من أن يعطي نتيجة موثوقة","The sample is too small for a reliable result")}</td></tr>
    <tr><td>${L("متوسط التخصص كمرجع","Specialty average as a benchmark")}</td><td class="tag">محدود</td><td style="color:var(--muted)">${L("أغلب الأقسام بها طبيب واحد","Most departments have a single doctor")}</td></tr>
    </tbody></table>
    <div class="cap">${L("ما هو «غير متاح» لا يُحسب في أي صفحة.","Anything marked “not available” is not counted on any page.")}</div>
  </div>

  <h2 class="sec">${L("جاهزية البيانات — Data Readiness","Data readiness — Data Readiness")}</h2>
  <div class="grid g2">
    <div class="card">
      <div class="ct">${L("البيانات المتوفرة حاليًا","Data currently available")}</div>
      <div class="cs">${L("أساس كل رقم هنا","the basis of every figure here")}</div>
      <table><tbody>
      <tr><td>${L("اسم الطبيب والقسم ونوعه","Doctor name, department and type")}</td><td><span class="chip up">${TW("متوفر")}</span></td></tr>
      <tr><td>${L("تاريخ يوم العيادة","Clinic date")}</td><td><span class="chip up">${TW("متوفر")}</span></td></tr>
      <tr><td>${L("عدد الحجوزات","Number of bookings")}</td><td><span class="chip up">${TW("متوفر")}</span></td></tr>
      <tr><td>${L("عدد الحضور بموعد","Number attended with appointment")}</td><td><span class="chip up">${TW("متوفر")}</span></td></tr>
      <tr><td>${L("عدد الدخول بلا موعد","Number of walk-ins")}</td><td><span class="chip up">${TW("متوفر")}</span></td></tr>
      <tr><td>${L("ساعات العيادة اليومية","Daily clinic hours")}</td><td><span class="chip up">${TW("متوفر")}</span></td></tr>
      <tr><td>${L("مدة الموعد (Slot Length)","Appointment length (slot length)")}</td><td><span class="chip up">${TW("متوفر")}</span></td></tr>
      </tbody></table>
    </div>
    <div class="card">
      <div class="ct">${L("بيانات لو توفرت لرفعت دقة التحليل","Data that would improve accuracy if available")}</div>
      <div class="cs">${L("لا تدخل في الحسابات الحالية","not used in current calculations")}</div>
      <table><tbody>
      <tr><td>${L("رقم العيادة أو الغرفة","Clinic or room number")}</td><td><span class="chip dn">${TW("غير متوفر")}</span></td></tr>
      <tr><td>${L("الإلغاء مقابل عدم الحضور","Cancellation vs no-show")}</td><td><span class="chip dn">${TW("غير متوفر")}</span></td></tr>
      <tr><td>${L("بيانات الأشهر السابقة","Previous months' data")}</td><td><span class="chip dn">${TW("غير متوفر")}</span></td></tr>
      </tbody></table>
    </div>
  </div>

  <h2 class="sec">${L("ما الذي يفتحه كل حقل إضافي","What each additional field unlocks")}</h2>
  <div class="card"><table><thead><tr><th>${L("الحقل الناقص","Missing field")}</th><th>${L("ما الذي يصبح ممكنًا","What becomes possible")}</th></tr></thead>
  <tbody>${gaps.map(g=>`<tr><td>${g[0]}</td><td>${g[1]}</td></tr>`).join("")}</tbody></table></div>

  <h2 class="sec">${L("الخصوصية","Privacy")}</h2>
  <div class="rec"><div class="row">${L("المنصة تقرأ خمسة حقول فقط: الطبيب، التاريخ، عدد الحجوزات، عدد الحضور، وعدد الدخول بلا موعد. لا تتضمن أي اسم مريض، ولا رقم ملف، ولا تشخيص، ولا أي بيان صحي شخصي. ساعات العيادة ومدة الموعد بيانات تشغيلية عن الطبيب لا عن المريض.","The platform reads five fields only: doctor, date, number of bookings, number attended and number of walk-ins. It contains no patient name, file number, diagnosis or any personal health data. Clinic hours and appointment length are operational data about the doctor, not the patient.")}</div></div>`;
}

