    <button class="ghost" id="cfExport">${L("تصدير الإعدادات","Export settings")}</button>
    <label class="ghost fileLbl">${L("استيراد","Import")}<input type="file" id="cfImport" accept="application/json" hidden></label>
    <button class="ghost danger" id="cfReset">${L("استعادة الافتراضي","Restore defaults")}</button>
    <span id="cfMsg" class="cfmsg"></span>
  </div>

  `;
}

function readCfgForm(){
  const g = id => $(id);
  const c = JSON.parse(JSON.stringify(CFG));
  if(g("cfBrand")) c.brand = g("cfBrand").value.trim() || CFG_DEFAULT.brand;
  if(g("cfTag")) c.tagline = g("cfTag").value.trim();
  if(g("cfTitle")) c.titleAr = g("cfTitle").value.trim();
  if(g("cfAccent")) c.accent = g("cfAccent").value;
  if(g("cfNavy")) c.navy = g("cfNavy").value;
  if(g("cfAzure")) c.azure = g("cfAzure").value;
  if(g("cfBgO")) c.bgOpacity = +g("cfBgO").value;
  if(g("cfUtil")) c.ai.utilLow = +g("cfUtil").value;
  if(g("cfNS")) c.ai.noShowHigh = +g("cfNS").value;
  if(g("cfFill")) c.ai.fillLow = +g("cfFill").value;
  if(g("cfFc")) c.ai.forecast = g("cfFc").checked;
  if(g("cfHz")) c.ai.horizon = +g("cfHz").value;
  c.hidden = [...document.querySelectorAll("[data-sec]")].filter(x=>!x.checked).map(x=>x.dataset.sec);
  return c;
}
function cfMsg(txt, ok){
  const m=$("cfMsg"); if(!m) return;
  m.textContent = txt; m.className = "cfmsg " + (ok?"ok":"err");
  setTimeout(()=>{ if($("cfMsg")) $("cfMsg").textContent=""; }, 3500);
}
function fileToDataUrl(file, cb){
  const r = new FileReader();
  r.onload = () => cb(r.result);
  r.readAsDataURL(file);
}
function bindAdmin(){
  if(!isAdmin() || !$("cfSave")) return;
  $("cfPreview").onclick = ()=>{ applyCfg(readCfgForm()); cfMsg(L("معاينة مؤقتة — لم تُحفظ بعد","Temporary preview — not saved yet"), true); };
  $("cfClearImg").onclick = ()=>{ CFG.logo=""; CFG.bgImage=""; CFG.heroImage="";
    applyCfg(); render(); cfMsg(L("أُزيلت الصور — اضغطي حفظ","Images removed — press Save"), true); };
  $("cfHeroF").onchange = e => e.target.files[0] && fileToDataUrl(e.target.files[0], d=>{ CFG.heroImage=d; });
  $("cfLogoF").onchange = e => e.target.files[0] && fileToDataUrl(e.target.files[0], d=>{ CFG.logo=d; applyCfg(); });
  $("cfBgF").onchange  = e => e.target.files[0] && fileToDataUrl(e.target.files[0], d=>{ CFG.bgImage=d; applyCfg(); });
  $("cfBgO").oninput = ()=> applyCfg(readCfgForm());

  $("cfSave").onclick = async ()=>{
    const c = readCfgForm();
    const pw = $("cfPw") ? $("cfPw").value : "";
    if(pw) c.adminHash = await sha256(pw);
    c.logo = CFG.logo; c.bgImage = CFG.bgImage; c.heroImage = CFG.heroImage; c.clinics = CFG.clinics;
    CFG = c;
    const ok = saveCfg();
    applyCfg(); render();
    cfMsg(ok ? L("حُفظت الإعدادات","Settings saved") : L("تعذّر الحفظ في هذا المتصفح","Could not save in this browser"), ok);
  };
  $("cfExport").onclick = ()=>{
    const blob = new Blob([JSON.stringify(CFG,null,2)], {type:"application/json"});
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob); a.download = "healthiq-settings.json"; a.click();
  };
  $("cfImport").onchange = e => {
    const f = e.target.files[0]; if(!f) return;
    const r = new FileReader();
    r.onload = ()=>{
      try{
        const o = JSON.parse(r.result);
        CFG = {...CFG_DEFAULT, ...o, ai:{...CFG_DEFAULT.ai, ...(o.ai||{})}};
        saveCfg(); applyCfg(); render(); cfMsg(L("استُوردت الإعدادات","Settings imported"), true);
      }catch(err){ cfMsg(L("ملف غير صالح","Invalid file"), false); }
    };
    r.readAsText(f);
  };
  $("cfReset").onclick = ()=>{
    CFG = JSON.parse(JSON.stringify(CFG_DEFAULT));
    saveCfg(); applyCfg(); render(); cfMsg(L("أُعيدت الإعدادات الافتراضية","Defaults restored"), true);
  };
}

/* ============================================================
   HealthIQ — طبقة الصلاحيات والاعتماد
   الأدوار: super (مسؤول أعلى) · user (مستخدم معتمد)
   الحالات: pending · approved · rejected · suspended
   ============================================================ */

const ROLE_SUPER = "super", ROLE_DATA = "data_admin", ROLE_USER = "user";
const ST = {PENDING:"pending", APPROVED:"approved", REJECTED:"rejected", SUSPENDED:"suspended"};

/* ---------- طبقة الوصول عبر الخادم (Supabase) ---------- */
const SB_URL = "https://ayzozncfoswpbttjrzbb.supabase.co";
const SB_KEY = "sb_publishable_Ha0aMJAHJrCgxynWPtHRsw_7DCU_JCF";
let SB_OK = true;   /* يصير false لو تعذّر الاتصال، فنرجع للتخزين المحلي */

function sbHead(extra){
  return Object.assign({
    "apikey": SB_KEY,
    "Authorization": "Bearer " + SB_KEY,
    "Content-Type": "application/json"
  }, extra||{});
}
function sbRow(r){
  return { name: r.full_name, email: r.email, role: r.role, status: r.status,
           requested: (r.requested_at||"").slice(0,16).replace("T"," "),
           decidedBy: r.decision_note||"", decidedAt: (r.decided_at||"").slice(0,16).replace("T"," ") };
}
async function loadUsers(){
  try{
    const res = await fetch(SB_URL+"/rest/v1/app_users?select=*&order=requested_at.desc", {headers: sbHead()});
    if(!res.ok) throw new Error(res.status);
    const rows = await res.json();
    CFG.users = rows.map(sbRow);
    SB_OK = true;
  }catch(e){ SB_OK = false; }
  return CFG.users;
}
async function refreshUsers(){ await loadUsers(); if(state.page==="access") render(); }

function users(){ return Array.isArray(CFG.users) ? CFG.users : (CFG.users = []); }
function findUser(email){
  const e = String(email||"").trim().toLowerCase();
  return users().find(u => String(u.email||"").trim().toLowerCase() === e) || null;
}
function nowIso(){ return new Date().toISOString().slice(0,16).replace("T"," "); }

async function requestAccess(name, email){
  const e = String(email||"").trim().toLowerCase();
  if(!name || !e) return {ok:false, msg:L("الاسم والبريد مطلوبان","Name and email are required")};
  if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(e))
    return {ok:false, msg:L("صيغة البريد غير صحيحة","Invalid email format")};
  await loadUsers();
  const ex = findUser(e);
  if(ex){
    if(ex.status===ST.APPROVED) return {ok:false, msg:L("هذا البريد معتمد بالفعل — سجّلي الدخول","This email is already approved — sign in")};
    if(ex.status===ST.PENDING)  return {ok:false, msg:L("طلبك قيد المراجعة","Your request is under review")};
    if(ex.status===ST.REJECTED) return {ok:false, msg:L("تم رفض هذا الطلب سابقًا","This request was previously rejected")};
    if(ex.status===ST.SUSPENDED)return {ok:false, msg:L("هذا الحساب موقوف","This account is suspended")};
  }
  try{
    const res = await fetch(SB_URL+"/rest/v1/app_users", {
      method:"POST", headers: sbHead({"Prefer":"return=representation"}),
      body: JSON.stringify({ full_name:String(name).trim(), email:e, role:"viewer", status:"pending" })
    });
    if(!res.ok) throw new Error(await res.text());
    await loadUsers();
    return {ok:true, msg:L("أُرسل الطلب. لا يمكن الدخول قبل اعتماد المسؤول.",
                           "Request submitted. Access is not possible until an administrator approves it.")};
  }catch(err){
    return {ok:false, msg:L("تعذّر الاتصال بالخادم. حاولي مرة أخرى.",
                            "Could not reach the server. Please try again.")};
  }
}

async function signInUser(email){
  await loadUsers();
  const u = findUser(email);
  if(!u) return {ok:false, msg:L("لا يوجد طلب بهذا البريد","No request exists for this email")};
  if(u.status===ST.PENDING)   return {ok:false, msg:L("طلبك ما زال قيد المراجعة","Your request is still under review")};
  if(u.status===ST.REJECTED)  return {ok:false, msg:L("هذا الحساب مرفوض","This account was rejected")};
  if(u.status===ST.SUSPENDED) return {ok:false, msg:L("هذا الحساب موقوف","This account is suspended")};
  setRole(u.role === ROLE_DATA ? ROLE_DATA : ROLE_USER, u.email);
  return {ok:true};
}

async function setUserRole(email, role){
  const e = String(email||"").trim().toLowerCase();
  try{
    const res = await fetch(SB_URL+"/rest/v1/app_users?email=eq."+encodeURIComponent(e), {
      method:"PATCH", headers: sbHead({"Prefer":"return=representation"}),
      body: JSON.stringify({ role })
    });
    if(!res.ok) throw new Error(await res.text());
  }catch(err){ SB_OK = false; }
  await loadUsers(); render();
}

async function decide(email, status){
  const e = String(email||"").trim().toLowerCase();
  try{
    const res = await fetch(SB_URL+"/rest/v1/app_users?email=eq."+encodeURIComponent(e), {
      method:"PATCH", headers: sbHead({"Prefer":"return=representation"}),
      body: JSON.stringify({ status: status, decided_at: new Date().toISOString(),
                             decision_note: L("المسؤول الأعلى","Super Admin") })
    });
    if(!res.ok) throw new Error(await res.text());
  }catch(err){ SB_OK = false; }
  await loadUsers();
  render();
}

/* ---------- ما يراه كل دور ---------- */
/* صفحات إدارة النظام والبيانات الخام — للمسؤول الأعلى فقط */
const SUPER_ONLY = ["admin"];                     /* الإعدادات — للمسؤول الأعلى وحده */
const DATA_ONLY  = ["registry","dq","access"];    /* بيانات خام واعتماد — للأعلى ومسؤول البيانات */
function isDataAdmin(){ return ROLE === ROLE_DATA; }
function canSee(k){
  if(isSuper()) return true;
  if(SUPER_ONLY.includes(k)) return false;
  if(DATA_ONLY.includes(k)) return isDataAdmin();
  return !CFG.hidden.includes(k);
}

/* ---------- صفحة طلبات الوصول ---------- */
function pageAccess(){
  if(!isSuper() && !isDataAdmin()) return `<div class="card">${L("هذه الصفحة للمسؤولين فقط.","This page is for administrators only.")}</div>`;
  const us = users();
  const by = st => us.filter(u=>u.status===st);
  const badge = st => ({
    [ST.PENDING]:  `<span class="prio md">${L("قيد المراجعة","Pending")}</span>`,
    [ST.APPROVED]: `<span class="prio ok">${L("معتمد","Approved")}</span>`,
    [ST.REJECTED]: `<span class="prio hi">${L("مرفوض","Rejected")}</span>`,
    [ST.SUSPENDED]:`<span class="prio hi">${L("موقوف","Suspended")}</span>`
  })[st] || st;

  const row = u => `<div class="ucard ${u.status}">
    <div class="uhead">
      <div class="uwho">
        <div class="uname">${esc(u.name)}</div>
        <div class="umail mono">${esc(u.email)}</div>
      </div>
      ${badge(u.status)}
    </div>
    <div class="umeta mono">${esc(u.requested||"—")}${u.decidedAt? " · "+esc(u.decidedBy+" · "+u.decidedAt):""}</div>
    <div class="uacts">
      ${u.status!==ST.APPROVED? `<button class="mini ok" data-ap="${esc(u.email)}">${L("اعتماد","Approve")}</button>`:""}
      ${u.status!==ST.REJECTED? `<button class="mini no" data-rj="${esc(u.email)}">${L("رفض","Reject")}</button>`:""}
      ${u.status===ST.APPROVED? `<button class="mini" data-sp="${esc(u.email)}">${L("إيقاف","Suspend")}</button>`:""}
      ${u.status===ST.APPROVED && isSuper()? `<select class="rolesel" data-role="${esc(u.email)}">
          <option value="viewer" ${u.role!==ROLE_DATA?"selected":""}>${L("مستخدم معتمد","Approved user")}</option>
          <option value="${ROLE_DATA}" ${u.role===ROLE_DATA?"selected":""}>${L("مسؤول بيانات","Data admin")}</option>
        </select>`:""}
    </div>
  </div>`;

  return `
  <div class="banner"><div class="q">${L("طلبات الوصول","Access Requests")}</div>
    </div>

  <div class="grid g4">
    ${kpiCard(L("قيد المراجعة","Pending"), n0(by(ST.PENDING).length), L("بانتظار قرارك","awaiting your decision"), by(ST.PENDING).length>0)}
    ${kpiCard(L("معتمدون","Approved"), n0(by(ST.APPROVED).length), L("يمكنهم الدخول","can sign in"))}
    ${kpiCard(L("مرفوضون","Rejected"), n0(by(ST.REJECTED).length), L("محجوبون","blocked"))}
    ${kpiCard(L("موقوفون","Suspended"), n0(by(ST.SUSPENDED).length), L("معتمدون سابقًا","previously approved"))}
  </div>

  <h2 class="sec">${L("المستخدمون","Users")}</h2>
  ${us.length? `<div class="ulist">
    ${by(ST.PENDING).map(row).join("")}${us.filter(u=>u.status!==ST.PENDING).map(row).join("")}
  </div>`
  : `<div class="card empty"><div class="ct">${L("لا توجد طلبات بعد","No requests yet")}</div>
     <div class="cs">${L("يظهر هنا كل من يطلب الوصول من شاشة الدخول.","Anyone who requests access from the sign-in screen appears here.")}</div></div>`}

  `;
}

function bindAccess(){
  if(!isSuper() && !isDataAdmin()) return;
  document.querySelectorAll("[data-ap]").forEach(b=>b.onclick=()=>decide(b.dataset.ap, ST.APPROVED));
  document.querySelectorAll("[data-rj]").forEach(b=>b.onclick=()=>decide(b.dataset.rj, ST.REJECTED));
  document.querySelectorAll("[data-sp]").forEach(b=>b.onclick=()=>decide(b.dataset.sp, ST.SUSPENDED));
  document.querySelectorAll("[data-role]").forEach(sel=>sel.onchange=()=>setUserRole(sel.dataset.role, sel.value));
}

/* ---------- شاشة الدخول ---------- */
function showGate(){
  $("gate").hidden = false;
  $("app").hidden = true;
  $("gateBrand").textContent = CFG.brand;
  $("gateTag").textContent = CFG.tagline;
  $("gateLang").onclick = toggleLang;
  setLang(LANG);

  const panes = ["paneChoose","paneUser","paneReq","paneSuper"];
  const show = id => panes.forEach(x => $(x).hidden = (x!==id));
  const say = (el,msg,ok) => { const e=$(el); e.textContent=msg; e.className = ok?"gmsg ok":"gmsg err"; };
  show("paneChoose");

  $("goUser").onclick  = ()=>{ show("paneUser"); $("uEmail").focus(); };
  $("goReq").onclick   = ()=>{ show("paneReq"); $("rName").focus(); };
  $("goSuper").onclick = ()=>{ show("paneSuper"); $("gatePw").focus(); };
  document.querySelectorAll("[data-back]").forEach(b=>b.onclick=()=>show("paneChoose"));

  const doUser = async ()=>{
    const r = await signInUser($("uEmail").value);
    if(r.ok) startApp(); else say("uErr", r.msg, false);
  };
  $("uGo").onclick = doUser;
  $("uEmail").onkeydown = e => { if(e.key==="Enter") doUser(); };

  $("rGo").onclick = async ()=>{
    const r = await requestAccess($("rName").value, $("rEmail").value);
    say("rErr", r.msg, r.ok);
    if(r.ok){ $("rName").value=""; $("rEmail").value=""; }
  };

  const trySuper = async ()=>{
    if(!(window.crypto && crypto.subtle)){
      say("gateErr", L("هذا المتصفح لا يدعم التحقق المشفّر","This browser does not support secure verification"), false);
      return;
    }
    const h = await sha256($("gatePw").value);
    if(h === CFG.adminHash){ setRole("super", L("المسؤول الأعلى","Super Admin")); startApp(); }
    else { say("gateErr", tr("pwBad"), false); $("gatePw").select(); }
  };
  $("pwPeek").onclick = ()=>{
    const f = $("gatePw");
    f.type = f.type === "password" ? "text" : "password";
    $("pwPeek").classList.toggle("on", f.type === "text");
    f.focus();
  };
  $("gateGo").onclick = trySuper;
  $("gatePw").onkeydown = e => { if(e.key==="Enter") trySuper(); };
}
function startApp(){
  $("gate").hidden = true;
  $("app").hidden = false;
  $("roleTag").textContent = isSuper() ? L("مسؤول أعلى","Super Admin") : L("مستخدم معتمد","Approved user");
  $("roleTag").className = "roletag " + (isSuper()?"admin":"");
  $("roleTag").title = WHOAMI || "";
  init();
}

/* ================= شريط التنقل السفلي واللوح المنسدل ================= */
const TAB_MAIN  = ["home","ai","clinic","ask"];
const TAB_LABEL = () => ({home:tr("tHome"),ai:tr("tAi"),clinic:tr("tClinic"),ask:tr("tAsk"),more:tr("tMore")});
const ICONS = {
  home:'<path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z"/><path d="M9.5 21v-6h5v6"/>',
  exec:'<rect x="3" y="3" width="7.5" height="7.5" rx="1.6"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.6"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.6"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.6"/>',
  ai:'<path d="M12 3.2a5.6 5.6 0 0 0-3.3 10.1c.4.3.6.8.6 1.3v.9h5.4v-.9c0-.5.2-1 .6-1.3A5.6 5.6 0 0 0 12 3.2z"/><path d="M9.9 19h4.2"/><path d="M10.7 21.3h2.6"/>',
  clinic:'<path d="M4 20V9.5l8-5.5 8 5.5V20"/><path d="M4 20h16"/><path d="M12 11v5"/><path d="M9.5 13.5h5"/>',
  ask:'<path d="M20 15.5a2.5 2.5 0 0 1-2.5 2.5H8l-4 3V6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5z"/><path d="M9.8 9.4a2.2 2.2 0 1 1 2.9 2.1v1.1"/><circle cx="12.7" cy="14.9" r=".7" fill="currentColor" stroke="none"/>',
  bench:'<path d="M4 20h16"/><path d="M7.5 20v-5"/><path d="M12 20V7"/><path d="M16.5 20v-8"/>',
  insights:'<path d="M12 3a6 6 0 0 0-3.4 10.9c.4.3.6.8.6 1.3v.8h5.6v-.8c0-.5.2-1 .6-1.3A6 6 0 0 0 12 3z"/><path d="M9.8 19h4.4"/><path d="M10.6 21.5h2.8"/>',
  sim:'<path d="M4 7.5h9"/><path d="M17.5 7.5H20"/><path d="M4 16.5h3"/><path d="M11.5 16.5H20"/><circle cx="15.2" cy="7.5" r="2.2"/><circle cx="9.2" cy="16.5" r="2.2"/>',
  more:'<circle cx="5.2" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="18.8" cy="12" r="1.5"/>'
};
const svgIcon = k => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[k]}</svg>`;

function animateCounters(){
  if(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  document.querySelectorAll("[data-count]").forEach(el=>{
    const end = parseFloat(el.dataset.count);
    if(!isFinite(end)) return;
    const fmt = el.dataset.fmt==="pc" ? pc : n0;
    const dur = 650, t0 = performance.now();
    const step = now =>{
      const k = Math.min(1,(now-t0)/dur), e = 1-Math.pow(1-k,3);
      el.textContent = fmt(end*e);
      if(k<1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  });
}

function goPage(k){ state.page = k; render();
  window.scrollTo({top:0, behavior:"smooth"}); }

function renderTabs(){
  const row = $("tabrow"); if(!row) return;
  const btn = (k,on)=>`<button data-t="${k}" class="${on?"on":""}" ${on?'aria-current="page"':""}>
    ${svgIcon(k)}<span>${TAB_LABEL()[k]}</span></button>`;
  const main = TAB_MAIN.filter(pageAllowed);
  const pend = pendingCount();
  row.innerHTML = main.map(k=>btn(k, state.page===k)).join("")
    + btn("more", !main.includes(state.page)).replace("</button>",
        (pend ? `<span class="pdot">${pend}</span>` : "") + "</button>");
  row.querySelectorAll("button").forEach(b=>b.onclick=()=>{
    const k = b.dataset.t;
    if(k==="more") openSheet("pages"); else goPage(k);
  });
}

let sheetMode = null;
function openSheet(mode){
  sheetMode = mode;
  const sheet=$("sheet"), scrim=$("scrim"), body=$("sheetBody");
  $("sheetTitle").textContent = mode==="pages" ? tr("sections") : tr("filters");
  if(mode==="pages"){
    body.innerHTML = `<div class="pagelist">${navPages().map(([k,v])=>
      `<button data-p="${k}" class="${k===state.page?"on":""}"><span class="dot"></span>${esc(v)}</button>`
    ).join("")}</div>`;
    body.querySelectorAll("button").forEach(b=>b.onclick=()=>{ closeSheet(); goPage(b.dataset.p); });
  }else{
    body.innerHTML = "";
    body.appendChild($("mainFilters"));
  }
  scrim.hidden=false; sheet.hidden=false;
  requestAnimationFrame(()=>{ scrim.classList.add("show"); sheet.classList.add("show"); });
  document.body.style.overflow="hidden";
  $("btnFilters").classList.toggle("on", mode==="filters");
}
function closeSheet(){
  const sheet=$("sheet"), scrim=$("scrim");
  sheet.classList.remove("show"); scrim.classList.remove("show");
  document.body.style.overflow="";
  $("btnFilters").classList.remove("on");
  setTimeout(()=>{ sheet.hidden=true; scrim.hidden=true; restoreFilters(); sheetMode=null; }, 260);
}
function restoreFilters(){
  const f = $("mainFilters"), m = document.querySelector("main");
  if(f && m && f.parentElement !== m) m.insertBefore(f, $("page"));
}

/* ================= العرض ================= */
function render(){
  const recs = filtered(), docs = docsFiltered();
  const sm = summarize(recs, docs), bm = benchmark(sm), t = totals(sm);
  /* طبقة الذكاء تستبعد الفئات غير التخصصية دون حذفها من البيانات */
  const irecs = intel(recs);
  const ism = summarize(irecs, docs), ibm = benchmark(ism), it = totals(ism);

  if(!canSee(state.page)) state.page = "home";
  if(!pageAllowed(state.page)) state.page = navPages()[0][0];
  $("nav").innerHTML = navPages().map(([k,v])=>
    `<button data-p="${k}" class="${k===state.page?"on":""}">${v}${
      pendingCount() && k==="access" ? `<span class="pdot">${pendingCount()}</span>` : ""}</button>`).join("");
  $("nav").querySelectorAll("button").forEach(b=>b.onclick=()=>{state.page=b.dataset.p; render();});

  const allMonths = uniq(ALL.map(r=>r.month)).sort();
  $("fInfo").textContent = `${t.doctorsActive} ${L("أطباء لديهم نشاط ·","active doctors ·")} ${n0(t.days)} ${L("يوم عيادة ·","clinic days ·")} ${n0(t.hours)} ${L("ساعة ·","hours ·")} ${allMonths.join("، ")}`;

  let html;
  if(state.page==="access") html = pageAccess();
  else if(state.page==="admin") html = pageAdmin();
  else if(state.page==="registry") html = pageRegistry(recs);
  else if(!recs.length) html = `<div class="card">${L("لا توجد بيانات ضمن التصفية الحالية.","No data under the current filters.")}</div>`;
  else if(state.page==="home") html = pageHome(irecs,ism,ibm,it);
  else if(state.page==="ai") html = pageAI(irecs,ism,ibm,it);
  else if(state.page==="changed") html = pageChanged(irecs,ism,it);
  else if(state.page==="clinic") html = pageClinic(irecs,ism,it);
  else if(state.page==="forecast") html = pageForecast(irecs);
  else if(state.page==="ask") html = pageAsk(irecs,ism,it);
  else if(state.page==="exec") html = pageExec(recs,sm,bm,t);
  else if(state.page==="compare") html = pageCompare(recs,sm,bm);
  else if(state.page==="bench") html = pageBench(recs,sm);
  else if(state.page==="dept") html = pageDept(recs,sm);
  else if(state.page==="insights") html = pageInsights(recs,sm,bm,t);
  else if(state.page==="sim") html = pageSim(recs,sm,bm,t);
  else if(state.page==="time") html = pageTime(recs);
  else html = pageDQ(recs,sm);
  $("page").innerHTML = html;

  const bind = (id,fn)=>{ const el=$(id); if(el) el.onchange=fn; };
  bind("selA", e=>{state.a=e.target.value; render();});
  bind("selB", e=>{state.b=e.target.value; render();});
  bind("selMetric", e=>{state.metric=e.target.value; render();});
  bind("selSim", e=>{state.scenDoc=e.target.value; state.scenVal=null; render();});
  bind("selScen", e=>{state.scen=e.target.value; state.scenVal=null; render();});
  const sl=$("sl"); if(sl) sl.oninput = e=>{state.scenVal=parseFloat(e.target.value); render();};
  bind("selClinic", e=>{state.clinic=e.target.value; render();});
  if($("askGo")){
    const submit = ()=>{
      const q = $("askQ").value.trim(); if(!q) return;
      const r = askHealthIQ(q, irecs, ism, it);
      state.askLog = [{q, a:r.a, e:r.e, ev:r.ev, ip:r.ip, rc:r.rc}, ...state.askLog].slice(0,8);
      state.askDraft = ""; render();
    };
    $("askGo").onclick = submit;
    $("askQ").onkeydown = e=>{ if(e.key==="Enter") submit(); };
    $("askQ").oninput = e=>{ state.askDraft = e.target.value; };
    document.querySelectorAll(".chipbtn").forEach(b=>b.onclick=()=>{
      $("askQ").value = b.dataset.q; state.askDraft = b.dataset.q; $("askGo").click();
    });
  }
  document.querySelectorAll("[data-kpi]").forEach(b=>b.onclick=()=>{
    state.kpi = state.kpi===b.dataset.kpi ? null : b.dataset.kpi; render();});
  document.querySelectorAll("[data-go]").forEach(b=>b.onclick=()=>goPage(b.dataset.go));
  animateCounters();
  bindRegistry();
  bindAccess();
  bindAdmin();
  document.querySelectorAll("tr.click").forEach(tr=>tr.onclick=()=>{
    state.deptSel = (state.deptSel===tr.dataset.dept)? null : tr.dataset.dept; render();});

  $("foot").innerHTML = `<div class="sigbar">
    <div class="sig-logo"><svg viewBox="0 0 24 24" fill="none" stroke="#7FC0F2" stroke-width="2.4"
      stroke-linecap="round"><path d="M6 19v-5"/><path d="M12 19V8"/><path d="M18 19v-8"/></svg></div>
    <div class="sig-sep"></div>
    <div class="sig-main">
      <div class="sig-top">${esc(SIG_TOP)}</div>
      <div class="sig-by">${esc(SIG_BY)}</div>
      <div class="sig-name">${esc(SIG_NAME)}</div>
      <div class="sig-sub">${esc(SIG_SUB)}</div>
    </div>
    <div class="sig-sep e"></div>
    <div class="sig-end">
      <div class="sig-ar">لصحة أفضل</div>
      <div class="sig-en">FOR A HEALTHIER TOMORROW</div>
    </div>
  </div>`;

  renderTabs();
}

function buildFilters(){
  const depts = uniq(ROSTER.map(d=>d.deptAr)).sort();
  $("lbDept").textContent = L("القسم","Department");
  $("lbType").textContent = L("النوع","Type");
  $("lbFrom").textContent = L("من","From");
  $("lbTo").textContent   = L("إلى","To");
  $("fClear").textContent = L("مسح","Clear");
  $("fDept").innerHTML = [`<option value="${ALL_DEPT}">${esc(L("كل الأقسام","All departments"))}</option>`]
    .concat(depts.map(d=>`<option value="${esc(d)}">${esc(d)}</option>`)).join("");
  $("fType").innerHTML = [[ALL_TYPE, L("الكل","All")],
    [L("زائر","Visiting"), L("استشاري زائر","Visiting consultant")],
    [L("مقيم","Resident"), L("طبيب مقيم","Resident physician")]]
    .map(([v,t])=>`<option value="${esc(v)}">${esc(t)}</option>`).join("");
  if(!uniq(ROSTER.map(d=>d.deptAr)).concat([ALL_DEPT]).includes(state.dept)) state.dept = ALL_DEPT;
  $("fDept").value = state.dept; $("fType").value = state.type;
  $("fFrom").value = state.from; $("fTo").value = state.to;
}

function init(){
  relabelData();
  buildFilters();
  const ds = ALL.map(r=>r.date).sort();
  if(ds.length){ $("fFrom").min=$("fTo").min=ds[0]; $("fFrom").max=$("fTo").max=ds[ds.length-1]; }
  $("fDept").onchange = e=>{state.dept=e.target.value; render();};
  $("fType").onchange = e=>{state.type=e.target.value; render();};
  $("fFrom").onchange = e=>{state.from=e.target.value; render();};
  $("fTo").onchange = e=>{state.to=e.target.value; render();};
  $("fClear").onclick = ()=>{state.dept=ALL_DEPT; state.type=ALL_TYPE; state.from=""; state.to="";
    buildFilters(); render();};

  $("btnOut").onclick = signOut;
  $("langBtn").onclick = toggleLang;
  const fOn = state.dept!==ALL_DEPT || state.type!==ALL_TYPE || state.from || state.to;
  $("btnFilters").innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M7 12h10M10 17h4"/></svg>`
    + (fOn? `<span class="dot"></span>` : "");
  $("btnFilters").onclick = ()=> sheetMode==="filters" ? closeSheet() : openSheet("filters");
  $("sheetClose").onclick = closeSheet;
  $("scrim").onclick = closeSheet;
  document.addEventListener("keydown", e=>{ if(e.key==="Escape" && sheetMode) closeSheet(); });

  render();
}

applyCfg();
setLang(LANG);
if(ROLE) startApp(); else showGate();
loadUsers().then(()=>{ if(state && state.page==="access") render(); });
