/* ---------- الإعدادات ---------- */
const CFG_KEY = "healthiq.config.v1";
const DEFAULT_HASH = "68634a8fd6c189a3fc5965983021706cfb0bc52acf55182163cae5c68402d90a";
const CFG_DEFAULT = {
  brand:"HealthIQ",
  tagline:"AI-Powered Healthcare Analytics",
  titleAr:"منصة تحليل أوضاع العيادات الخارجية",
  accent:"#1668B3", navy:"#0B1F3D", azure:"#35A3E0",
  bgImage:"", heroImage:"", logo:"", bgOpacity:12, clinics:[],
  adminHash: DEFAULT_HASH,
  users: [],
  hidden: [],
  ai:{ utilLow:50, noShowHigh:35, fillLow:60, minDays:2, forecast:true, horizon:2 }
};
let CFG = loadCfg();

function loadCfg(){
  try{
    const raw = localStorage.getItem(CFG_KEY);
    if(!raw) return JSON.parse(JSON.stringify(CFG_DEFAULT));
    const o = JSON.parse(raw);
    const stale = ["منصة تحليل الحضور والطاقة العيادية","Clinic Access & Attendance Intelligence"];
    if(stale.includes(o.titleAr)) o.titleAr = CFG_DEFAULT.titleAr;
    return {...CFG_DEFAULT, ...o, ai:{...CFG_DEFAULT.ai, ...(o.ai||{})}};
  }catch(e){ return JSON.parse(JSON.stringify(CFG_DEFAULT)); }
}
function saveCfg(){
  try{ localStorage.setItem(CFG_KEY, JSON.stringify(CFG)); return true; }
  catch(e){ return false; }
}
function applyCfg(c){
  c = c || CFG;
  const r = document.documentElement.style;
  r.setProperty("--teal", c.accent);
  r.setProperty("--navy", c.navy);
  r.setProperty("--azure", c.azure);
  r.setProperty("--hero", `linear-gradient(115deg,${c.navy} 0%,${mix(c.navy,c.accent,.55)} 45%,${c.accent} 78%,${c.azure} 100%)`);
  C.teal = c.accent;
  const bg = $("bgLayer");
  if(bg){
    bg.style.backgroundImage = c.bgImage ? `url("${c.bgImage}")` : "none";
    bg.style.opacity = c.bgImage ? (c.bgOpacity/100) : 0;
  }
  const lg = $("brandLogo");
  if(lg){
    lg.innerHTML = c.logo
      ? `<img src="${esc(c.logo)}" alt="">`
      : `<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><path d="M5 19v-4.5"/><path d="M12 19V9"/><path d="M19 19v-7"/><circle cx="12" cy="4.6" r="1.7" fill="#fff" stroke="none"/></svg>`;
  }
  const ta=$("titleAr"); if(ta) ta.textContent = c.titleAr;
  const bt=$("brandName"), tg=$("brandTag");
  if(bt) bt.textContent = c.brand;
  if(tg) tg.textContent = c.tagline;
  document.title = c.brand + " — " + c.tagline;
}
function mix(a,b,w){
  const h=s=>[1,3,5].map(i=>parseInt(s.substr(i,2),16));
  const [r1,g1,b1]=h(a), [r2,g2,b2]=h(b);
  const m=(x,y)=>Math.round(x+(y-x)*w).toString(16).padStart(2,"0");
  return `#${m(r1,r2)}${m(g1,g2)}${m(b1,b2)}`;
}


